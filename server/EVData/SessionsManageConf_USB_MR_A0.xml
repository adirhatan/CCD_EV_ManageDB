		<table_div tdname="USB3.1 GEN1 Tx" tname="USB3.1_GEN1_GEN2_TX" SRreportId="">
			<table_div_line dname="Host GEN1" DivNumOfTests="17" trials="1">
				<table_div_field fname="SpecTestName" condition="contains">GEN1</table_div_field>
			</table_div_line>
		</table_div>
		<table_div tdname="USB3.1 GEN2 Tx" tname="USB3.1_GEN1_GEN2_TX"   SRreportId="">
			<table_div_line dname="Host GEN2" DivNumOfTests="33" trials="1">	
				<setup_numOfTests setup="L" tests="33"/>
				<setup_numOfTests setup="S" tests="31"/>
				<table_div_field fname="SpecTestName" condition="contains">GEN2</table_div_field>
			</table_div_line>
		</table_div>
