				<type>S</type>
				<setup>S</setup>
				<num>1</num>
			</unit>
			<unit>
				<skew>FF</skew>
				<type>L</type>
				<setup>L</setup>
				<num>1</num>
			</unit>
			<unit>
				<skew>TYP</skew>
				<type>S</type>
				<setup>S</setup>
				<num>1</num>
			</unit>
			<unit>
				<skew>TYP</skew>
				<type>L</type>
