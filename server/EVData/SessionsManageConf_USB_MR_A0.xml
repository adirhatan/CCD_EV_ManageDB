			<!-- value: the result string (or substring) in DB, may contain multiple values comma delimited (spaces are valid caharacter)-->
		<table_div tdname="USB2.0 HS Tx" tname="USB2.0_TX" SRreportId="">
			<table_div_line dname="Host HSTx" DivNumOfTests="17" trials="1">
				<table_div_field fname="SpecTestName" condition="contains">EL_</table_div_field>
