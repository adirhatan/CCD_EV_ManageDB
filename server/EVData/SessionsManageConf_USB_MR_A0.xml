			</table_div_line>
			<table_div_line dname="Host HSTx trials" DivNumOfTests="1" trials="3">
				<table_div_field fname="SpecTestName" condition="equals">EL_3 High Speed Data Eye</table_div_field>
				<table_div_field fname="UserComment" condition="notContains">Apple</table_div_field>
			</table_div_line>
		</table_div>
