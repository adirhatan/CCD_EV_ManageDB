	<!-- ProtocolConf determines SessionManage and CycleReport configuration per portocol; protocols are defined by Sys Admin (Naty). Each protocol has separate Session Manage page -->
	<ProtocolConf>
		<protocol>CIO_RL</protocol>
		<proj>MR</proj>
		<phase>B0</phase>
		<!-- table determines which tables will appear in Sessions Manage page; it is valid to define multiple tables (repeat the line for each table)-->
		<table>CIO-RL</table>
		<!-- field determines customized fields that will appear in Session Manage page, "alias" will be presented, value must be the real field name in DB -->
		<!--  it is valid to define multiple fields (repeat the line for each field)-->
		<field>Skew</field>
		<field alias="FW">FW version</field>
		<!--CycleRrport definitions start-->
		<!-- ports: possible ports values of the results, comma delimited ,case insensitive -->
		<ports>PA,PB</ports>
		<!-- Lanes: possible lanes values of the results, comma delimited ,case insensitive -->
		<lanes>L0,L1,L2,L3</lanes>
		<!-- excelPorts: ports values exists in excel template, "NONE" or values, comma delimited -->
		<excelPorts>PA,PB</excelPorts>
		<!-- SRTemplate: template used for status report, should match ports+lanes combination see emptySR*.xlsx files in EVData -->
		<SRTemplate>PABL03</SRTemplate>
		<!-- table_div determains group of lines in excel that refers to specific table in DB-->
			<!-- tdname:name in excel (column A)-->
			<!-- tname:table name in DB-->
		<!-- table_div_line determains one line content-->
			<!-- dname: name in excel (column B)-->
			<!-- DivNumOfTests: number of different tests that will match this line-->
			<!-- trials: number of trials per test-->
		<!-- table_div_field determines how to query DB results to match the line; it is valid to define multiple table_div_field for same field or defferent fields(repeat the line for each table_div_field)-->
			<!-- fname: field name in DB (case sensitive)-->
			<!-- condition: defines the query logic, valid options areequals,contains,notContains -->
			<!-- value: the result string (or substring) in DB, may contain multiple values comma delimited (spaces are valid caharacter)-->
		<table_div tdname="CIO RL Gen2" tname="CIO-RL" SRreportId="">
			<table_div_line dname="CIO_RL_GEN2" DivNumOfTests="4" trials="1">
				<table_div_field fname="SpecTestName" condition="contains">_10G_</table_div_field>
			</table_div_line>
		</table_div>
		<table_div tdname="CIO RL Gen3" tname="CIO-RL" SRreportId="">
			<table_div_line dname="CIO_RL_GEN3" DivNumOfTests="4" trials="1">
				<table_div_field fname="SpecTestName" condition="contains">_20G_</table_div_field>
			</table_div_line>
		</table_div>
		<!--Units: Should match the units in the excel template, Drop down values of "Logic Unit" in Session Manage page are created from this list-->
			<!-- skew:skew (FF/TYP/SS)-->
			<!-- type:Board configuration (first letter upper case)-->
			<!-- setup:Setup (first letter upper case)-->
			<!-- num:1 or more if we have it in excel template (1,2 etc)-->
		<units>
			<unit>
				<skew>FF</skew>
				<type>S</type>
				<setup>S</setup>
				<num>1</num>
			</unit>
			<unit>
				<skew>FF</skew>
				<type>L</type>
				<setup>L</setup>
				<num>1</num>
			</unit>
			<unit>
				<skew>TYP</skew>
				<type>S</type>
				<setup>S</setup>
				<num>1</num>
			</unit>
			<unit>
				<skew>TYP</skew>
				<type>L</type>
				<setup>L</setup>
				<num>1</num>
			</unit>
			<unit>
				<skew>SS</skew>
				<type>S</type>
				<setup>S</setup>
				<num>1</num>
			</unit>
			<unit>
				<skew>SS</skew>
				<type>L</type>
				<setup>L</setup>
				<num>1</num>
			</unit>
		</units>
	</ProtocolConf>	
	

