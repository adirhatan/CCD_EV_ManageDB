@model MongoDB.Driver.MongoCursor
@using MongoDB.Bson;
@using MongoDB.Driver;
@using MongoDB.Bson.Serialization;
@using System.Collections.Generic;
@using System.Web.UI.WebControls;
@using CCD_EV_ManageDB.Models;

@{
    ViewBag.Title = "Spec Tables";
}
<script type="text/JavaScript">
    function changedUserReports(selectUser, selectReport) {
        //debugger;
        //var selectFields = elem.nextSibling.nextSibling;

        var output = [];
        var length = ngon.DictionaryAllUsersTableReports[selectUser.value].length;
        for (var i = 0; i < length; i++) {
            output[i] = '<option value="' + ngon.DictionaryAllUsersTableReports[selectUser.value][i] + '">' + ngon.DictionaryAllUsersTableReports[selectUser.value][i] + '</option>';
        }

        selectReport.innerHTML = output.join('');

    }
    
</script>
<h2>Spec Tables</h2>

 <script src="@Url.Content("~/Scripts/ccdEV.js")" type="text/javascript" ></script>
 <script type="text/JavaScript">
     $(document).ready(function () {
         //debugger;
         $('#rTables').dataTable({
             "iDisplayLength": -1,
             "columns": [
            { "orderable": true },
            { "orderable": false },
            { "orderable": false },
            { "orderable": false }
          ],
             "autoWidth": true,
             "jQueryUI": true,
             //        //"sDom": '<"H"CTrf>t<"F"lip>',
             "dom": '<"H"CTrif>t<"F"CTrif>',
             //"dom": 't<"F"CTrif>',
             "scrollX": "100%",
             //"sScrollY": "700px",
             "scrollY": (0.8 * $(window).height()),
             "scrollCollapse": true
         });
     });

</script>
<p class="messageText">@TempData["message"]</p>
<p class="messageInfoText">@TempData["messageInfo"]</p> 
<!-- //public ActionResult CreateRefTable(string _Protocol, string _PVersion, string tName)-->
 @using (Html.BeginForm("CreateRefTable", "GeneralDB", FormMethod.Post, new { enctype = "multipart/form-data",@id = "RefForm", @name = "RefForm" }))
 {
 <p>Create empty spec table: &nbsp; 
    Protocol name:
    <input type="text" id="_Protocol" name="_Protocol" style="width: 120px" />
    Protocol Version:
    <input type="text" id="_PVersion" name="_PVersion" style="width: 120px" />
    Optional - Excel spec file: 
    <input type="file" name="file" class="button" />
    &nbsp;
    <input type="submit" value="Submit" />
</p>
 }

  @using (Html.BeginForm("CreateRefTableFromReport", "GeneralDB", FormMethod.Post, new { @id = "RefReportForm", @name = "RefReportForm" }))
 {
 <p>Create spec table from report: &nbsp; 
    Protocol name:
    <input type="text" id="_RProtocol" name="_Protocol" style="width: 120px" />
    Protocol Version:
    <input type="text" id="_RPVersion" name="_PVersion" style="width: 120px" />
    User (Table):
    <select id="UserTable" name="UserTable" class="wselect" onchange="changedUserReports(this,document.getElementById('ReportName'))">
        <option value=""></option>
        @foreach (var col in ViewBag.UsersTablesReports)
        {
            <option value="@col.ToString()"> @col.ToString()</option>
        }
    </select>
    Report Name:
    <select id="ReportName" name="ReportName" class="wselect">
            <option value=""></option>
    </select> 
    <!--Report ID: 
    <input type="text" id="ReportId" name="ReportId" style="width: 120px" />-->
    <input type="submit" value="Submit" />
</p>
 }

  <table id="rTables" class="display">
    <thead>
    <tr>
        <th >
            Name
        </th>
        <th >
            Edit
        </th>
        <th >
            Copy
        </th>
        <th >
            Delete
        </th>
    </tr> 

    </thead>
    <tbody>
    @foreach (BsonDocument item in Model)
    {
        ADMReferenceTable Ref = item.BsonDocumentToADMReferenceTable();
        string r_id = Ref._id;
        string SaveName = "SaveName" + r_id;
        string DrefForm = "DrefForm" + r_id;
     <tr>
        <td id="@r_id">
        @r_id
        </td>

        <td>
        <!-- //public ActionResult EditRefTable(string _id, bool fromCopy) -->
        @using (Html.BeginForm("EditRefTable", "GeneralDB", FormMethod.Post, new { @id = "eForm", @name = "eForm" }))
        {
            <input type="submit" value="E" title="Edit Report" class="button" />
             <input type="hidden" id="e_id" name="_id" value="@r_id" />
             <input type="hidden" id="fromCopy" name="fromCopy" value="false" />
        }
        </td>
        <!-- // public ActionResult CopyRef(string _id,string _Protocol, string _PVersion) -->
        <td>
             @using (Html.BeginForm("CopyRef", "GeneralDB", FormMethod.Post, new { @id = "CRefForm", @name = "CRefForm" }))
             {
                <input type="submit" value="C" title="Copy Ref" class="button" />
                <text> Protocol name: </text>
                <input type="text" id="_CProtocol" name="_Protocol" style="width: 120px" />
                 <text>Protocol Version:</text>
                <input type="text" id="_CPVersion" name="_PVersion" style="width: 120px" />
                <input type="hidden" id="c_id" name="_id" value="@r_id" />
             }
        </td>
        <td>
            @using (Html.BeginForm("DeleteRef", "GeneralDB", FormMethod.Post, new { @id = DrefForm, @name = DrefForm }))
            {
                <input type="hidden" id="d_id" name="_id" value="@r_id" />
                <input type="button" value="D" title="Delete Report" class="button" onclick="FormConfirmAction('@DrefForm','@Url.Action("DeleteRef", "GeneralDB")','Are you sure you want to delete  @r_id ?')" />
            }
        </td>
    </tr>
    }
    </tbody>
</table>

