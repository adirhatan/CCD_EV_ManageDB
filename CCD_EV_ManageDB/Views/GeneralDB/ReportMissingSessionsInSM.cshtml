@model SessionsManageDisplay
@using MongoDB.Bson;
@using MongoDB.Driver;
@using MongoDB.Bson.Serialization;
@using System.Collections.Generic;
@using System.Web.UI.WebControls;
@using CCD_EV_ManageDB.Models;

@{
    ViewBag.Title = "Report Missing Sessions in SM";
}

<h2>Missing Sessions List</h2>
<script src="@Url.Content("~/Scripts/ccdEV.js")" type="text/javascript" ></script>     

<p class="messageText">@TempData["message"]</p>
<p class="messageInfoText">@TempData["messageInfo"]</p> 

      @using (Html.BeginForm("IndicatorsList", "GeneralDB", FormMethod.Post, new { @id = "allForm", @name = "allForm" }))
      {
     <p>
        Project: <b>@ViewBag.proj</b>  &nbsp;&nbsp; Phase: <b>@ViewBag.phase</b> &nbsp;&nbsp; Protocol: <b>@ViewBag.protocol</b>       
        &nbsp;&nbsp;&nbsp;
        <input type="button" value="Back to Sessions" title="Back to Sessions List" class="button" onclick="GenLocatioAction('@Url.Action("SessionsManageList", "GeneralDB", new { @protocol = ViewBag.protocol, @phase = ViewBag.phase, @proj = ViewBag.proj })')" />
    </p>

      }

@{
    string customCols = "null";
    int i = 1;
    while (i < Model.Conf.fields.Count)
    {
        i++;
        customCols += ",null";
    }
       <script type="text/JavaScript">

     $(document).ready(function () {
         $('table.display').dataTable({
             //        "deferRender": true,
             "ordering": true,
             "columnDefs": [
                { "orderable": false, "targets": 2 },
                { "orderable": false, "targets": 3 },
                { "orderable": false, "targets": 7 }
                ],
              "columns": [
                                null,
                                null,
                                null,
                                null,
                                null,
                                null,
                                null,
                                null,
                                {
                                    "render": function(data, type, row){
                                        return data.split("ppp").join("<br/>");
                                    }
                                },
                                null,
                                @(customCols)
                                //null,
                                //null
                            ],
             "iDisplayLength": -1,
             "bPaginate": true,
             "iCookieDuration": 60,
             "bStateSave": false,
             "bAutoWidth": true,
             "bScrollAutoCss": true,
             "bProcessing": true,
             "bRetrieve": true,
             "bSort": false,
             "bJQueryUI": true,
             "dom": '<"H"CTrif><"toolbar">t',
             //"sDom": '<"H"CTrf>t<"F"lip>',
             //"sDom": '<"H"CTrif>t<"F"CTrif>',
             //"aLengthMenu": [[10, 20, 100, -1], [10, 20, 100, "All"]],
             "sScrollX": "100%",
             //"sScrollY": "700px",
             //"sScrollY": "100%",
             "sScrollY": (0.8 * $(window).height()),
             "bScrollCollapse": true,
             "fnInitComplete": function () {
                 this.css("visibility", "visible");
             }
         });
         //$("div.toolbar").html('<b>SMOT.table</b>');
     });

</script>
}
    @{foreach (SessionsManageOfTable SMOT in Model.SessionsManageOfTables)
      {
          string formName = "form" + SMOT.table;
          string _checkAllName = "_checkAll" + SMOT.table;
          List<SessionsManage> SMOT_Filtered_Sessions = new List<SessionsManage>();
     <p><br /><b>@SMOT.table</b> (Sessions exist in DB but not in SM) 
     </p>
     <table id="" class="display">
    <thead>
    <tr>
        <th >
            Validation
        </th>
        <th >
            LogicUnit
        </th>
        <th >
            Add
        </th>
        <th >
            Query
        </th>
        <th >
            board
        </th>
        <th >
            Type
        </th>
        <td>
            NVM
        </td>
        <th >
            Comment
        </th>
        <th >
            Sessions
        </th>
        <th >
            Results
        </th>
        @foreach (var fieldAlias in Model.Conf.fieldsAliases)
        {
            <th >
                @fieldAlias
            </th>  
        }
    </tr> 

    </thead>
    <tbody>

    
    @foreach (SessionsManage SM in SMOT.MissingSessions)
    {
        string c_id = "_cb" + SM._id;
     <!--tr @{string s = "style=background-color:Orange"; if (string.IsNullOrEmpty(SM.logicUnit))
              { @s;
              }}-->
     <tr @{string st = "style=background-color:Orange"; if (SM.validation == General.SessionValidationStatus.Pending_review)
           { @st;
           }}>
        <td @{string std = "style=background-color:Orange"; if (SM.validation == General.SessionValidationStatus.Pending_review)
              { @std;
              }}>
           @SM.validation.ToString()
        </td> 
        <td>
            @SM.logicUnit
        </td> 
        @{
              string _query = "EQ;ProjectName;" + ViewBag.proj + ";EQ;Phase;" + ViewBag.phase + ";In;SessionStart;" + SM.Sessions[0];
              if (string.IsNullOrEmpty(SM.comment))
              {
            <td>
                <input type="button" value="C" title="Create SM record for this session" class="button" onclick="GenLocatioAction('@Url.Action("SessionsManageCreateSession", "GeneralDB", new { @SessionStart = SM.Sessions[0], @protocol = ViewBag.protocol, @phase = ViewBag.phase, @proj = ViewBag.proj, @table = SM.table, @infodoc = SMOT.MissingSessionsInSMDictionary[SM.Sessions[0]].ToString() })')" />
             
            </td>
              }
              else
              {
                  
            <td>
                <input type="button" value="A" title="Add session to exist record" class="button" onclick="GenLocatioAction('@Url.Action("SessionsManageAddSession", "GeneralDB", new { @_id = SM.comment, @protocol = ViewBag.protocol, @phase = ViewBag.phase, @proj = ViewBag.proj, @SessionStart = SM.Sessions[0], @infodoc = SMOT.MissingSessionsInSMDictionary[SM.Sessions[0]].ToString() })')" />
             
            </td>
                }
            <td>
                <input type="button" value="Q" title="Query record" class="button"  onclick="GenLocatioAction('@Url.Action("SearchTMP", "ManageDB", new { @db = ViewBag.DB_TMP, @col = SM.table, @Query = _query })')" />
            </td>
        }
        <td>
        @(SM.board_id + "_" + SM.unit_id)
        </td> 
        @{
              string tmpType = SM.Data.GetValue("sType", "").ToString();
        <td>
            @tmpType
        </td>
        }
        <td>
            @SM.NVM
        </td>
        <td>
        @{
              string c_resultsNum = "";
              string c_status = "Pass";
              string c_style = "style=color:Green";

              foreach (string session in SM.Sessions)
              {

                  c_resultsNum = SMOT.MissingSessionsInSMDictionary[session].GetValue("TMP results", "").ToString();
                  c_status = SMOT.MissingSessionsInSMDictionary[session].GetValue("TMP results status", "").ToString();
                  if (!string.IsNullOrEmpty(c_resultsNum))
                  {
                      if (c_status == "Fail")
                      {
                          c_style = "style=color:Red";
                      }
                      else
                      {
                          c_style = "style=color:Green";
                      }
                    <span title="@SMOT.MissingSessionsInSMDictionary[@session].GetValue("UserComment", "")" @c_style>TMP (@c_resultsNum),</span>
                  }

                  c_resultsNum = SMOT.MissingSessionsInSMDictionary[session].GetValue("PRM results inc", "").ToString();
                  c_status = SMOT.MissingSessionsInSMDictionary[session].GetValue("PRM results inc status", "").ToString();
                  if (!string.IsNullOrEmpty(c_resultsNum))
                  {
                      if (c_status == "Fail")
                      {
                          c_style = "style=color:Red";
                      }
                      else
                      {
                          c_style = "style=color:Green";
                      }
                    <span title="@SMOT.MissingSessionsInSMDictionary[@session].GetValue("UserComment", "")" @c_style> PRM Valid (@c_resultsNum),</span>
                  }

                  c_resultsNum = SMOT.MissingSessionsInSMDictionary[session].GetValue("PRM results exc", "").ToString();
                  c_status = SMOT.MissingSessionsInSMDictionary[session].GetValue("PRM results exc status", "").ToString();

                  if (!string.IsNullOrEmpty(c_resultsNum))
                  {
                      if (c_status == "Fail")
                      {
                          c_style = "style=color:Red";
                      }
                      else
                      {
                          c_style = "style=color:Green";
                      }
                    <span title="@SMOT.MissingSessionsInSMDictionary[@session].GetValue("UserComment", "")" @c_style> PRM NOT Valid (@c_resultsNum),</span>
                  }

              }
        }
        </td> 
        <td>
            @{
              string eol = "ppp";
              int cnt = 0;
              string resultsNum = "";
              string status = "Pass";
              string style = "style=color:Green";
              int ResultsSum = 0;

              foreach (string session in SM.Sessions)
              {
                  if ((SM.validation == General.SessionValidationStatus.TMP_valid) || (SM.validation == General.SessionValidationStatus.TMP_not_valid) || (SM.validation == General.SessionValidationStatus.Pending_review))
                  {
                      resultsNum = SMOT.MissingSessionsInSMDictionary[session].GetValue("TMP results", "").ToString();
                      status = SMOT.MissingSessionsInSMDictionary[session].GetValue("TMP results status", "").ToString();
                  }
                  if (SM.validation == General.SessionValidationStatus.PRM_valid)
                  {
                      resultsNum = SMOT.MissingSessionsInSMDictionary[session].GetValue("PRM results inc", "").ToString();
                      status = SMOT.MissingSessionsInSMDictionary[session].GetValue("PRM results inc status", "").ToString();
                  }
                  if (SM.validation == General.SessionValidationStatus.PRM_not_valid)
                  {
                      resultsNum = SMOT.MissingSessionsInSMDictionary[session].GetValue("PRM results exc", "").ToString();
                      status = SMOT.MissingSessionsInSMDictionary[session].GetValue("PRM results exc status", "").ToString();
                  }
                  if (status == "Fail")
                  {
                      style = "style=color:Red";
                  }
                  else
                  {
                      style = "style=color:Green";
                  }
                  ResultsSum += Convert.ToInt32(resultsNum);
                  cnt++;
                  if (cnt % 5 == 0)
                  {
                        <span title="@SMOT.MissingSessionsInSMDictionary[@session].GetValue("UserComment", "")" @style>@session (@resultsNum),</span> @eol
                  }
                  else
                  {
                        <span title="@SMOT.MissingSessionsInSMDictionary[@session].GetValue("UserComment", "")" @style>@session (@resultsNum),</span>
                  }

              }
                 
            }
        </td>
        <td>
         <span title="results number"> @ResultsSum</span>
        </td>
        @foreach (var field in Model.Conf.fields)
        {
            string data = SM.Data.GetValue(field, "").ToString();
            <td>
                @data
            </td>
        }

    </tr>
    }
    </tbody>
</table>
      }
      }

