@using (Html.BeginForm("DeleteSpecLimitsConflictRecs", "GeneralDB", FormMethod.Post, new { @id = "tForm", @name = "tForm" }))
{

  
<div>     
   @if ((User.IsInRole("CCD_EV")))
   {
    <input type="hidden" value="@Model.Query" name="query" />
    <input type="hidden" value="@Model.col" name="col" />
    <input type="button" value="Delete query results" class="button" onclick="FormConfirmAction('tForm','@Url.Action("DeleteSpecLimitsConflictRecs", "GeneralDB")','Are you sure you want to delete all query results?\nQuery contains @ViewBag.numberOfResults results.')"/>
   }

      <p>Spec Limits Conflicts, Table:"@Model.col" Query: "@Model.Query" Results num: <b>@ViewBag.numberOfResults </b> 
     @{
   int DataTableLimit = Convert.ToInt32(System.Configuration.ConfigurationManager.AppSettings["DataTableLimit"]);
   int resNum = Convert.ToInt32(ViewBag.numberOfResults);
   string text = "showing first ";
   if (resNum > DataTableLimit)
   {           
                @text <select id="_Skip" name="_Skip" onchange="changeSkip()">
			    @{
       for (int i = 0; i * DataTableLimit < resNum; i++)
       {
           int last = (i + 1) * DataTableLimit;
           if (last > resNum) { last = resNum; }
           if (Model.Skip == (i * DataTableLimit))
           {
						    <option value="@(i * DataTableLimit)" selected="selected"> @((i * DataTableLimit) + 1) - @last</option>   
           }
           else
           {
						    <option value="@(i * DataTableLimit)"> @((i * DataTableLimit) + 1) - @last</option>
           }
       }
			    }
			    </select> 
   }

   }
   </p>
</div>
    <p> 
    <select id="_SortStr" name="_SortStr">
        @{
   foreach (var field in Model.TableFields)
   {
       if (field.ToString() == Model.SortStr)
       {
                <option value="@field.ToString()" selected="selected"> @field.ToString()</option>   
       }
       else
       {
                <option value="@field.ToString()"> @field.ToString()</option>
       }
   }
        }
    </select>
    <select id="_SortDirection" name="_SortDirection">
        @{
   if (Model.SortDirection == "ASC")
   {
            <option value="ASC" selected="selected">ASC</option>
            <option value="DES">DES</option>   
   }
   else
   {
            <option value="ASC" selected="selected">ASC</option>
            <option value="DES" selected="selected">DES</option>  
   }
        }
    </select>
    &nbsp;
    <input type="button" value="Sort" title="Sort" class="button" onclick="QuickSort('_SortStr','_SortDirection','@Model.Query')" />
    
    </p>
<p class="messageText">@TempData["message"]</p>
<p class="messageInfoText">@TempData["messageInfo"]</p> 
<table id="SpecConflictstable" class="display">
    <thead>
    <tr>
        <th >
            Select
        </th>
     @foreach (var field in Model.TableFields)
     {
        <th id="@field.ToString()">
        @{  
         if ((field.ToString() == Model.SortStr))
         {
             if ((Model.SortDirection == "DES"))
             {
                <span title="Sort up" onclick="sortField('@field.ToString()','ASC','@Model.Query')">@field.ToString() &nbsp;</span> 
                <img src=@Url.Content("~/content/Images/sort_up.gif") title="Sort up" onclick="sortField('@field.ToString()','ASC','@Model.Query')"/>
             }
             if ((Model.SortDirection == "ASC"))
             {
                <span title="Sort down" onclick="sortField('@field.ToString()','DES','@Model.Query')">@field.ToString() &nbsp;</span> 
                <img src=@Url.Content("~/content/Images/sort_down.gif") title="Sort down" onclick="sortField('@field.ToString()','DES','@Model.Query')"/>
             }

         }
         else
         {
                <span title="Sort down" onclick="sortField('@field.ToString()','DES','@Model.Query')">@field.ToString() &nbsp;</span>
            <img src=@Url.Content("~/content/Images/sort_up_down.gif") title="Sort down" onclick="sortField('@field.ToString()','DES','@Model.Query')"/>
         }

         }                                                                                
        </th>
     }
    </tr> 

    </thead>
    <tbody>
    @foreach (BsonDocument item in Model.ResCursor)
    {
        string r_id = item.AsBsonDocument.GetElement("_id").ToString();
        string _r_id = item.AsBsonDocument.GetElement("_id").Value.ToString().Replace(" ", "_");
        string _r_id_tr = _r_id + "_line";
     <tr id="@_r_id_tr">  
        <td>
                 
                 
            <!--<input id="@r_id" name="@r_id" type="checkbox" /> no checkbox for this page-->
            <input id="@_r_id" name="@_r_id" class="button" value="m" type="button" onclick="markLine('@_r_id_tr')"/>
            
        </td>
        @foreach (var field in Model.TableFields)
        {
        <td >
            @{ 
            if ((field.ToString().Length > 3) && (field.ToString().Substring(0, 4).ToUpper() == "FILE") && (@item.GetValue(field.ToString(), "") != ""))
            {
                string fname = item.GetValue(field.ToString()).ToString();
                    <a href="file:////@item.GetValue(field.ToString(), "")" class="fileLinkRes">@System.Text.RegularExpressions.Regex.Replace(fname, ".*\\\\", "")</a>
            }
            else
            {
                @item.GetValue(field.ToString(), "");
            }
            }
        </td>
        }
    </tr>
    }
    </tbody>
</table>
}



