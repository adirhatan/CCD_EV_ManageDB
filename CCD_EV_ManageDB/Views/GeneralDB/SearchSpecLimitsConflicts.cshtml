     });


     $(document).ready(function () {
         $('#SpecConflictstable').dataTable({
             //        "deferRender": true
             "iDisplayLength": -1,
             "bPaginate": true,
             "iCookieDuration": 60,
             "bStateSave": false,
             "bAutoWidth": true,
             "bScrollAutoCss": true,
             "bProcessing": true,
             "bRetrieve": true,
             "bSort": false,
             "bJQueryUI": true,
             //"sDom": '<"H"CTrf>t<"F"lip>',
             "sDom": '<"H"CTrif>t<"F"CTrif>',
             //"aLengthMenu": [[10, 20, 100, -1], [10, 20, 100, "All"]],
             "sScrollX": "100%",
             //"sScrollY": "700px",
             "sScrollY": (0.8 * $(window).height()),
             "bScrollCollapse": true,
             "fnInitComplete": function () {
                 this.css("visibility", "visible");
             },
             "rowCallback": function (row, data, index) {
                 if (data[6] == "Conflict") {
                     $(row).find('td:eq(6)').css('color', 'red');
                 }
                 else {
                     $(row).find('td:eq(6)').css('color', 'orange');
                 }
             }
         });
     });
</script>
