@model List<Indicator>
@using MongoDB.Bson;
@using MongoDB.Driver;
@using MongoDB.Bson.Serialization;
@using System.Collections.Generic;
@using System.Web.UI.WebControls;
@using CCD_EV_ManageDB.Models;

@{
    ViewBag.Title = "Indicators List";
}

<h2>Indicators List</h2>
<script src="@Url.Content("~/Scripts/ccdEV.js")" type="text/javascript" ></script>
 <script type="text/JavaScript">
     $(document).ready(function () {
         //debugger;
         $('#indTables').dataTable({
             "iDisplayLength": -1,
             "columns": [
            { "orderable": false },
            { "orderable": false },
            { "orderable": false },
            { "orderable": false },
            { "orderable": true },
            { "orderable": true },
            { "orderable": true }
          ],
             "autoWidth": true,
             "jQueryUI": true,
             //        //"sDom": '<"H"CTrf>t<"F"lip>',
             "dom": '<"F"CTrif>t<"F"CTrif>',
             "scrollX": "100%",
             //"sScrollY": "700px",
             "scrollY": (0.8 * $(window).height()),
             "scrollCollapse": true
         });
     });

</script>
<p class="messageText">@TempData["message"]</p>
<p class="messageInfoText">@TempData["messageInfo"]</p> 

   @using (Html.BeginForm("IndicatorInit", "GeneralDB", FormMethod.Post, new { @id = "myForm", @name = "myForm" }))
   {
     <p>
        Create new Indicator: Select table: 
        <select id="col" name="col" class="wselect">
            @foreach (var col in ViewBag.collist)
            {
                <option value="@col.ToString()"> @col.ToString()</option>
            }
        </select>  
        Select Project: 
        <select id="proj" name="proj" >
            @foreach (var proj in ViewBag.projlist)
            {
                if (proj.ToString() == ViewBag.proj)
                {
                    <option value="@proj.ToString()" selected="selected"> @proj.ToString()</option>
                }
                else
                {
                    <option value="@proj.ToString()"> @proj.ToString()</option>
                }
            }
        </select> 
        Select Phase: 
        <select id="phase" name="phase" >
            @foreach (var phase in ViewBag.phaselist)
            {
                if (phase.ToString() == ViewBag.phase)
                {
                    <option value="@phase.ToString()" selected="selected"> @phase.ToString()</option>
                }
                else
                {
                    <option value="@phase.ToString()" > @phase.ToString()</option>
                }
            }
        </select> 


          <input type="submit" value="Create" class="button" />
    </p>
   }

    @using (Html.BeginForm("IndicatorsCopyAllProjPhase", "GeneralDB", FormMethod.Post, new { @id = "copyAllForm", @name = "copyAllForm" }))
   {
     <p>
        Copy All Indicators: &nbsp; Select Source Project: 
        <select id="s_proj" name="s_proj" >
            @foreach (var proj in ViewBag.projlist)
            {
                if (proj.ToString() == ViewBag.proj)
                {
                    <option value="@proj.ToString()" selected="selected"> @proj.ToString()</option>
                }
                else
                {
                    <option value="@proj.ToString()"> @proj.ToString()</option>
                }
            }
        </select> 
        Select Source Phase: 
        <select id="s_phase" name="s_phase" >
            @foreach (var phase in ViewBag.phaselist)
            {
                if (phase.ToString() == ViewBag.phase)
                {
                    <option value="@phase.ToString()" selected="selected"> @phase.ToString()</option>
                }
                else
                {
                    <option value="@phase.ToString()" > @phase.ToString()</option>
                }
            }
        </select> 
        Select Target Project: 
        <select id="t_proj" name="t_proj" >
            @foreach (var proj in ViewBag.projlist)
            {
                if (proj.ToString() == ViewBag.proj)
                {
                    <option value="@proj.ToString()" selected="selected"> @proj.ToString()</option>
                }
                else
                {
                    <option value="@proj.ToString()"> @proj.ToString()</option>
                }
            }
        </select> 
        Select Target Phase: 
        <select id="t_phase" name="t_phase" >
            @foreach (var phase in ViewBag.phaselist)
            {
                if (phase.ToString() == ViewBag.phase)
                {
                    <option value="@phase.ToString()" selected="selected"> @phase.ToString()</option>
                }
                else
                {
                    <option value="@phase.ToString()" > @phase.ToString()</option>
                }
            }
        </select> 
 
        WW start
        <select id="c_wws" name="wws" >
            @foreach (KeyValuePair<string,string> ww in ViewBag.workweeks)
            {
                <option value="@ww.Value"> @ww.Key</option>
            }
        </select> 
        Weeks #
        <select id="c_wn" name="wn" >
                
            @foreach (string wn in ViewBag.weekNumbers)
            {
                <option value="@wn"> @wn</option>
            }
        </select> 
        <input type="submit" class="button" />
    </p>
   }

      @using (Html.BeginForm("IndicatorsLaunchAll", "GeneralDB", FormMethod.Post, new { @id = "allForm", @name = "allForm" }))
      {
     <p>
        <input type="hidden" name="_interface" value="ALL" />
        Select Project: 
        <select id="all_proj" name="proj" onchange="GenSubmitFormAction('allForm','@Url.Action("IndicatorsList", "GeneralDB")')">
            @foreach (var proj in ViewBag.projlist)
            {
                if (proj.ToString() == ViewBag.proj)
                {
                    <option value="@proj.ToString()" selected="selected"> @proj.ToString()</option>
                }
                else
                {
                    <option value="@proj.ToString()"> @proj.ToString()</option>
                }
            }
        </select> 
        Select Phase: 
        <select id="all_phase" name="phase" onchange="GenSubmitFormAction('allForm','@Url.Action("IndicatorsList", "GeneralDB")')">
            @foreach (var phase in ViewBag.phaselist)
            {
                if (phase.ToString() == ViewBag.phase)
                {
                    <option value="@phase.ToString()" selected="selected"> @phase.ToString()</option>
                }
                else
                {
                    <option value="@phase.ToString()" > @phase.ToString()</option>
                }
            }
        </select> 
        &nbsp; &nbsp; Launch all indicators 
        <input type="submit" value="Execute Official" class="button" />
        <input type="button" value="Execute BG (both)" class="button" onclick="GenSubmitFormAction('allForm','@Url.Action("IndicatorsLaunchAllBG", "GeneralDB")')"/>
        schedule: 
        <select id="frequency" name="frequency">
            <option value="weekly" > weekly</option>
            <option value="daily" > daily</option>
            <option value="monthly" > monthly</option>
        </select> 
        day:<input type="text" name="day"/>
        hour:<input type="text" name="hour"/>
        <input type="button" value="Create Schedule" class="button" onclick="GenSubmitFormAction('allForm','@Url.Action("IndicatorsCreateSchedule", "GeneralDB")')"/>
        
    </p>
      }

       @if ((User.IsInRole("CCD_EV_ADV")))
       {
           using (Html.BeginForm("IndicatorsAddWeeksAll", "GeneralDB", FormMethod.Post, new { @id = "addWeeksForm", @name = "addWeeksForm" }))
           {
                <input type="hidden" name="proj" value="@ViewBag.proj"  />
                <input type="hidden" name="phase" value="@ViewBag.phase"  />
                <input type="submit" value="Add/Remove Weeks" class="button" />
                <select id="wn" name="wn" >
                    <option value="1"> 1</option>
                    <option value="2"> 2</option>
                    <option value="3"> 3</option>
                    <option value="4"> 4</option>
                    <option value="5"> 5</option>
                    <option value="-1"> -1</option>
                    <option value="-2"> -2</option>
                    <option value="-3"> -3</option>
                 </select> 
           }

       }

