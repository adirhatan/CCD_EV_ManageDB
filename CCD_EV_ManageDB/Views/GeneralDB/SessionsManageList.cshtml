<h2>Sessions List</h2>
<script src="@Url.Content("~/Scripts/ccdEV.js")" type="text/javascript" ></script>     

<p class="messageText">@TempData["message"]</p>
<p class="messageInfoText">@TempData["messageInfo"]</p> 

      @using (Html.BeginForm("IndicatorsList", "GeneralDB", FormMethod.Post, new { @id = "allForm", @name = "allForm" }))
      {
     <p>
        Select Project: 
        <select id="all_proj" name="proj" onchange="GenSubmitFormAction('allForm','@Url.Action("SessionsManageList", "GeneralDB")')">
            @foreach (var proj in ViewBag.projlist)
            {
                if (proj.ToString() == ViewBag.proj)
                {
                    <option value="@proj.ToString()" selected="selected"> @proj.ToString()</option>
                }
                else
                {
                    <option value="@proj.ToString()"> @proj.ToString()</option>
                }
            }
        </select> 
        Select Phase: 
        <select id="all_phase" name="phase" onchange="GenSubmitFormAction('allForm','@Url.Action("SessionsManageList", "GeneralDB")')">
            @foreach (var phase in ViewBag.phaselist)
            {
                if (phase.ToString() == ViewBag.phase)
                {
                    <option value="@phase.ToString()" selected="selected"> @phase.ToString()</option>
                }
                else
                {
                    <option value="@phase.ToString()" > @phase.ToString()</option>
                }
            }
        </select> 
        Select Protocol: 
        <select id="all_protocol" name="protocol" class="wselect" onchange="GenSubmitFormAction('allForm','@Url.Action("SessionsManageList", "GeneralDB")')">
            @if (string.IsNullOrEmpty(ViewBag.protocol))
            {
                <option value="" ></option>
            }
            @foreach (var protocol in ViewBag.protocollist)
            {
                if (protocol.ToString() == ViewBag.protocol)
                {
                    <option value="@protocol.ToString()" selected="selected"> @protocol.ToString()</option>
                }
                else
                {
                    <option value="@protocol.ToString()" > @protocol.ToString()</option>
                }
            }
        </select> 
        
        &nbsp;&nbsp;&nbsp;
        @{  string checkedStr = "";
            if (Model.FilterSessionsView == "Valid_Pending")
            {
                checkedStr = "checked=\"checked\"";
            }
        <input type="radio" name="FilterSessions" id="ViewFilter_v" value="Valid_Pending" @checkedStr onclick="GenLocatioAction('@Url.Action("SessionsManageList", "GeneralDB", new { @protocol = ViewBag.protocol, @phase = ViewBag.phase, @proj = ViewBag.proj, @FilterSessions = "Valid_Pending", @_UnifyNVM = ViewBag.UnifyNVM })')"/>
        }
        <label for="name">Sessions: Valid, Pending only.</label>
        @{  
            checkedStr = "";
            if (Model.FilterSessionsView == "ALL")
            {
                checkedStr = "checked=\"checked\"";
            }
        <input type="radio" name="FilterSessions" id="ViewFilter_a" value="ALL" @checkedStr onclick="GenLocatioAction('@Url.Action("SessionsManageList", "GeneralDB", new { @protocol = ViewBag.protocol, @phase = ViewBag.phase, @proj = ViewBag.proj, @FilterSessions = "ALL", @_UnifyNVM = ViewBag.UnifyNVM })')"/>
        }
        <label for="name">Sessions: All</label>
        &nbsp;&nbsp;&nbsp;
        @{
            string checkedNVM = "";
            if (ViewBag.UnifyNVM == "Y")
            {
                checkedNVM = "checked=\"checked\"";
            }
        <input id="UnifyNVM" name="UnifyNVM" type="checkbox" @checkedNVM value="true" onclick = "GenLocatioAction('@Url.Action("SessionsManageList", "GeneralDB", new { @protocol = ViewBag.protocol, @phase = ViewBag.phase, @proj = ViewBag.proj, @FilterSessions = Model.FilterSessionsView, @_UnifyNVM = ViewBag.NVMrequest })')" />
        }
        Unify NVM ("E,Q" actions disabled)&nbsp;&nbsp;&nbsp;
        <input type="button" value="Reload" title="Reload clear page" class="button" onclick="GenLocatioAction('@Url.Action("SessionsManageList", "GeneralDB", new { @protocol = ViewBag.protocol, @phase = ViewBag.phase, @proj = ViewBag.proj })')" />
        @if (Model.Conf.separateCSRperTable != "Y")
        {
            <text>&nbsp; &nbsp; &nbsp;</text><input type="button" value="Generate" title="Generate Cycle Status report" class="button" onclick="ShowExpDialog('dialog-form','')" />
        }
        @if (Model.SessionsManageOfTables.Count > 0)
        {
            if (Model.Conf.useNewCSR != "Y")
            {
            <input type="button"  style="float: right;" value="Configure" title="Configure Cycle Status report" class="button" onclick="GenLocatioAction('@Url.Action("CSRConfigure", "GeneralDB", new { @protocol = ViewBag.protocol, @phase = ViewBag.phase, @proj = ViewBag.proj })')" />
            }
            <input type="button"  style="float: right;" value="F. Missing" title="Find sessions exist in DB but not in SM" class="button" onclick="GenLocatioAction('@Url.Action("ReportMissingSessionsInSM", "GeneralDB", new { @protocol = ViewBag.protocol, @phase = ViewBag.phase, @proj = ViewBag.proj })')" />
        }
    </p>

      }

@{
