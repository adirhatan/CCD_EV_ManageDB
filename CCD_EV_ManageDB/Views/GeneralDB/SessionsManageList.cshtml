    @{foreach (SessionsManageOfTable SMOT in Model.SessionsManageOfTables)
      {
          string formName = "form" + SMOT.table;
          string _checkAllName = "_checkAll" + SMOT.table;
          List<SessionsManage> SMOT_Filtered_Sessions = new List<SessionsManage>();
     <p><br /><b>@SMOT.table</b>
        @if (Model.Conf.separateCSRperTable == "Y")
        {
           <text> &nbsp; &nbsp; &nbsp;</text><input type="button" value="Generate" title="Generate Cycle Status report" class="button" onclick="ShowExpDialog('dialog-form','@SMOT.table')" />
        }
     </p>
        using (Html.BeginForm("ValidatePendingItems", "GeneralDB", FormMethod.Post, new { @id = formName, @name = formName }))
        {
        <input id="@_checkAllName" name="_checkAll" type="checkbox" onclick = "ValidateCheckAllGen('@formName','@_checkAllName')" value="true"/>
        <input type="submit"class="button" value="Validate checked items" onclick = "return confirm('Are you sure you want to validate checked items?\n(LogicUnit must be assigned for all checked items)')"/>
     <table id="" class="display">
    <thead>
    <tr>
        <th >
            Validation
        </th>
        <th >
            LogicUnit
        </th>
        <th >
            Edit
        </th>
        <th >
            Query
        </th>
        <th >
            board
        </th>
        <th >
            Type
        </th>
        <td>
            NVM
        </td>
        <th >
            Comment
        </th>
        <th >
            Sessions
        </th>
        <th >
            Results
        </th>
        @foreach (var fieldAlias in Model.Conf.fieldsAliases)
        {
            <th >
                @fieldAlias
            </th>  
        }
    </tr> 

    </thead>
    <tbody>

    @if (Model.FilterSessionsView == "Valid_Pending")
    {
        foreach (SessionsManage SM in SMOT.Sessions)
        {
            if ((SM.validation != General.SessionValidationStatus.PRM_not_valid) && (SM.validation != General.SessionValidationStatus.TMP_not_valid))
            {
                SMOT_Filtered_Sessions.Add(SM);
            }
        }
    }
    else
    {
        SMOT_Filtered_Sessions = SMOT.Sessions;
    }
    @foreach (SessionsManage SM in SMOT_Filtered_Sessions)
    {
        string c_id = "_cb" + SM._id;
     <!--tr @{string s = "style=background-color:Orange"; if (string.IsNullOrEmpty(SM.logicUnit))
              { @s;
              }}-->
     <tr @{string st = "style=background-color:Orange"; if (SM.validation == General.SessionValidationStatus.Pending_review)
           { @st;
           }}>
        <td @{string std = "style=background-color:Orange"; if (SM.validation == General.SessionValidationStatus.Pending_review)
              { @std;
              }}>
        @if (SM.validation == General.SessionValidationStatus.Pending_review)
        {<input id="@c_id" name="@c_id" type="checkbox" />}
           @SM.validation.ToString()
        </td> 
        <td>
            @SM.logicUnit
        </td> 
        @{
        if (ViewBag.UnifyNVM == "Y")
        {
            <td>
                <input type="button" value="E"  disabled="disabled" title="Not allowed in unified NVM view" class="button" onclick="GenLocatioAction('@Url.Action("SessionsManageEdit", "GeneralDB", new { @_id = SM._id, @protocol = ViewBag.protocol, @phase = ViewBag.phase, @proj = ViewBag.proj })')" />
             
            </td>
            <td>
                <input type="button" value="Q" disabled="disabled" title="Not allowed in unified NVM view" class="button"  onclick="GenLocatioAction_id('@SM._id','@Url.Action("SessionsManageQueryDB", "GeneralDB")')" />
            </td>
        }
        else
        {
            <td>
                <input type="button" value="E" title="Edit record" class="button" onclick="GenLocatioAction('@Url.Action("SessionsManageEdit", "GeneralDB", new { @_id = SM._id, @protocol = ViewBag.protocol, @phase = ViewBag.phase, @proj = ViewBag.proj })')" />
             
            </td>
            <td>
                <input type="button" value="Q" title="Query record" class="button"  onclick="GenLocatioAction_id('@SM._id','@Url.Action("SessionsManageQueryDB", "GeneralDB")')" />
            </td>
        }
        }
        <td>
        @(SM.board_id + "_" + SM.unit_id)
        </td> 
        @{
        string tmpType = SM.Data.GetValue("sType", "").ToString();
        <td>
            @tmpType
        </td>
        }
        <td>
            @SM.NVM
        </td>
        <td>
            @SM.comment  
        </td> 
        <td>
            @{
        string eol = "ppp";
        int cnt = 0;
        string resultsNum = "";
        string status = "Pass";
        string style = "style=color:Green";
        int ResultsSum = 0;

        foreach (string session in SM.Sessions)
        {
            if ((SM.validation == General.SessionValidationStatus.TMP_valid) || (SM.validation == General.SessionValidationStatus.TMP_not_valid) || (SM.validation == General.SessionValidationStatus.Pending_review))
            {
                resultsNum = SMOT.SessionStartInfoDictionary[session].GetValue("TMP results", "").ToString();
                status = SMOT.SessionStartInfoDictionary[session].GetValue("TMP results status", "").ToString();
            }
            if (SM.validation == General.SessionValidationStatus.PRM_valid)
            {
                resultsNum = SMOT.SessionStartInfoDictionary[session].GetValue("PRM results inc", "").ToString();
                status = SMOT.SessionStartInfoDictionary[session].GetValue("PRM results inc status", "").ToString();
            }
            if (SM.validation == General.SessionValidationStatus.PRM_not_valid)
            {
                resultsNum = SMOT.SessionStartInfoDictionary[session].GetValue("PRM results exc", "").ToString();
                status = SMOT.SessionStartInfoDictionary[session].GetValue("PRM results exc status", "").ToString();
            }
            if (status == "Fail")
            {
                style = "style=color:Red";
            }
            else
            {
                style = "style=color:Green";
            }
            ResultsSum += Convert.ToInt32(resultsNum);
            cnt++;
            if (cnt % 5 == 0)
            {
                        <span title="@SMOT.SessionStartInfoDictionary[@session].GetValue("UserComment", "")" @style>@session (@resultsNum),</span> @eol
            }
            else
            {
                        <span title="@SMOT.SessionStartInfoDictionary[@session].GetValue("UserComment", "")" @style>@session (@resultsNum),</span>
            }

        }
                 
            }
        </td>
        <td>
         <span title="results number"> @ResultsSum</span>
        </td>
        @foreach (var field in Model.Conf.fields)
        {
            string data = SM.Data.GetValue(field, "").ToString();
            <td>
                @data
            </td>
        }

    </tr>
    }
    </tbody>
</table>
        }
      }
}

