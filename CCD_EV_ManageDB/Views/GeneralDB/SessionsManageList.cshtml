<div id="dialogSpecLimitsConflicts-form" title="Spec Limis Conflicts">
  <p class="validateTips">View Session's Spec Limits Conflicts.</p>
     
     @{foreach (SessionsManageOfTable SMOT in Model.SessionsManageOfTables)
       {
           string formName = "SpecLimitsConflictsForm" + SMOT.table;
           string conflictSessions = "";
           if (SMOT.SpecLimitsConflictSessions.Count > 0) 
           {
              <form action='@Url.Action("ViewSpecLimitsConflicts", "GeneralDB")' id="@formName" name="@formName">
                    <input type="hidden" name="phase" id="SLCphase" value="@ViewBag.phase" />
                    <input type="hidden" name="proj" id="SLCproj" value="@ViewBag.proj" />
                    <input type="hidden" name="table" id="SLCtable" value="@SMOT.table" />
                <fieldset>
                    <label for="name">Warning: The following sessions (Table: <b>@SMOT.table</b>) contain Spec Limits Conflicts: </label><br />
                     @{
                        int cnt = 0;
                        foreach (string  conflictSession in SMOT.SpecLimitsConflictSessions)
                        {
                            cnt++;
                            conflictSessions += conflictSession + ",";
                            if (cnt % 3 == 0) 
                            {
                                <b style="color:Red">@conflictSessions</b>
                                <br />
                                conflictSessions = "";
                            }
                        }  
                       if (cnt % 3 != 0) 
                       {
                           <b style="color:Red">@conflictSessions</b>
                       }
                     }
                  <br /><input type="submit" value="View" class="button"/>
                </fieldset>
              </form>
           }
       }
     }
</div>