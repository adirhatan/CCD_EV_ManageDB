<!DOCTYPE html>
@using System.Web.Mvc.Html;
@using CCD_EV_ManageDB.Helpers;
<html>
<head>
    <title>@ViewBag.Title</title>
    <link href="@Url.Content("~/Content/Site.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.Content("~/Content/themes/base/all.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.Content("~/Content/jquery.dataTables.css")" rel="stylesheet" type="text/css" />
    <!--<script src="@Url.Content("~/Scripts/jquery-1.5.1.min.js")" type="text/javascript"></script>-->
    <script src="@Url.Content("~/Scripts/jquery-1.11.1.min.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Scripts/jquery-ui-1.11.4.min.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Scripts/jquery.dataTables.min.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Scripts/progressbar.min.js")" type="text/javascript"></script>
     @Html.IncludeNGon()
</head>

<body>
   <!-- <div id="header"> -->
   <div class="titlebar">
            @{ if (User.Identity.IsAuthenticated)
               {
                    <ul id="navlistLogout">
                        <li>Logout
                            <ul>
                               <li><a href="@Url.Action("LogOff", "Account")">Logout</a></li>
                               <li><a href="@Url.Action("ChangePassword", "Account")" title="Change Password">C. Pass</a></li>
                           </ul>
                        </li>
                    </ul>
                    <script type="text/JavaScript">
                        $("#navlistLogout").menu();
                        $("#navlistLogout").menu({
                            position: { my: "center bottom", at: "center top" }
                        });
                    </script>
               }
               else
               {
                    <ul id="navlistLogin">
                        <li>
                            <a href="@Url.Action("LogOn", "Account", new { returnUrl = @Url.Action("Index", "ManageDB") })">Login</a>
                        </li>
                    </ul>
                    <script type="text/JavaScript">
                        $("#navlistLogin").menu();
                        $("#navlistLogin").menu({
                            position: { my: "center bottom", at: "center top" }
                        });
                    </script>
               }
             }

              @{ if ((User.Identity.IsAuthenticated) && ((User.IsInRole("CCD_EV_COMP")) || (User.IsInRole("CCD_PAE"))))
                 {
                   <ul id="navlistComp">
                       <li>Comp
                            <ul>
                                <li><a href="@Url.Action("InventoryLines", "InventoryDB")">Inventory</a></li>
                                <li><a href="@Url.Action("InventoryLines", "InventoryDB", new RouteValueDictionary(new { arcdb = "true" }))">Inventory Arch</a></li>
                               @if ((User.Identity.IsAuthenticated) && (User.IsInRole("CCD_EV_COMP")))
                               { 
                                   <li><a href="@Url.Action("CompReports", "CompReportDB")">Reports</a></li>    
                               }
                               <li><a href="@Url.Action("SearchCOMPArch", "ManageDB")">COMP DB Arch</a></li>
                               <li><a href="@Url.Action("SearchCOMP", "ManageDB")">COMP DB</a></li>  
                               <li><a href="@Url.Action("ExecutionLogNew", "ManageDB", new RouteValueDictionary(new { logDB = "CMP" }))">COMP Logs</a></li   >
                            </ul>
                        </li>
                    </ul>
                <script type="text/JavaScript">
                    $("#navlistComp").menu();
                    $("#navlistComp").menu({
                        position: { my: "center bottom", at: "center top" }
                    });
                </script>
                 }
               }

                <ul id="navlistSearch">
                    <li>Search
                        <ul>
                            <li><a href="@Url.Action("SearchTMP", "ManageDB")">TMP DB</a></li>
                            <li><a href="@Url.Action("SearchREC", "ManageDB")">Recycle DB</a></li>
                            <li><a href="@Url.Action("ExecutionLogNew", "ManageDB", new RouteValueDictionary(new { logDB = "TMP" }))">TMP Logs</a></li>
                            <li><a href="@Url.Action("SearchPRM", "ManageDB")">PRM DB</a></li>
                            @if ((User.IsInRole("CCD_EV")))
                            {
                            <li><a href="@Url.Action("SearchPRMArch", "ManageDB")">PRM DB Arch</a></li>
                            }
                            <li><a href="@Url.Action("BoardsLines", "ManageDB")">EV Boards</a></li>
                            @if ((!User.Identity.IsAuthenticated) || (User.IsInRole("CCD_EV_GB")))
                            { 
                                <li><a href="@Url.Action("ViewAllMonitorTables", "MonitorDB")">View Monitors</a></li>    
                            }
                        </ul>
                    </li>
                </ul>
                <script type="text/JavaScript">
                    $("#navlistSearch").menu();
                    $("#navlistSearch").menu({
                        position: { my: "center bottom", at: "center top" }
                    });
                </script>

            @{ if (((User.Identity.IsAuthenticated) && ((User.IsInRole("CCD_EV")) || (User.IsInRole("CCD_EV_GB")))))
               {
                <ul id="navlistMy">
                    <li>My
                        <ul>
                            <li><a href="@Url.Action("MyPreferences", "ManageDB")">Preferences</a></li>
                           <li><a href="@Url.Action("MyQueries", "ManageDB")">Queries</a></li>
                           <li><a href="@Url.Action("MyReports", "ReportDB")">Reports</a></li>
                           <li><a href="@Url.Action("MyBGTasks", "ManageDB")">BGTasks</a></li>
                           @if ((User.Identity.IsAuthenticated) && (User.IsInRole("CCD_EV")))
                           {
                           <li><a href="@Url.Action("MyMonitorTables", "MonitorDB")">Monitors</a></li>
                           }
                        </ul>
                    </li>
                </ul>
            <script type="text/JavaScript">
                $("#navlistMy").menu();
                $("#navlistMy").menu({
                    position: { my: "center bottom", at: "center top" }
                });
            </script>
               }
             }

<!--New -->
            @if ((User.IsInRole("CCD_EV_ADV")))
            {
                <ul id="navlistGen">
                    <li>Manage
                        <ul>
                            <li><a href="@Url.Action("ADMRefTables", "GeneralDB")">Spec Tables</a></li>
                            <li><a href="@Url.Action("IndicatorsList", "GeneralDB")">Indicators</a></li>
                            <li><a href="@Url.Action("IndicatorsLog", "GeneralDB")">Indicators Log</a></li>
                            <li><a href="@Url.Action("LiveIndicatorsView", "ManageDB")">Live Indicators</a></li>
                            <li><a href="@Url.Action("SessionsManageList", "GeneralDB")">Sessions</a></li>
                            <li><a href="@Url.Action("SearchSpecLimitsConflicts", "GeneralDB")">Spec Limits Conflicts</a></li>
                            <li><a href="@Url.Action("Main", "CyclePlanDB")">Cycle Plan</a></li>
                            @if ((User.IsInRole("CCD_EV_ADM")))
                            {
                            <li><a href="@Url.Action("CalibrationLines", "CalibrateDB")">Calibration</a></li>
                            }
                        </ul>
                    </li>
                </ul>
                <script type="text/JavaScript">
                    $("#navlistGen").menu();
                    $("#navlistGen").menu({
                        position: { my: "center bottom", at: "center top" }
                    });
                </script>
            }
            

            @if ((User.IsInRole("CCD_EV_GB")))
            {
                <ul id="navlistGenGB">
                    <li>Manage
                        <ul>
                            <li><a href="@Url.Action("SessionsManageList", "GeneralDB")">Sessions</a></li>
                        </ul>
                    </li>
                </ul>
                <script type="text/JavaScript">
                    $("#navlistGenGB").menu();
                    $("#navlistGenGB").menu({
                        position: { my: "center bottom", at: "center top" }
                    });
                </script>
            }
            
            
            @if ((User.IsInRole("CCD_EV_ADM")))
            {
                <ul id="navlistAdm">
                    <li>Admin
                        <ul>
                            <li><a href="@Url.Action("IndicatorsList", "GeneralDB")">Indicators</a></li>
                            <li><a href="@Url.Action("Index", "AdminDB")">Main</a></li>
                            <li><a href="@Url.Action("ViewProjectsList", "GeneralDB")">Archive Tables</a></li>
                            <li><a href="@Url.Action("CopyReportOfUser", "AdminDB")">Copy Report</a></li>
                            <li><a href="@Url.Action("JobsSchedulerADM", "GeneralDB")">Schedule Jobs</a></li>
                        </ul>
                    </li>
                </ul>
                <script type="text/JavaScript">
                    $("#navlistAdm").menu();
                    $("#navlistAdm").menu({
                        position: { my: "center bottom", at: "center top" }
                    });
                </script>
            }
        @{if (User.Identity.IsAuthenticated)
          {
            <h1>
            &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;CCD_EV DB Manage <br /> Hi @User.Identity.Name
            </h1>
          }
          else
          {
            <h1>
            &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;CCD_EV DB Manage
            </h1>
          }
        }
    </div>

    @RenderBody()
</body>
</html>
