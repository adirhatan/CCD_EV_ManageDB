          @using (Html.BeginForm("LaunchTestModeMarginReport", "AdminDB", FormMethod.Post, new { @id = "LoadSessionsManageConfForm", @name = "LoadSessionsManageConfForm" }))
      {
            <p>Launch TestModeMarginReport:
                Select Interface: 
                <select id="TestModeMarginReportInterface" name="_interface">

                    <option value=""></option>
                    <option value="USB">USB</option>
                    <option value="CIO">CIO</option>
                    <option value="DP">DP</option>
                    <option value="PCIE">PCIE</option>
                    <option value="Power">POWER</option>
                    <option value="Crystal">Crystal</option>

                </select> 
                DB:
                <select id="TestModeMarginReportdb" name="db_str">

                    <option value="DB_TMP"> TMP</option>
                    <option value="DB_PRM"> PRM</option>

                </select> 
                Project:
                <select id="TestModeMarginReportProj" name="proj">
                    @foreach (var proj in ViewBag.projlist)
                    {
                        <option value="@proj.ToString()"> @proj.ToString()</option>
                    }
                </select> 
                Phase:
                <select id="TestModeMarginReportPhase" name="phase">
                    @foreach (var phase in ViewBag.phaselist)
                    {
                        <option value="@phase.ToString()"> @phase.ToString()</option>
                    }
                </select> 
                <input type="submit" value="Submit" />
