@model CCD_EV_ManageDB.Models.UserTableReport
@using MongoDB.Bson;
@using MongoDB.Driver;
@using MongoDB.Bson.Serialization;
@using System.Collections.Generic;
@using System.Web.UI.WebControls;
@using CCD_EV_ManageDB.Models;
@using System.Web.Script.Serialization;


@{
    ViewBag.Title = "Validate results completeness for report";
}

<script type="text/JavaScript">

    
</script>
 <h2>Validate results completeness for report</h2>
<p class="messageText">@TempData["message"]</p>
<p class="messageInfoText">@TempData["messageInfo"]</p> 
<br />
<p>Report Name: <b>@Model.Name</b>&nbsp  Report TestName: @Model.TestName</p>
<script src="@Url.Content("~/Scripts/ccdEV.js")" type="text/javascript" ></script>
<table class="tableNoborder">
<tr>
<td valign="top">

   @using (Html.BeginForm("ValidateResCompReport", "ReportDB", FormMethod.Post, new { @id = "myForm", @name = "myForm" }))
   {
    @Html.Hidden("_id", Model._id)
    @Html.Hidden("LanesStr", "")
    @Html.Hidden("FieldSlidesStr", "")
    <p> UnitID: @Html.TextBox("UnitID") </p>
    bool prmChecked = (ViewBag.db == "PRM");
    bool tmpChecked = (ViewBag.db == "TMP");
    bool Lane0Checked = ViewBag.LanesStr.Contains("L0");
    bool Lane1Checked = ViewBag.LanesStr.Contains("L1");
    bool Lane2Checked = ViewBag.LanesStr.Contains("L2");
    bool Lane3Checked = ViewBag.LanesStr.Contains("L3");
    bool Lane4Checked = ViewBag.LanesStr.Contains("L4");
    bool Lane5Checked = ViewBag.LanesStr.Contains("L5");
    bool Lane6Checked = ViewBag.LanesStr.Contains("L6");
    bool Lane7Checked = ViewBag.LanesStr.Contains("L7");
    bool LaneNAChecked = ViewBag.LanesStr.Contains("NA");
    <p> Choose DB for validating report: @Html.RadioButton("db", "PRM", prmChecked)PRM @Html.RadioButton("db", "TMP", tmpChecked)TMP</p>

    <p>
    L0 @Html.CheckBox("_LL0",Lane0Checked)
    L1 @Html.CheckBox("_LL1",Lane1Checked)
    L2 @Html.CheckBox("_LL2",Lane2Checked)
    L3 @Html.CheckBox("_LL3",Lane3Checked)
    L4 @Html.CheckBox("_LL4",Lane4Checked)
    L5 @Html.CheckBox("_LL5",Lane5Checked)
    L6 @Html.CheckBox("_LL6",Lane6Checked)
    L7 @Html.CheckBox("_LL7", Lane7Checked)
    NA @Html.CheckBox("_LNA",LaneNAChecked)
    </p>

    <input type="submit" value="Validate Report Results completeness" onclick="ValidateResCompReportFormToStr()" />
                    <table id="fsTables" class="display">
                <thead>
                    <tr>
                        <th >
                            TestName
                        </th>
                        <th >
                            Field
                        </th>
                        <th >
                            @Html.CheckBox("_checkAll", new { @id = "_checkAll", @onclick = "ValidateResCompReportCheckAll()" }) &nbsp;
                        </th>
                    </tr>
                </thead>
                <tbody>
                @{
                    int cnt = 0;
                    bool cbChecked=false;
                    foreach (FieldSlide FS in Model.RConfig.FieldsSlides)
                    {
                        cbChecked= ViewBag.FieldSlidesStr.Contains(cnt.ToString());
                    <tr>
                        <td>@FS.test</td>
                        <td>@FS.column</td>
                        <td>@Html.CheckBox("_cb" + cnt.ToString(),cbChecked)</td>
                    </tr>
                        cnt++;
                    }
               }
            </tbody>
           </table>

   }
   </td>
   <td valign="top">
   @{
       List<BsonDocument> MissedResults = ViewBag.MissedResults;
       if (MissedResults != null)
       {
           if (MissedResults.Count > 0)
           {
               <p>Following missing results for UnitId: @ViewBag.UnitID (@MissedResults.Count results)</p>
             <table id="rTables" class="display">
                <thead>
                    <tr>
                        <th >
                            Corner
                        </th>
                        <th >
                            Lane
                        </th>
                        <th >
                           TestName
                        </th>
                        <th >
                            Field
                        </th>
                    </tr>
                </thead>
                <tbody>
               @foreach (BsonDocument doc in MissedResults)
               {
                   <tr>
                   <td>@doc.GetValue("Corner", "")</td>
                   <td>@doc.GetValue("Lane", "")</td>
                   <td>@doc.GetValue("TestName", "")</td>
                   <td>@doc.GetValue("Field", "")</td>
                   </tr>
               }
            </tbody>
           </table>
           }
           else
           {
               <p>Results are complete for  UnitId: @ViewBag.UnitID</p>
           }
       }
   }
   </td>
   </tr>
   </table>
