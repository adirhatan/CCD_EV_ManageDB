@if ((!User.IsInRole("CCD_EV_GB")))
{
    using (Html.BeginForm("CreateReport", "ReportDB", FormMethod.Post, new { @id = "ReportForm", @name = "ReportForm" }))
    {
     <p>Create new empty report: &nbsp; 
         Report name:
        <input type="text" id="rName" name="rName" style="width: 120px" />
        Test name (field):
        <input type="text" id="tName" name="tName" style="width: 120px"  value="TestName"/>
        Select table for report: 
        <select id="tableName" name="tableName">
            @foreach (var col in ViewBag.collist)
            {
                <option value="@col.ToString()"> @col.ToString()</option>
            }
        </select> 
        <!-- 
        Select reference
        <select id="refId" name="refId">
            @foreach (var col in ViewBag.reflist)
            {
                <option value="@col.ToString()"> @col.ToString()</option>
            }
        </select>
        -->
        <input type="submit" value="Submit" />
    </p>
    }

    using (Html.BeginForm("SendReportToUser", "ReportDB", FormMethod.Post, new { @id = "CopyReportForm", @name = "CopyReportForm" }))
    {
     <p>Send report to another user: &nbsp; 
        Report Name:
        <select id="SReportId" name="ReportId" class="wselect">
            <option value=""></option>
            @{ MongoCursor cloneCur = Model.Clone((new BsonDocument()).GetType());
               foreach (BsonDocument report in cloneCur)
               {
                    <option value="@report.GetValue("_id").ToString()"> @report.GetValue("name", "").ToString()</option>
               }
             }
        </select>
        User Name:
        <select id="CUserId" name="UserId" class="wselect">
            @foreach (var user in ViewBag.Users)
            {
                <option value="@user.ToString()"> @user.ToString()</option>
            }
        </select> 

        <input type="submit" value="Submit" />
    </p>
    }

    using (Html.BeginForm("CreateReport", "ReportDB", FormMethod.Post, new { @id = "ReportRefForm", @name = "ReportRefForm" }))
    {
     <p>Create new report from spec: &nbsp; 
         Report name:
        <input type="text" id="rrName" name="rName" style="width: 120px" />
        <input type="hidden" id="rtName" name="tName" value="SpecTestName"/>
        Select table for report: 
        <select id="rtableName" name="tableName">
            @foreach (var col in ViewBag.collist)
            {
                <option value="@col.ToString()"> @col.ToString()</option>
            }
        </select> 
        Select spec
        <select id="refId" name="refId">
            @foreach (var col in ViewBag.reflist)
            {
                <option value="@col.ToString()"> @col.ToString()</option>
            }
        </select>
        Select template
        <select id="pandaTemplate" name="pandaTemplate" class="wmselect">
            <option value=""> </option>
        @{
            foreach (string template in ViewBag.Templates)
            {
                {
                    <option value="@template"> @template</option>
                }
            }
        }
        </select> 
        optional: Select Report to copy Images/Templates
       <select id="rFromId" name="rFromId" class="wselect">
            <option value=""></option>
            @{ MongoCursor cloneCur = Model.Clone((new BsonDocument()).GetType());
               foreach (BsonDocument report in cloneCur)
               {
                    <option value="@report.GetValue("_id").ToString()"> @report.GetValue("name", "").ToString()</option>
               }
             }
        </select>

        <input type="submit" value="Submit" />
    </p>
    }

 <br />
}


    @using (Html.BeginForm("MyReports", "ReportDB", FormMethod.Post, new { @id = "ReportDBForm", @name = "ReportDBForm" }))
    {
        bool prmChecked = (ViewBag.db == "PRM");
        bool tmpChecked = (ViewBag.db == "TMP");
        bool prmArchChecked = (ViewBag.db == "PRMArch");
        if ((!User.IsInRole("CCD_EV_GB")))
        {
   <p> Choose DB for running report: @Html.RadioButton("db", "PRM", prmChecked, new { @onclick = "document.getElementById('ReportDBForm').submit()" })PRM @Html.RadioButton("db", "TMP", tmpChecked, new { @onclick = "document.getElementById('ReportDBForm').submit()" })TMP @Html.RadioButton("db", "PRMArch", prmArchChecked, new { @onclick = "document.getElementById('ReportDBForm').submit()" })PRM Archive.&nbsp;&nbsp; Current query: Table:"@ViewBag.col" Query: "@ViewBag.Query"</p>
        }
        else
        {
   <p> Choose DB for running report: @Html.RadioButton("db", "PRM", prmChecked, new { @onclick = "document.getElementById('ReportDBForm').submit()" })PRM @Html.RadioButton("db", "TMP", tmpChecked, new { @onclick = "document.getElementById('ReportDBForm').submit()" })TMP &nbsp;&nbsp; Current query: Table:"@ViewBag.col" Query: "@ViewBag.Query"</p>
        }
    }
  <br />

  <table id="rTables" class="display">
    <thead>
    <tr>
        <th >
            Run
        </th>
        <th >
            Run last query
        </th>
        <th >
            Edit
        </th>
        <th >
            Status
        </th>
        <th >
            Copy
        </th>
        <th >
            Delete
        </th>
        <th >
            Name
        </th>
        <th >
            Rename
        </th>
        <th >
            Table
        </th>
        <th >
            P.Executions
        </th>
    </tr> 

    </thead>
    <tbody>
    @foreach (BsonDocument item in Model)
    {
        string r_id = item.AsBsonDocument.GetElement("_id").Value.ToString();
        string SaveName = "SaveName" + r_id;
        string Name = "SaveName" + r_id;
        string rForm = "r" + r_id;
        string rlForm = "rl" + r_id;
        UserTableReport Report = new UserTableReport();
        Report._id = item.GetValue("_id", "").ToString(); ;
        Report.Name = item.GetValue("name", "").ToString();
        Report.RConfig = item.GetValue("RConfig").AsBsonDocument.BsonDocumentToReportConfig();
        Report.ResultsPath = item.GetValue("ResultsPath", "").ToString();
        //Report.Search = item.GetValue("Search").AsBsonDocument.BsonDocumentToDBsearchSave();
        Report.Search = BsonSerializer.Deserialize<DBsearchSave>(item.GetElement("Search").Value.ToBsonDocument());
        Report.TestName = item.GetValue("TestName", "").ToString(); 
     <tr>
        <td>
        @if (Report.RConfig.table == ViewBag.col)
        {
            using (Html.BeginForm("RunReportBG", "ReportDB", FormMethod.Post, new { @id = rForm, @name = rForm }))
            {
                <input type="submit" value="R" title="Run Report with current query: DB @ViewBag.db; @ViewBag.Query" class="button" />
                <input type="button" value="RP" title="Run Partial Report with current query: DB @ViewBag.db; @ViewBag.Query" class="button" onclick="GenSubmitFormAction('@rForm','@Url.Action("RunPartialReport", "ReportDB")')";/>
                <input type="text" id="desc" name="desc" style="width: 75px" title="Report user note" />
                <input type="checkbox" value="Y" name="debug" title="Debug Excel file"/>
                <input type="hidden" id="_id" name="_id" value="@r_id" />
                <input type="hidden" id="db" name="db" value="@ViewBag.db" />
                <input type="hidden" id="FieldSlidesStr" name="FieldSlidesStr" value="" />
            }
        }
        else
        {
            string action = "SearchTMP";
            if (ViewBag.db == "PRM") { action = "SearchPRM"; }
            using (Html.BeginForm("SearchTMP", "ManageDB", FormMethod.Post, new { @id = "qForm", @name = "qForm" }))
            {
                <input type="button" value="Q" title="Define query to run Report" class="button" onclick="FormConfirmAction('qForm','@Url.Action(action, "ManageDB")','Current query does not match table\nNeed to execute search and choose correct DB first')"/>
            }
        }
        </td>  
        <td>
        @if ((Report.Search.Query != null) && (!Report.Search.Query.IsEmpty()))
        {
            using (Html.BeginForm("RunReportBG", "ReportDB", FormMethod.Post, new { @id = rlForm, @name = rlForm }))
            {
                <input type="submit" value="Rlast" title="Run Report with last query:DB @Report.Search.db ; @Report.Search.Query" class="button" />
                <input type="button" class="button" value="RP" title="Run Partial Report with last query:DB @Report.Search.db ; @Report.Search.Query" onclick="GenSubmitFormAction('@rlForm','@Url.Action("RunPartialReport", "ReportDB")')";/>
                <input type="text" id="ldesc" name="desc" style="width: 75px" title="Report user note" />
                <input type="checkbox" value="Y" name="debug" title="Debug Excel file"/>
                <input type="hidden" id="l_id" name="_id" value="@r_id" />
                <input type="hidden" id="ldb" name="db" value="LST" />
            }
        }
        else
        {
            <p>New Report</p>
        }
        </td>  
        <td>
        @using (Html.BeginForm("EditReport", "ReportDB", FormMethod.Post, new { @id = "eForm", @name = "eForm" }))
        {
            <input type="submit" value="E" title="Edit Report" class="button" />
             <input type="hidden" id="e_id" name="_id" value="@r_id" />
             <input type="hidden" id="fromCopy" name="fromCopy" value="false" />
        }
        </td>
        <td>
        @if (Report.RConfig.table == ViewBag.col)
        {
            <input type="button" value="RS" title="Run status report " class="button" onclick="ShowRSDialog('dialog-form','@r_id')" />
        }
        else
        {
           <input type="button" value="Q-RS" title="Run status report - query does not match " class="button" disabled="disabled" />
        }
        &nbsp;
            <input type="button" value="V" title="Validate Report completeness" class="button" onclick="GenLocatioAction_id('@r_id','@Url.Action("ValidateResCompReport", "ReportDB")')" />
        </td>
        <td>
        @{
        bool notCIO = true;
        if (Report.TestName != "SpecTestName")
        {
            if ((Report.RConfig.table == "CIO_Rounded_Gen2_Rx") || (Report.RConfig.table == "CIO_Rounded_Gen3_Rx") || (Report.RConfig.table == "TBT3_Legacy_Gen2_Rx") || (Report.RConfig.table == "TBT3_Legacy_Gen3_Rx"))
            {
                notCIO = false;
                <input type="button" value="C" title="Copy Report"  class="button" onclick="ShowCIORXDialog('dialog-form-cio-rx','@r_id','@Report.RConfig.table')" />
            }
            if ((Report.RConfig.table == "CIO_Rounded_Gen2_Tx") || (Report.RConfig.table == "CIO_Rounded_Gen3_Tx") || (Report.RConfig.table == "TBT3_Legacy_Gen2_Tx") || (Report.RConfig.table == "TBT3_Legacy_Gen3_Tx"))
            {
                notCIO = false;
                <input type="button" value="C" title="Copy Report"  class="button" onclick="ShowCIOTXDialog('dialog-form-cio-rx','@r_id','@Report.RConfig.table')" />
            }
        }
        if (notCIO)
        {
                <input type="button" value="C" title="Copy Report" class="button" onclick="GenLocatioAction_id('@r_id','@Url.Action("CopyReport", "ReportDB")')" />
        }
        }
        </td>
        <td>
            <input type="button" value="D" title="Delete Report" class="button" onclick="GenLocatioAction_id('@r_id','@Url.Action("DeleteReport", "ReportDB")')" />
        </td>
        <td id="@r_id">
        @Report.Name
        </td>
        <td>
            <input type="text" id="@SaveName" name="@SaveName" style="width: 120px" />
            <input type="button" value="M" title="Rename Report" class="button" onclick="GenAjaxRenameElem_id('@SaveName','@r_id','@Url.Action("RenameReport", "ReportDB")')" />
        </td>
        <td >
             @Report.RConfig.table
        </td>
        <td >
              @using (Html.BeginForm("MyBGTasks", "ManageDB", FormMethod.Post, new { @id = "exForm", @name = "exForm" }))
              {
                <input type="submit" value="P. Exec" title="Previous executions" class="button" />
                <input type="hidden" id="SourceID" name="SourceID" value="@Report._id" />
              }
        </td>
    </tr>
    }
    </tbody>
</table>

<div id="dialog-form" title="Status report">
  <p class="validateTips">Edit Excel Status report content.</p>
 
  <form action='@Url.Action("StatusReportExec", "ReportDB")' id="SRForm">
    <fieldset>
      <label for="name">Tests Format:</label>
      	<select id="JoinFieldKey" name="JoinFieldKey" style="width: 150px">
		<option value="N" > Test name</option>   
        <option value="Y" > Test name & field</option>
	    </select> 
      <br />
      <label for="name">Lanes Format:</label>
      	<select id="Lanes" name="Lanes" style="width: 270px">
        <option value="PABL01" > Ports (A,B) L0-L1 [BB,DB,AR,MR]</option>
        <option value="PABEL01" > Ports (A,B,E) L0-L1 [TR]</option>
        <option value="PABCDEL01" > Ports (A,B,C,D,E) L0-L1 [GR]</option>
        <option value="PABCDL01" > Ports (A,B,C,D) L0-L1 [GR-Partial]</option>
        <option value="PABL01" > Ports (A,B) L0-L1 [GR-Partial]</option>
        <option value="PCDL01" > Ports (C,D) L0-L1 [GR-Partial]</option>
        <option value="PABL03" > Ports (A,B) L0-L3 [BB,DB,AR,MR]</option>
        <option value="PAB0L03" > Ports (A,B,S0) L0-L3 [BB,DB,AR,MR]</option>
        <option value="PABCDEL03" > Ports (A,B,C,D,E) L0-L3 [GR]</option>
        <option value="PABLNA" > Ports (A,B) No Lanes [AR,TR,MR]</option>
        <option value="PAB0LNA" > Ports (A,B,S0) No Lanes [BB,DB,MR]</option>
        <option value="PABELNA" > Ports (A,B,E) No Lanes [TR,GR]</option>
        <option value="PABCDELNA" > Ports (A,B,C,D,E) No Lanes [GR]</option>
        <option value="NPL03" > No Ports L0-L3 [BB,DB,AR,TR,MR]</option>
        <option value="NPL0" > No Ports L0 [GR]</option>
        <option value="NPL07" > No Ports L0-L7 [GR (RL)]</option>
	    </select> 
      <br />
      <label for="name">Separator field 1:</label>
      	<select id="S1" name="S1" style="width: 150px">
		<option value="SessionStart" > SessionStart</option>   
        <option value="BoardNumber"> BoardNumber</option>
		<option value="UnitId"> UnitId</option>
        <option value="Skew"> Skew</option>
        <option value="HostName"> HostName</option>
	    </select> 
      <br />
        <label for="name">Separator field 2:</label>
      	<select id="S2" name="S2"style="width: 150px">
        <option value=""></option>
		<option value="SessionStart" > SessionStart</option>   
        <option value="BoardNumber"> BoardNumber</option>
		<option value="UnitId"> UnitId</option>
        <option value="Skew"> Skew</option>
        <option value="HostName"> HostName</option>
	    </select> 
      <br />
        <label for="name">Separator field 3:</label>
      	<select id="S3" name="S3" style="width: 150px">
        <option value=""></option>
		<option value="SessionStart" > SessionStart</option>   
        <option value="BoardNumber"> BoardNumber</option>
		<option value="UnitId"> UnitId</option>
        <option value="Skew"> Skew</option>
        <option value="HostName"> HostName</option>
	    </select> 
       <br />
       <label for="name">Separator field 4:</label>
      	<select id="S4" name="S4" style="width: 150px">
        <option value=""></option>
		<option value="SessionStart" > SessionStart</option>   
