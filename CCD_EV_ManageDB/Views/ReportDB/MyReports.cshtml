       <!-- CIO Rx copy report dialog -->
      <script>
          $(function () {
              var dialog, form;

              function addUser() {
                  form.submit();
              }

              dialog = $("#dialog-form-cio-rx").dialog({
                  autoOpen: false,
                  height: 200,
                  width: 350,
                  modal: true
              });


          });

          function ShowCIORXDialog(dialog, id,table) {

              //debugger;
              $("#CIO_RXid").val(id);
              $("#table_" + table).prop('checked', false);
              var td = "#" + dialog;
              $(td).dialog();
              $(td).dialog("option", "width", 350);
              $(td).dialog("option", "length", 200);
              $(td).dialog("option", "modal", true);
              $(td).dialog("open");

          };

          function ValidateCheckAlltabs(formId,buttonId) {
              //debugger;
              var x = document.getElementById(formId);
              var c = document.getElementById(buttonId);
              for (var i = 0; i < x.length; i++) {
                  if (x.elements[i].name.match("table_.*")) {
                      x.elements[i].checked = c.checked;
                  }
              }
          }
  </script>

         <!-- CIO Tx copy report dialog -->
      <script>
