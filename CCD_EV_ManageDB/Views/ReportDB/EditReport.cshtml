           <div id="queryImageInput">
        Slide: Test &nbsp;
        <select id="_FieldsSlides0" name="_FieldsSlides0" class="wmselect" disabled="disabled" onchange="changedTestsSelectImage(this,this.nextSibling.nextSibling,this.nextSibling.nextSibling.nextSibling.nextSibling)">
        @foreach (string _test in Model.Tests)
        {
             <option value="@_test" >@_test</option>
        } 
        </select> 
        Field &nbsp;
        <select id="_FieldsSlides1" name="_FieldsSlides1" class="wmselect" disabled="disabled">
            @foreach (string field in Model.TestsFields[Model.Tests.ElementAt(0)])
            {
                <option value="@field"> @field</option>
            }
        </select> 
        Text &nbsp;
        <input type="text" id="_FieldsSlides2" name="_FieldsSlides2" value="" style="width: 250px;" disabled="disabled"/>

        Template &nbsp; 
        <select id="_FieldsSlides3" name="_FieldsSlides3" disabled="disabled">
        @{
            foreach (string template in Model.Templates)
            {
                if (!template.Contains("image")) { continue; }
               <option value="@template"> @template</option>
            }
        }
        </select> 
        Save report for Edit &nbsp;
        <!-- next lines are empty place holders to have same number of parameters as limits slide-->
        <input type="hidden" id="_FieldsSlides4" name="_FieldsSlides4" value="" />
        <input type="hidden" id="_FieldsSlides5" name="_FieldsSlides5" value="" />
        <input type="hidden" id="_FieldsSlides7" name="_FieldsSlides7" value="" />
        <input type="hidden" id="_FieldsSlides8" name="_FieldsSlides8" value="" />
        <input type="hidden" id="_FieldsSlides6" name="_FieldsSlides6" value="@General.ReportSlideType.image.ToString()" style="width: 100px;"/>

        <input type="button" value="D" title="Delete" class="button" onclick="removeElem(this.parentNode)" />
        <input type="button" value="A" title="Add next slide field" class="button" onclick="fnCloneAdj('queryInput',this.parentNode)"/>
        <input type="button" value="AIm" title="Add next slide image" class="button" onclick="fnCloneAdj('queryImageInput',this.parentNode)"/>
    </div>
    <div id="queryImageEnd"></div>

