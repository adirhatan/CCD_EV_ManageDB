@model CCD_EV_ManageDB.Models.UserTableReport
@using MongoDB.Bson;
@using MongoDB.Driver;
@using MongoDB.Bson.Serialization;
@using System.Collections.Generic;
@using System.Web.UI.WebControls;
@using CCD_EV_ManageDB.Models;
@using System.Web.Script.Serialization;


@{
    ViewBag.Title = "Run partial report";
}

<script type="text/JavaScript">

    
</script>
 <h2>Run partial report</h2>
<p class="messageText">@TempData["message"]</p>
<p class="messageInfoText">@TempData["messageInfo"]</p> 
<br />
<p>Report Name: <b>@Model.Name</b>&nbsp  Report TestName: @Model.TestName</p>
<script src="@Url.Content("~/Scripts/ccdEV.js")" type="text/javascript" ></script>

   @using (Html.BeginForm("RunReportBG", "ReportDB", FormMethod.Post, new { @id = "myForm", @name = "myForm" }))
   {
    @Html.Hidden("_id", Model._id)
    @Html.Hidden("FieldSlidesStr", "")
       //string _id, string desc, string db, string[] debug, string FieldSlidesStr
       string _db = ViewBag.db;
    @Html.Hidden("db", _db)
       string _desc = ViewBag.desc;
    @Html.Hidden("desc", _desc)

    <p> Current query: DB: "@ViewBag.displayDB" Table:"@ViewBag.col" Query: "@ViewBag.Query"</p>
    <input type="button" class="button" value="Run" onclick="PartialReportFormToStr()" />
       <text>&nbsp;&nbsp;  </text>  
    <input type="button" class="button" value="Cancel" onclick="GenLocatioAction('@Url.Action("MyReports", "ReportDB")')" />
    <br />
    <br />
    <table id="fsTables" class="display">
        <thead>
            <tr>
                <th >
                    TestName
                </th>
                <th >
                    Field
                </th>
                <th >
                    @{
                       bool checkAllChecked = true;
                       if (ViewBag.FieldSlidesList.Count > 0) { checkAllChecked = false; }
                       @Html.CheckBox("_checkAll",checkAllChecked, new { @id = "_checkAll", @onclick = "ValidateResCompReportCheckAll()" }) <text>&nbsp;</text>
                    }                                                                                                                    
                </th>
            </tr>
        </thead>
        <tbody>
        @{
    int cnt = 0;
    bool cbChecked = true;
    if ((ViewBag.FieldSlidesList.Count > 0)){ cbChecked = false; }
    foreach (FieldSlide FS in Model.RConfig.FieldsSlides)
    {
        if ((ViewBag.FieldSlidesList != null) && (ViewBag.FieldSlidesList.Count > 0))
        {
            if (ViewBag.FieldSlidesList.Contains(cnt.ToString())) { cbChecked = true; }
            else { cbChecked = false; }
        }
            <tr>
                <td>@FS.test</td>
                <td>@FS.column</td>
                <td>@Html.CheckBox("_cb" + cnt.ToString(), cbChecked)</td>
            </tr>
        cnt++;
    }
        }
    </tbody>
    </table>

   }

