@model MongoDB.Driver.MongoCursor
@using MongoDB.Bson;
@using MongoDB.Driver;
@using MongoDB.Bson.Serialization;
@using System.Collections.Generic;
@using System.Web.UI.WebControls;
@using CCD_EV_ManageDB.Models;
@using System.Text.RegularExpressions;

@{
    ViewBag.Title = "ViewAllMonitorTables";
}

<h2>View All MonitorTables</h2>
 <script src="@Url.Content("~/Scripts/ccdEV.js")" type="text/javascript" ></script>
 <script type="text/JavaScript">
 $(document).ready(function () {
    //debugger;
     $('#mTables').dataTable({
        "iDisplayLength": -1,
          "columns": [
            { "orderable": false },
            { "orderable": true },
            { "orderable": true },
            { "orderable": false }
          ],
        "autoWidth": true,
        "jQueryUI": true,
        "sDom": '<"H"CTrif>t<"F"CTrif>',
        //"dom": 't<"F"CTrif>',
        //"dom": '<"H"CTrif><"toolbar">t',
        "scrollX": "100%",
        //"sScrollY": "700px",
        "scrollY": (0.8 * $(window).height()),
        "scrollCollapse": true
    });
});

</script>
<p class="messageText">@TempData["message"]</p>
<p class="messageInfoText">@TempData["messageInfo"]</p> 

 <table id="mTables" class="display">
    <thead>
    <tr>
        <th >
            Run
        </th>
        <th >
            Creator
        </th>
        <th >
            Name
        </th>
        <th >
            Tables
        </th>
    </tr> 

    </thead>
    <tbody>
    @foreach (BsonDocument item in Model)
    {
        string r_id = item.AsBsonDocument.GetElement("_id").Value.ToString();
        string SaveName = "SaveQName" + r_id;
        UsersMonitorTables UMTab = new UsersMonitorTables();
        UMTab._id = item.GetValue("_id", "").ToString(); ;
        UMTab.Name = item.GetValue("name", "").ToString();
        foreach (BsonDocument doc in item.GetElement("mTables").Value.AsBsonArray)
        {
            UMTab.MTables.Add(new MTable(doc.GetValue("TName", "").ToString(), doc.GetValue("HostName", "").ToString(), doc.GetValue("DBName", "").ToString()));
        }
     <tr>  
        <td>
            <input type="button" value="R" title="Run Monitor Set" class="button" onclick="GenLocatioAction_id('@r_id','@Url.Action("RunMonitorTables", "MonitorDB")')" />
        </td>
        <td>
            @Regex.Replace(UMTab._id,@"\d*","")
        </td>
        <td>
            @UMTab.Name
        </td>
        <td >

            @foreach (MTable mTab in UMTab.MTables)
            {
                <span>&nbsp;@mTab.TName;@mTab.HostName </span>
            }
        </td>
    </tr>
    }
    </tbody>
</table>

