 @using (Html.BeginForm("loadMonitorTables", "MonitorDB", FormMethod.Post, new { @id = "loadForm", @name = "loadForm" }))
 {
 <p>Create new set: 
    <input type="text" id="name" name="name" style="width: 120px" />
    Select table to Monitor: 
    <select id="montNew" name="mont">
        @foreach (var col in ViewBag.collist)
        {
            <option value="@col.ToString()"> @col.ToString()</option>
        }
    </select> 
    Host name(leave empty for unique station):
    <input type="text" id="hostNameNew" name="hostName" style="width: 120px" />
    <input type="submit" value="Submit" />
</p>
 }
 @using (Html.BeginForm("AddExistMonitorTables", "MonitorDB", FormMethod.Post, new { @id = "addExistForm", @name = "addExistForm" }))
 {
<p>Add table to exist set:  
    <select id="_id" name="_id">
    <option value="" selected="selected">Choose:</option>
        @foreach (BsonDocument item in Model)
        {
            string r_id = item.GetElement("_id").Value.ToString();
            string Name = item.GetValue("name", "").ToString();
            <option value="@r_id">@Name</option>
        }
    </select>
    Select table to Monitor:
    <select id="mont" name="mont">
        @foreach (var col in ViewBag.collist)
        {
            <option value="@col.ToString()"> @col.ToString()</option>
        }
    </select> 
    Host name(leave empty for unique station):
    <input type="text" id="hostName" name="hostName" style="width: 120px" />
    <input type="submit" value="Submit" />
</p>
 }
 <table id="mTables" class="display">
    <thead>
    <tr>
        <th >
            Run
        </th>
        <th >
            Del
        </th>
        <th >
            Del Last
        </th>
        <th >
            Name
        </th>
        <th >
            Rename
        </th>
        <th >
            Tables
        </th>
    </tr> 

    </thead>
    <tbody>
    @foreach (BsonDocument item in Model)
    {
        string r_id = item.AsBsonDocument.GetElement("_id").Value.ToString();
        string SaveName = "SaveQName" + r_id;
        UsersMonitorTables UMTab = new UsersMonitorTables();
        UMTab._id = item.GetValue("_id", "").ToString(); ;
        UMTab.Name = item.GetValue("name", "").ToString();
        foreach (BsonDocument doc in item.GetElement("mTables").Value.AsBsonArray)
        {
            UMTab.MTables.Add(new MTable(doc.GetValue("TName", "").ToString(), doc.GetValue("HostName", "").ToString(), doc.GetValue("DBName", "").ToString()));
        }
     <tr>  
        <td>
            <input type="button" value="R" title="Run Monitor Set" class="button" onclick="GenLocatioAction_id('@r_id','@Url.Action("RunMonitorTables", "MonitorDB")')" />
        </td>
        <td>
            <input type="button" value="D" title="Delete Monitor Set" class="button" onclick="GenLocatioAction_id('@r_id','@Url.Action("DeleteMonitorTables", "MonitorDB")')" />
        </td>
        <td>
            <input type="button" value="DL" title="Delete last table defined in Monitor Set" class="button" onclick="GenLocatioAction_id('@r_id','@Url.Action("DeleteLastTable", "MonitorDB")')" />
        </td>
        <td id="@r_id">
        @UMTab.Name
        </td>
        <td>
            <input type="text" id="@SaveName" name="@SaveName" style="width: 120px" />
            <input type="button" value="M" title="Rename Monitor Set" class="button" onclick="GenAjaxRenameElem_id('@SaveName','@r_id','@Url.Action("RenameMonitorTables", "MonitorDB")')" />
        </td>
        <td >

            @foreach (MTable mTab in UMTab.MTables)
            {
                <span>&nbsp;@mTab.TName;@mTab.HostName </span>
            }
        </td>
    </tr>
    }
    </tbody>
</table>

