@model CCD_EV_ManageDB.Models.MonitorData
@using MongoDB.Bson;
@using MongoDB.Driver;
@using System.Collections.Generic;
@using System.Web.UI.WebControls;
@using CCD_EV_ManageDB.Models;

@{
    ViewBag.Title = "AjaxTable";
}

<h2>index</h2>




    <script type="text/JavaScript">
        $(document).ready(function () {
            $('#example').dataTable({
                "ajax": '/MonitorDB/data'
            });
        });
    </script>
    
<table id="example" class="display" cellspacing="0" width="100%">
        <thead>
            <tr>
                <th>Name</th>
                <th>Position</th>
                <th>Office</th>
                <th>Extn.</th>
                <th>Start date</th>
                <th>Salary</th>
            </tr>
        </thead>
 
        <tfoot>
            <tr>
                <th>Name</th>
                <th>Position</th>
                <th>Office</th>
                <th>Extn.</th>
                <th>Start date</th>
                <th>Salary</th>
            </tr>
        </tfoot>
    </table>

