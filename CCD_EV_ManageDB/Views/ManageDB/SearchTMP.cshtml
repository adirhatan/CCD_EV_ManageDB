      <input type="submit" class="button"/>
    </fieldset>
  </form>
</div>
 


<div id="vis-dialog-form" title="Visualise results">
  <p class="validateTips">Define visualization contenet</p>
 
  <form action='@Url.Action("ExportVisualizationFileBG", "ManageDB")' id="VisForm">
    <fieldset>
      <label for="name">Group by:</label>
      	<select id="group" name="group">
				    <option value="" selected="selected"> </option>   
				    <option value="ProjectName"> Project</option>
                    <option value="Phase"> Phase</option>
                    <option value="Skew"> Skew</option>
                    <option value="Corner"> Corner</option> 
                    <option value="Port"> Port</option> 
                    <option value="Lane"> Lane</option> 
                    <option value="Gen"> Gen</option> 
                    <option value="Test Channel"> Channel</option>               
	    </select> 
        <br />
      <label for="name">Results fields:</label>
         <table id="VisFieldsTable" style="border:none">
             <thead>
             <tr>
             <th style="background-color: #e6e6e6;color: #555555">Query fields</th>
             <th style="background-color: #e6e6e6;color: #555555"></th>
             <th style="background-color: #e6e6e6;color: #555555">Selected fields</th>
             <th style="background-color: #e6e6e6;color: #555555"></th>
             </tr>
             </thead>
             <tbody>
                <tr>
                    <td>
 
                        <select id="VisFieldsListTmp" name="VisFieldsListTmp" multiple="multiple" size="12" style="width: 350px;" class="wselect">
                        @{
                            foreach (var field in Model.TableFields)
                            {
                                <option value="@field.ToString()"> @field.ToString()</option>
                            }
                        }
                         </select> 
                    </td>
    

                    <td nowrap>
                        <div class="Button"><div class="Left">&nbsp;</div><div class="Middle"><input type="button" id="vis_add" class="button" onclick="javascript: moveSelected('VisFieldsListTmp', 'VisFieldsList', false,'Visualization');" value="Add"/></div><div class="Right">&nbsp;</div></div>
                        <div class="Button">
                            <div class="Left">&nbsp;</div>
                            <div class="Middle"><input type="button" id="vis_addAll" class="button" value="Add All" onclick="javascript: moveSelected('VisFieldsListTmp', 'VisFieldsList', true,'Visualization');"/></div>
                            <div class="Right">&nbsp;</div>
                        </div>
                    </td>

                    <td>
                    <select name="VisFieldsList" multiple="multiple" size="12" style="width: 350px;" class="InputField" id="VisFieldsList"></select>
                    <input type="hidden" name="visFields" value=""/>
                    <input type="hidden" name="load" value="yes"/>
                    </td>

                    <td nowrap>
                        <div class="Button"><div class="Left">&nbsp;</div><div class="Middle"><input type="button" id="vis_rem" class="button" onclick="javascript: moveSelected('VisFieldsList', null, false,'Visualization');" value="Remove"/></div><div class="Right">&nbsp;</div></div>
                        <div class="Button"><div class="Left">&nbsp;</div><div class="Middle"><input type="button" id="vis_remAll" class="button" onclick="javascript: moveSelected('VisFieldsList', null, true,'Visualization');" value="Remove All"/></div><div class="Right">&nbsp;</div></div>
                    </td>
                </tr>
            </tbody>
        </table>
      <br />
      <input type="submit" class="button"/>
    </fieldset>
  </form>
</div>


