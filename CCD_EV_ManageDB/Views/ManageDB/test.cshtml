function getWeather() {

    var URL = "/ManageDB/FirstAjax/";
    var posting = $.post(URL, { Location: $('#Location').val(), name: $('#name').val() });


    posting.done(function (data) {
        //alert('success');
        $("#Result").html(data);
    });
}

</script>


