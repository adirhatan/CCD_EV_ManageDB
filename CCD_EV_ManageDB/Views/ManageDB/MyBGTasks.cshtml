@model MongoDB.Driver.MongoCursor
@using MongoDB.Bson;
@using MongoDB.Driver;
@using MongoDB.Bson.Serialization;
@using System.Collections.Generic;
@using System.Web.UI.WebControls;
@using CCD_EV_ManageDB.Models;

@{
    ViewBag.Title = "MyBGTasks";
}

<h2>My background tasks</h2>
 <script src="@Url.Content("~/Scripts/ccdEV.js")" type="text/javascript" ></script>
  <script type="text/JavaScript">
      $(document).ready(function () {
          //debugger;
          $('#bgtasks').dataTable({
              "iDisplayLength": -1,
              "columns": [
            { "orderable": false },
            { "orderable": false },
            { "orderable": false },
            { "orderable": false }
          ],
              "autoWidth": true,
              "jQueryUI": true,
              //        //"sDom": '<"H"CTrf>t<"F"lip>',
              "dom": '<"H"CTrf>t<"F"CTrif>',
              "scrollX": "100%",
              //"sScrollY": "700px",
              "scrollY": (0.8 * $(window).height()),
              "scrollCollapse": true
          });
      });

</script>
    <script type="text/JavaScript">
        $(document).ready(function () {
            var refreshNeeded = false;
            $("td[id^='status']").each(function (index) {
                if ($(this).text().trim() == "In progress") refreshNeeded = true;
                if ($(this).text().trim() == "Launched") refreshNeeded = true;
            });
            if (refreshNeeded) {
                setInterval(function () {
                    window.location.reload();
                }, 10000);
                var line = new ProgressBar.Line('#line-container', {
                    color: '#F6855E', duration: 10000

                });

                line.animate(1);
            }
        });


</script>
<div id="line-container"></div>

     @{ var ExportedFile = TempData["ExportedFileNAme"];
        if (ExportedFile != null)
        {
             <script type="text/JavaScript">
                 $(document).ready(function () {
                     var url = '@Url.Action("ViewExportBGFile", "ManageDB", new { filename = TempData["ExportedFileNAme"] })';
                     $(location).attr('href', url);
                 });
             </script>
        }
     }
<p class="messageText">@TempData["message"]</p>
<p class="messageInfoText">@TempData["messageInfo"]</p> 

 @using (Html.BeginForm("DeleteBGTasks", "ManageDB", FormMethod.Post, new { @id = "myForm", @name = "myForm" }))
 {
<p>
    @Html.CheckBox("_checkAll", false, new { @id = "_checkAll", @onclick = "ValidateResCompReportCheckAll()" }) <text>&nbsp;</text>
    <input type="submit"class="button" value="Delete checked items" onclick = "return confirm('Are you sure you want to delete checked items?')"/>
</p>
 <table id="bgtasks" class="display">
    <thead>
    <tr>
        <th >
            Delete
        </th>
        <th >
            Desc
        </th>
         <th >
            Status
        </th>
        <th >
            Result
        </th>
    </tr> 

    </thead>
    <tbody>
    @foreach (BsonDocument item in Model)
    {
        string r_id = item.GetElement("_id").Value.ToString();
        string c_id = "_cb" + r_id;
        string statusID = "status" + r_id;
     <tr>  
        <td>
            <input id="@c_id" name="@c_id" type="checkbox" />
            <input type="button" value="D" title="Delete record" class="button" onclick="GenLocatioAction_id('@r_id','@Url.Action("DeleteBGTAsk", "ManageDB")')" />
        </td>
        <td>
        @item.GetElement("desc").Value.ToString()
        </td>
        <td id="@statusID">
        @item.GetElement("status").Value.ToString()
        </td>
        <td>
        @if ((item.GetElement("desc").Value.ToString().Substring(0, 10) == "ccd_export") 
            || (item.GetElement("desc").Value.ToString().Substring(0, 10) == "CompReport")
            || (item.GetElement("desc").Value.ToString().Substring(0, 10) =="Indicators")
            || (item.GetElement("desc").Value.ToString().Substring(0, 11) == "cycleStatus"))
        {
            if (String.IsNullOrWhiteSpace(item.GetElement("result2").Value.ToString()))
            {
                <a class="bgMessage" href="@Url.Action("ViewExportBGFile", "ManageDB", new { filename = item.GetElement("result").Value.ToString() })">@Path.GetFileName(item.GetElement("result").Value.ToString())</a>
            }
            else
            {
                <p class="bgMessage">@item.GetElement("result2").Value.ToString()</p>
            }
        }
        @if ((item.GetElement("desc").Value.ToString().Substring(0, 6) == "report") 
            || ((item.GetElement("desc").Value.ToString().Length>9) && (item.GetElement("desc").Value.ToString().Substring(0, 10) == "Check Spec"))
            || ((item.GetElement("desc").Value.ToString().Length>9) && (item.GetElement("desc").Value.ToString().Substring(0, 8) == "Load_LAN")))
        {
            @item.GetElement("result").Value.ToString()
            if (item.GetValue("result2","").ToString() != "")
            {
                <a class="bgMessage" href="@Url.Action("ViewExportBGFile", "ManageDB", new { filename = item.GetElement("result2").Value.ToString() })">pdf</a>
            }
            if (item.GetValue("result3", "").ToString() != "")
            {
                <a class="bgMessage" href="@Url.Action("ViewExportBGFile", "ManageDB", new { filename = item.GetElement("result3").Value.ToString() })">ppt</a>
            }
            if (item.GetValue("result4", "").ToString() != "")
            {
                <a class="bgMessage" href="@Url.Action("ViewExportBGFile", "ManageDB", new { filename = item.GetElement("result4").Value.ToString() })">margins</a>
            }
        }
        
        @if (item.GetElement("desc").Value.ToString().Substring(0, 10) == "ccd_visual")
        {
            <a class="bgMessage" href="@Url.Action("ViewExportBGFile", "ManageDB", new { filename = item.GetElement("result").Value.ToString() })">@Path.GetFileName(item.GetElement("result").Value.ToString())</a>
            <!--<a class="bgMessage" href=@Url.Content("/Visualization/parallel2.html?file="+item.GetElement("result").Value.ToString())>Visualise</a>-->
            if (!string.IsNullOrEmpty(item.GetElement("result").Value.ToString()))
            {
                <a class="bgMessage" href="http://mbev-visualization-int.iil.intel.com/" target="_blank">Visualization site</a>
            }
        }
        
        </td>
    </tr>
    }
    </tbody>
</table>
 }

