@model CCD_EV_ManageDB.Models.DBsearch
@using System.Collections.Generic;
@using System.Web.UI.WebControls;
@using CCD_EV_ManageDB.Models;
@using CCD_EV_ManageDB.Repositories;
@using MongoDB.Bson;
@{
    ViewBag.Title = "Boards Inventory";
}

<h2>Boards Inventory</h2>

 <script src="@Url.Content("~/Scripts/ccdEV.js")" type="text/javascript" ></script>
 <script type="text/JavaScript">
     $(document).ready(function () {
         //debugger;
         $('#rTables').dataTable({
             "iDisplayLength": -1,
             "columns": [
            { "orderable": false },
            { "orderable": false },
            { "orderable": true },
            { "orderable": true },
            { "orderable": true },
            { "orderable": true },
            { "orderable": true },
            { "orderable": true },
            { "orderable": true },
            { "orderable": true },
            { "orderable": true },
            { "orderable": true },
            { "orderable": true },
            { "orderable": true },
            { "orderable": true },
            { "orderable": true },
            { "orderable": true }

          ],
             "autoWidth": true,
             "jQueryUI": true,
             //        //"sDom": '<"H"CTrf>t<"F"lip>',
             "dom": '<"H"CTrif>t<"F"CTrif>',
             "scrollX": "100%",
             //"sScrollY": "700px",
             "scrollY": (0.8 * $(window).height()),
             "scrollCollapse": true
         });
     });

     $(function () {
     //         $("#dialog").dialog();
         $("#dialog").dialog();
         if ($("#dialog").dialog("isOpen")) $("#dialog").dialog("close");
     });
     </script>

    <p class="messageText">@TempData["message"]</p>
    <p class="messageInfoText">@TempData["messageInfo"]</p> 

  <p>Add new Board:
     <input type="button" value="New" class="button" title="Add new calibration" onclick="GenLocatioAction('@Url.Action("EditBoardLine", "ManageDB")')" />
  </p>
  <br />
     
    @using (Html.BeginForm("BoardsLines", "ManageDB", FormMethod.Post, new { @id = "myForm", @name = "myForm" }))
    {
    <!--Enter DB Query --> @Html.Hidden("Query", Model.Query)
    <!--Enter DB OP --> @Html.Hidden("SearchOP", Model.SearchOP)  
    <!--Enter DB Fields --> @Html.Hidden("FieldsStr", Model.FieldsStr)
    <!--Enter DB Sort --> //@Html.Hidden("SortStr", Model.SortStr)@Html.Hidden("SortDirection", Model.SortDirection)
        foreach (var triplet in Model.QueryTriplets)
        {
            string[] tarr = triplet.ToString().Split(new Char[] { ';' });
    <div id="queryInput">
        <p>Enter DB Query :
        <select id="_Query0" name="_Query0">
        @foreach (var op in ViewBag.q0list)
        {
            if (op.ToString() == tarr[0])
            {
                <option value="@op.ToString()" selected="selected" >@op.ToString()</option>
            }
            else
            {
                <option value="@op.ToString()">@op.ToString()</option>
            }
        } 
        </select> 
        <select id="_Query1" name="_Query1">
        @{
        foreach (var field in Model.TableFields)
        {
            if (field.ToString() == tarr[1])
            {
                <option value="@field.ToString()" selected="selected"> @field.ToString()</option>   
            }
            else
            {
                <option value="@field.ToString()"> @field.ToString()</option>
            }
        }
        }
        </select> 
        @Html.TextBox("_Query2", tarr[2], new { @id = "_Query2" })
        <input type="button" value="Remove" class="button" onclick="removeElem(this.parentNode)" /></p>
    </div>
        }
    <div id="queryEnd"></div>
    <input type="button" value="add query" class="button" onclick="fnClone('queryInput','queryEnd')"/>
    <input type="button" value="Clear query" class="button" title="Reload table with empty query" onclick="GenLocatioAction('@Url.Action("BoardsLinesClear", "ManageDB")')" />
               <p>Sort Field: 
    <select id="SortStr" name="SortStr">
        @{
        foreach (var field in Model.TableFields)
        {
            if (field.ToString() == Model.SortStr)
            {
                <option value="@field.ToString()" selected="selected"> @field.ToString()</option>   
            }
            else
            {
                <option value="@field.ToString()"> @field.ToString()</option>
            }
        }
        }
    </select>
    <select id="SortDirection" name="SortDirection">
        @{
        if (Model.SortDirection == "ASC")
        {
            <option value="ASC" selected="selected">ASC</option>
            <option value="DES">DES</option>   
        }
        else
        {
            <option value="ASC" selected="selected">ASC</option>
            <option value="DES" selected="selected">DES</option>  
        }
        }
    </select>
    <!-- Query logic operator: AND @Html.RadioButton("SearchOP", "AND", (Model.SearchOP == "AND")) OR @Html.RadioButton("SearchOP", "OR", (Model.SearchOP == "OR")) -->
    &nbsp;
    <input type="submit" value="Submit query" onclick="FormToStr()" />
	
    </p>
    }


  <table id="rTables" class="display">
    <thead>
    <tr>
        <th >
            Edit
        </th>
        <th >
            Del
        </th>
        <th >
            Name
        </th>
        <th >
            Project
        </th>
        <th >
            Phase
        </th>
        <th >
            UnitId
        </th>
        <th >
            Skew
        </th>
        <th >
            Sigma
        </th>
        <th >
            Fuse
        </th>
        <th >
            Interface
        </th>

        <th >
            Last Comment
        </th>
        <th >
            Comment by
        </th>
        <th >
            Date    
        </th>
        <th >
            Last Execution
        </th>
        <th >
             L. Exec User
        </th>
        <th >
             Valid
        </th>
        <th >
             InUse
        </th>
    </tr> 

    </thead>
    <tbody>
    @foreach (BsonDocument doc in Model.ResCursor)
    {
        Board line = new Board(doc);
        string SaveName = "SaveName" + line.id;
        string styleStr = "";
        if (line.Valid!="Y")
        {
            styleStr = "background-color:Red;color:White";
        }
        if ((line.Valid=="Y") && (line.InUse=="Y"))
        {
            styleStr = "background-color:Yellow";
        }

     <tr style="@styleStr">
        <td>
        @{using (Html.BeginForm("EditBoardLine", "ManageDB", FormMethod.Get, new { @id = "eForm", @name = "eForm" }))
              {
                <input type="submit" value="E" title="Edit line" class="button" />
                <input type="hidden" id="_id" name="_id" value="@line.id" />
              }
        }
        </td>  
        <td>
        @{using (Html.BeginForm("DeleteLine", "CalibrateDB", FormMethod.Get, new { @id = "dForm", @name = "dForm" }))
              {
                <input type="button" value="D" title="Delete line" class="button" onclick="GenLocatioAction_id_ConfirmAction('@line.id','@Url.Action("DeleteBoardLine", "ManageDB")','Are you sure you want to delete board @line.Name?')" />
              }
        }
        </td>  
        <td>
        @line.Name
        </td>

        <td>
        @line.Project
        </td>
        <td >
             @line.Phase
        </td>
        <td >
             @line.UnitId
        </td>
        <td >
             @line.Skew
        </td>
        <td >
             @line.Sigma
        </td>
        <td >
             @line.Fuse
        </td>
        <td >
             @line.Interface
        </td>
        <td >
             @line.LastCommentText
        </td>
        <td >
             @line.LastCommentUser
        </td>
        <td >
             @line.LastCommentDate
        </td>
        <td >
            @if (line.LastExecution != null)
            {
                @line.LastExecution.GetValue("_id", "").ToString();
            }
            else
            {
                @line.LastExecution.GetValue("KUKU", "None").ToString();
            }
        </td>
        <td >
            @if (line.LastExecution != null)
            {
                @line.LastExecution.GetValue("OPName", "").ToString();
            }
        </td>
        <td >
             @line.Valid
        </td>
        <td >
             @line.InUse
        </td>
    </tr>
    }
    </tbody>
</table>

<div id="dialog" title="Tests Summary">
  <p>Now querying DB for tests summary, please wait</p><div>id="dots"...</div>
</div>
