@model CCD_EV_ManageDB.Models.DBsearch
@using MongoDB.Bson;
@using MongoDB.Driver;
@using System.Collections.Generic;
@using System.Web.UI.WebControls;
@using CCD_EV_ManageDB.Models;

@{
    ViewBag.Title = "Search";
}

<h2>Search</h2>
  <script type="text/javascript">
      function sortField(field,direction) {
          var x = document.getElementById("myForm");
          var txt = "@Model.Query";
          x.elements.namedItem("Query").value = txt;
          x.elements.namedItem("SortStr").value = field;
          x.elements.namedItem("SortDirection").value = direction;
          x.submit();
      }
      $(document).ready(function() {
          $('#table_id').dataTable({
              "iDisplayLength": -1,
              "bPaginate": true,
              "iCookieDuration": 60,
              "bStateSave": false,
              "bAutoWidth": false,
              "bScrollAutoCss": true,
              "bProcessing": true,
              "bRetrieve": true,
              //"bJQueryUI": true,
              "sDom": '<"H"CTrf>t<"F"lip>',
              "aLengthMenu": [[10, 20, 100, -1], [10, 20, 100, "All"]],
              "sScrollX": "100%",
              //"sScrollY": "500px",
              "sScrollY": (0.6 * $(window).height()),
              //"bScrollCollapse": true,
              "fnInitComplete": function () {
                  this.css("visibility", "visible");
              }
        } );
      });   
  </script>

<table id="table_id" class="display">
    <thead>
    <tr>
        <th >
            Select
        </th>
     @foreach (var field in Model.Fields)
     {
        <th >
        @{  
             if ((field.ToString() == Model.SortStr) && (Model.SortDirection == "DES"))
             {   
                <a onclick="sortField('@field.ToString()','ASC')">@field.ToString()</a> 
                <img src=@Url.Content("~/content/Images/sort_up.gif") alt="Sort up" onclick="sortField('@field.ToString()','ASC')"/>
             }
             else
             {
                <a onclick="sortField('@field.ToString()','DES')">@field.ToString()</a>
            <img src=@Url.Content("~/content/Images/sort_down.gif") alt="Sort down" onclick="sortField('@field.ToString()','DES')"/>
             }

         }                                                                                
        </th>
     }
    </tr> 
    </thead>
    <tbody>
    @foreach (BsonDocument item in Model.ResCursor)
    {
        string r_id = item.AsBsonDocument.GetElement("_id").ToString();
    <tr>  
        <td>
            <div id="@r_id markLine">
        
            <input id="@r_id" name="@r_id" type="checkbox" />
            </div>
        </td>
        @foreach (var field in Model.Fields)
        {
        <td >
            @{ 
            if ((field.ToString().Length > 3) && (field.ToString().Substring(0, 4) == "FILE") && (@item.GetValue(field.ToString(), "") != ""))
            {
                string fname = item.GetValue(field.ToString()).ToString();
                    <a href="file:////@item.GetValue(field.ToString(), "")">@System.Text.RegularExpressions.Regex.Replace(fname, ".*\\\\", "")</a>
            }
            else
            {
                @item.GetValue(field.ToString(), "");
            }
            }
        </td>
        }
    </tr>
    }
    </tbody>
</table>

