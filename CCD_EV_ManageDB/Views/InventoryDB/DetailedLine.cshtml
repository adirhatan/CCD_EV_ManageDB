@model Inventory
@using System.Collections.Generic;
@using System.Web.UI.WebControls;
@using CCD_EV_ManageDB.Models;
@using CCD_EV_ManageDB.Repositories;

@{
    ViewBag.Title = "Detailed CompReports line";
}

<h2>Edit Inventory line</h2>

 <script src="@Url.Content("~/Scripts/ccdEV.js")" type="text/javascript" ></script>
  <script type="text/JavaScript">

      $(function () {
          $("#dialog").dialog();
          if ($("#dialog").dialog("isOpen")) $("#dialog").dialog("close");
      });
     </script>

<p class="messageText">@TempData["message"]</p>
<p class="messageInfoText">@TempData["messageInfo"]</p> 

 <p><!--string _id, string lplatform, string lUnitsNumber, string lReceptionDate, string lBIOS, string lNMV, string lLastUpdateDate, string lFinishDate-->
     Platform Name:
    <input type="text" id="lplatform" name="lplatform" value="@Model.platform" disabled="disabled" style="width: 200px" />
     Vendor:
    <input type="text" id="lVendor" name="lVendor" value="@Model.Vendor" disabled="disabled" style="width: 100px" />
     # Units:
    <input type="text" id="lUnitsNumber" name="lUnitsNumber" value="@Model.UnitsNumber" disabled="disabled" style="width: 20px" />
    Reception Date(YYYYMMDD):
    <input type="text" id="lReceptionDate" name="lReceptionDate" value="@Model.ReceptionDate" disabled="disabled" style="width: 70px" />
    BIOS:
    <input type="text" id="lBIOS" name="lBIOS" value="@Model.BIOS" disabled="disabled" style="width: 60px" />
    NVM:
    <input type="text" id="lNMV" name="lNMV" value="@Model.NVM" disabled="disabled" style="width: 60px" />
    Project:
    <input type="text" id="lproject" name="lproject" value="@Model.project" disabled="disabled" style="width: 60px" />
    <br /><br />
    HDMI Support:
    @if(Model.HDMISupport)
    {
    <input type="checkbox" value="Y" name="HDMISupport" checked="checked" disabled="disabled" />
    }else
    {
    <input type="checkbox" value="Y" name="HDMISupport" disabled="disabled" />  
    }
    Preset 10G 0:
    <input type="text" id="lPreset10G0" name="lPreset10G0" value="@Model.Preset10G0" disabled="disabled" style="width: 15px" />
    1:
    <input type="text" id="lPreset10G1" name="lPreset10G1" value="@Model.Preset10G1" disabled="disabled" style="width: 15px" />
    2:
    <input type="text" id="lPreset10G2" name="lPreset10G2" value="@Model.Preset10G2" disabled="disabled" style="width: 15px" />
    3:
    <input type="text" id="lPreset10G3" name="lPreset10G3" value="@Model.Preset10G3" disabled="disabled" style="width: 15px" />
    Preset 10GAMA 0:
    <input type="text" id="lPreset10GAMA0" name="lPreset10GAMA0" value="@Model.Preset10GAMA0" disabled="disabled" style="width: 15px" />
    1:
    <input type="text" id="lPreset10GAMA1" name="lPreset10GAMA1" value="@Model.Preset10GAMA1" disabled="disabled" style="width: 15px" />
    2:
    <input type="text" id="lPreset10GAMA2" name="lPreset10GAMA2" value="@Model.Preset10GAMA2" disabled="disabled" style="width: 15px" />
    3:
    <input type="text" id="lPreset10GAMA3" name="lPreset10GAMA3" value="@Model.Preset10GAMA3" disabled="disabled" style="width: 15px" />
    Preset 20G 0:
    <input type="text" id="lPreset20G0" name="lPreset20G0" value="@Model.Preset20G0" disabled="disabled" style="width: 15px" />
    1:
    <input type="text" id="lPreset20G1" name="lPreset20G1" value="@Model.Preset20G1" disabled="disabled" style="width: 15px" />
    2:
    <input type="text" id="lPreset20G2" name="lPreset20G2" value="@Model.Preset20G2" disabled="disabled" style="width: 15px" />
    3:
    <input type="text" id="lPreset20G3" name="lPreset20G3" value="@Model.Preset20G3" disabled="disabled" style="width: 15px" />
    USB2 Amp:
    <input type="text" id="lUSB2Amp" name="lUSB2Amp" value="@Model.USB2Amp" disabled="disabled" style="width: 30px" />
    <br /><br />
    Last Update:
    <input type="text" id="lLastUpdateDate" name="lLastUpdateDate" value="@Model.LastUpdateDate" disabled="disabled" style="width: 70px" />
    Finish Date(YYYYMMDD):
    <input type="text" id="lFinishDate" name="lFinishDate" value="@Model.FinishDate" disabled="disabled" style="width: 70px" />
    1P/2P:
    <input type="text" id="lPorts" name="lPorts" value="@Model.Ports" disabled="disabled" style="width: 20px" />
    Host/Device:
    <input type="text" id="lDevType" name="lDevType" value="@Model.DevType" disabled="disabled" style="width: 50px" />
 <br /><br />
    <input type="button" value="Back" title="Cancel" class="button" onclick="GenLocatioAction('@Url.Action("InventoryLinesClear", "InventoryDB")')" />
</p>

 <br />

 @{if (Model.SavedItems.Count > 0)
   {
    <p>History:</p>
   }
 }
 @{foreach (InvSaved savedItems in Model.SavedItems)
   {
       <p>
        BIOS:
        <input type="text" id="sBIOS" name="sBIOS" value="@savedItems.BIOS" disabled="disabled" style="width: 60px" />
        NVM:
        <input type="text" id="sNMV" name="sNMV" value="@savedItems.NVM" disabled="disabled" style="width: 60px" />
        Last Update:
        <input type="text" id="sUpdateDate" name="sLastUpdateDate" value="@savedItems.UpdateDate" disabled="disabled" style="width: 70px" />
        Tests Summary:
        <input type="button" value="S" title="Summary for NVM @savedItems.NVM" class="button" onclick="AjaxShowCompSummary('dialog','@Model.platform','@savedItems.NVM','0','@Url.Action("SummaryLine", "InventoryDB")')" />
        </p>
     
    }
  }

   @{if (Model.PFinishDates.Count > 0)
     {
    <p>Previous Finish Dates:</p>
     }
 
   foreach (string pFinishDate in Model.PFinishDates)
   {
       <p>
        Finish Date:
        <input type="text" id="pFinishDate" name="pFinishDate" value="@pFinishDate" disabled="disabled" style="width: 60px" />
        </p>
   }
 }
  <div id="dialog" title="Tests Summary">
    <p>Now querying DB for tests summary, please wait...</p>
  </div>

