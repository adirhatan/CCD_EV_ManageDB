@model CCD_EV_ManageDB.Models.DBsearch
@using System.Collections.Generic;
@using System.Web.UI.WebControls;
@using CCD_EV_ManageDB.Models;
@using CCD_EV_ManageDB.Repositories;
@using MongoDB.Bson;
@{
    ViewBag.Title = "Inventory Lines";
}

<h2>Inventory Archived Lines</h2>

 <script src="@Url.Content("~/Scripts/ccdEV.js")" type="text/javascript" ></script>
 <script type="text/JavaScript">
     $(document).ready(function () {
         //debugger;
         $('#rTables').dataTable({
             "iDisplayLength": -1,
             "columns": [
            { "orderable": false },
            { "orderable": false },
            { "orderable": true },
            { "orderable": true },
            { "orderable": true },
            { "orderable": true },
            { "orderable": true },
            { "orderable": true },
            { "orderable": true },
            { "orderable": true },
            { "orderable": true },
            { "orderable": true }
          ],
             "autoWidth": true,
             "jQueryUI": true,
             //        //"sDom": '<"H"CTrf>t<"F"lip>',
             "dom": '<"H"CTrif>t<"F"CTrif>',
             "scrollX": "100%",
             //"sScrollY": "700px",
             "scrollY": (0.8 * $(window).height()),
             "scrollCollapse": true
         });
     });

     $(function () {
     //         $("#dialog").dialog();
         $("#dialog").dialog();
         if ($("#dialog").dialog("isOpen")) $("#dialog").dialog("close");
     });
     </script>

    <p class="messageText">@TempData["message"]</p>
    <p class="messageInfoText">@TempData["messageInfo"]</p> 

    
    @using (Html.BeginForm("InventoryLines", "InventoryDB", FormMethod.Post, new { @id = "myForm", @name = "myForm" }))
    {
    <!--Enter DB Query --> @Html.Hidden("Query", Model.Query)
    <!--Enter DB OP --> @Html.Hidden("SearchOP", Model.SearchOP)  
    <!--Enter DB Fields --> @Html.Hidden("FieldsStr", Model.FieldsStr)
    <!--Enter DB Sort --> //@Html.Hidden("SortStr", Model.SortStr)@Html.Hidden("SortDirection", Model.SortDirection)
        foreach (var triplet in Model.QueryTriplets)
        {
            string[] tarr = triplet.ToString().Split(new Char[] { ';' });
    <div id="queryInput">
        <p>Enter DB Query :
        <select id="_Query0" name="_Query0">
        @foreach (var op in ViewBag.q0list)
        {
            if (op.ToString() == tarr[0])
            {
                <option value="@op.ToString()" selected="selected" >@op.ToString()</option>
            }
            else
            {
                <option value="@op.ToString()">@op.ToString()</option>
            }
        } 
        </select> 
        <select id="_Query1" name="_Query1">
        @{
        foreach (var field in Model.TableFields)
        {
            if (field.ToString() == tarr[1])
            {
                <option value="@field.ToString()" selected="selected"> @field.ToString()</option>   
            }
            else
            {
                <option value="@field.ToString()"> @field.ToString()</option>
            }
        }
        }
        </select> 
        @Html.TextBox("_Query2", tarr[2], new { @id = "_Query2" })
        <input type="hidden" name="arcdb" value="true" />
        <input type="button" value="Remove" class="button" onclick="removeElem(this.parentNode)" /></p>
    </div>
        }
    <div id="queryEnd"></div>
    <input type="button" value="add query" class="button" onclick="fnClone('queryInput','queryEnd')"/>
    <input type="button" value="Clear query" class="button" title="Reload table with empty query" onclick="GenLocatioAction('@Url.Action("InventoryLinesClear", "InventoryDB",new RouteValueDictionary(new { arcdb = "true" }) )')" />
               <p>Sort Field: 
    <select id="SortStr" name="SortStr">
        @{
        foreach (var field in Model.TableFields)
        {
            if (field.ToString() == Model.SortStr)
            {
                <option value="@field.ToString()" selected="selected"> @field.ToString()</option>   
            }
            else
            {
                <option value="@field.ToString()"> @field.ToString()</option>
            }
        }
        }
    </select>
    <select id="SortDirection" name="SortDirection">
        @{
        if (Model.SortDirection == "ASC")
        {
            <option value="ASC" selected="selected">ASC</option>
            <option value="DES">DES</option>   
        }
        else
        {
            <option value="ASC" selected="selected">ASC</option>
            <option value="DES" selected="selected">DES</option>  
        }
        }
    </select>
    <!-- Query logic operator: AND @Html.RadioButton("SearchOP", "AND", (Model.SearchOP == "AND")) OR @Html.RadioButton("SearchOP", "OR", (Model.SearchOP == "OR")) -->
    &nbsp;
    <input type="submit" value="Submit query" onclick="FormToStr()" />
	
    </p>
    }


  <table id="rTables" class="display">
    <thead>
    <tr>
        <th >
            View
        </th>
        <th >
            Summary
        </th>
        <th >
            Vendor
        </th>
        <th >
            Platform
        </th>
        <th >
            Project
        </th>
        <th >
            1P/2P
        </th>
        <th >
            # Units
        </th>
        <th >
            Reception Date
        </th>
        <th >
            BIOS
        </th>
        <th >
            NVM
        </th>
        <th >
            Last Update Date
        </th>
        <th >
            Finish Date
        </th>
    </tr> 

    </thead>
    <tbody>
    @foreach (BsonDocument doc in Model.ResCursor)
    {
        Inventory line = doc.BsonDocumentToInventory();
        string SaveName = "SaveName" + line.platform;
     <tr>
        <td>
        @{using (Html.BeginForm("DetailedArchLine", "InventoryDB", FormMethod.Post, new { @id = "eForm", @name = "eForm" }))
          {
                <input type="submit" value="V" title="View detailed line" class="button" />
                <input type="hidden" id="_id" name="_id" value="@line.platform" />
              }
        }
        </td>  
        <td>
            <input type="button" value="SL" title="Sumary latest NVM version @line.NVM" class="button" onclick="AjaxShowCompSummary('dialog','@line.platform','@line.NVM','1','@Url.Action("SummaryLine", "InventoryDB")')" />
            <input type="button" value="SA" title="Sumary all NVM versions" class="button" onclick="AjaxShowCompSummary('dialog','@line.platform','All','1','@Url.Action("SummaryLine", "InventoryDB")')" />
        </td>
        <td>
        @line.Vendor
        </td>
        <td id="@line.platform">
        @line.platform
        </td>
        <td>
        @line.project
        </td>
        <td >
             @line.Ports
        </td>
        <td >
             @line.UnitsNumber
        </td>
        <td >
             @line.ReceptionDate
        </td>
        <td >
             @line.BIOS
        </td>
        <td >
             @line.NVM
        </td>
        <td >
             @line.LastUpdateDate
        </td>
        <td >
             @line.FinishDate
        </td>
    </tr>
    }
    </tbody>
</table>

