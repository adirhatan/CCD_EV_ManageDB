            {
                <input  type="image" title="Order DivLine down" src="@Url.Content("~/content/Images/arrowvb.png")" onclick="SubmitOrder('@OrderForm','down')"/>
            }
            if (TDLcnt > 1)
            {
                <span>&nbsp;</span> <input  type="image" title="Order DivLine up"src="@Url.Content("~/content/Images/arrowvt.png")" onclick="SubmitOrder('@OrderForm','up')"/>
            }

        }
        </td> 
        <td>
        @using (Html.BeginForm("CSR_Table_Div_Order", "CyclePlanDB", FormMethod.Post, new { @id = DivOrderForm, @name = DivOrderForm }))
