                    {
                        reportsIdsStr += reportId + ",";
                        reportsNamesStr += MDBReport.ReadUserTableReport(reportId).Name + ",";
                    }
                    reportsIdsStr = reportsIdsStr.TrimEnd(',');
                    reportsNamesStr = reportsNamesStr.TrimEnd(',');
                        <input type="hidden" name="proj" value="@ViewBag.proj"  />
                        <input type="hidden" name="phase" value="@ViewBag.phase"  />
                        <input type="hidden" name="protocol" value="@ViewBag.protocol"  />
