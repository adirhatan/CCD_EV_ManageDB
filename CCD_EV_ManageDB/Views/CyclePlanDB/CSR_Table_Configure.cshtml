 <script type="text/JavaScript">

     function changedDivNameSelect(selectDivName, newTableDiv, DivLinePosId, add_col) {
         debugger;
         var newTableDiv = document.getElementById(newTableDiv);
         if (selectDivName.value == "new") {
             newTableDiv.style.visibility = 'visible'
         } else {
             newTableDiv.style.visibility = 'hidden'
         }

         ///////
         var selectDivLinePos = document.getElementById(DivLinePosId);
         var output = [];
         var length = ngon.dictionaryDivLines[selectDivName.value].length;
         for (var i = 0; i < length; i++) {
             output[i] = '<option value="' + ngon.dictionaryDivLines[selectDivName.value][i] + '">' + ngon.dictionaryDivLines[selectDivName.value][i] + '</option>';
             if (selectDivLinePos.value === ngon.dictionaryDivLines[selectDivName.value][i]) {
                 output[i] = '<option value="' + ngon.dictionaryDivLines[selectDivName.value][i] + '"' + ' selected="selected">' + ngon.dictionaryDivLines[selectDivName.value][i] + '</option>';
             }
         }

         selectDivLinePos.innerHTML = output.join('');
         /////////
         var add_col = document.getElementById(add_col);
         add_col.value = ngon.dictionaryTablesOfDivs[selectDivName.value];
     }
     function resetColVal(add_col) {
         var add_col = document.getElementById(add_col);
         add_col.value = "";
