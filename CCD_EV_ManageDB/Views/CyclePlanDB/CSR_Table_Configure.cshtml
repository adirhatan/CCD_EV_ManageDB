}

function SubmitOrder(OrderFormId, direction) {
        //debugger;
        var x = document.getElementById(OrderFormId);
        for (var i = 0; i < x.length; i++) {
            if (x.elements[i].name.match("direction")) {
                x.elements[i].value = direction;
            }
        }
        x.submit();
    }

    function submitCSR_Table_Div_Report(formName, reportIDsStr_id) {
        //debugger;
        var x = document.getElementById(formName);
        //do some validation for example:
        var reportIDs = "";
        for (var i = 0; i < x.length; i++) {
            if (x.elements[i].name.match("SelectreportIDs.*")) {
                reportIDs += x.elements[i].value + ",";
            }
        }
        if (reportIDs.length > 0) {
            reportIDs = reportIDs.substr(0, reportIDs.length - 1);
        }
        document.getElementById(reportIDsStr_id).value = reportIDs;

        x.submit();
    }

    function AjaxUpdateExcelPorts(elem, action,  protocol,  proj,  phase) {

        //debugger;
        var URL = action;
        var elemId = "#" + elem;
        var _excelPorts = $(elemId).val();
        var posting = $.post(URL, { protocol: protocol, proj: proj, phase: phase, excelPorts: _excelPorts });

        posting.done(function (data) {
            if (data.includes('fail'))
            {
                $("#messageText").html(data);
            }
            else
            {
                $("#messageInfoText").html(data);
            }
        });
    }

  </script>

