    <script type="text/JavaScript">
        $(function () {
            var dialog, form;

            function addUser() {
                form.submit();
            }

            dialog = $("#Create-DivLineSpecsDialog-form").dialog({
                autoOpen: false,
                height: 1050,
                width: 1400,
                modal: true
            });

            form = $("#FormCreateDivLineSpecs");

        });

        function ShowCreateDivSpecsDialog(dialog, inputFormId) {

            debugger;
            var x = document.getElementById(inputFormId);
            var y = document.getElementById("FormCreateDivLineSpecs");
            var col = "";
            var newDivTable = "";

            for (var i = 0; i < x.length; i++) {
                if (y.elements.namedItem(x.elements[i].name) != null) {
                    y.elements.namedItem(x.elements[i].name).value = x.elements[i].value;
                }
                if (x.elements[i].name.match("col")) {
                    col = x.elements[i].value;
                }

                if (x.elements[i].name.match("newDivTable")) {
                    newDivTable = x.elements[i].value;
                }
            }

            if (col == "undefined" || col == null || col == "new" || col=="") {
                col = newDivTable;
                y.elements.namedItem("col").value = col;
            }

            //Spec per table in "FieldsListTmp"
            document.getElementById("FieldsListTmp").innerHTML = "";
            var output = [];
            var length = ngon.dictionarySpecs[col].length;
            for (var i = 0; i < length; i++) {
                output[i] = '<option value="' + ngon.dictionarySpecs[col][i] + '">' + ngon.dictionarySpecs[col][i] + '</option>';
            }
            document.getElementById("FieldsListTmp").innerHTML = output.join('');
            //

            var td = "#" + dialog;
            $(td).dialog();
            $(td).dialog("option", "width", 1400);
            $(td).dialog("option", "length", 1050);
            $(td).dialog("option", "modal", true);
            $(td).dialog("open");

        };


  </script>


