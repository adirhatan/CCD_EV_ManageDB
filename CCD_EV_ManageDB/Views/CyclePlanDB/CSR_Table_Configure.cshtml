    <tbody>
    @foreach (var TDVPair in Model.table_divs)
    {
        if ((Model.separateCSRperTable == "Y") && (TDVPair.Key != ViewBag.selectedCol))
        {
            continue;
        }
        int TDVcnt = 0;
        MDBUserTableReport MDBReport = new MDBUserTableReport();
        foreach (var TDV in TDVPair.Value)
        {
            TDVcnt++;
            bool isLastTDV = false;
            if (TDVcnt == TDVPair.Value.Count)
            {
                isLastTDV = true;
            }
            int TDLcnt = 0;
            foreach (var TDL in TDV.Value.TableDivLines)
            {
                TDLcnt++;
                string ReportForm = "ReportForm" + @TDL.Value.name + @TDV.Key;
                string EditForm = "EditForm" + @TDL.Value.name + @TDV.Key;
                string DelForm = "DelForm" + @TDL.Value.name + @TDV.Key;
                string OrderForm = "OrderForm" + @TDL.Value.name + @TDV.Key;
                string DivOrderForm = "DivOrderForm" + @TDL.Value.name + @TDV.Key;
                string cornersStr = "";
                cornersStr = cornersStr.TrimEnd(',');
                string portsStr = "";
                portsStr = portsStr.TrimEnd(',');
                string lanesStr = "";
                lanesStr = lanesStr.TrimEnd(',');
                bool isLastTDL = false;
                if (TDLcnt == TDV.Value.TableDivLines.Count) { isLastTDL = true; }
                
     <tr>
        <td>
            @TDV.Key  
        </td> 
        <td>
            (@TDV.Value.table_name)
        </td> 
        <td>
            @TDL.Value.name 
        </td> 
         <td>
            @TDL.Value.trials
        </td> 
        <td>
            @TDL.Value.numOfTests
        </td> 
         <td>
        "@TDL.Value.tableDivFields[0].name @TDL.Value.tableDivFields[0].condition @TDL.Value.tableDivFields[0].values[0] ... " 
        </td>
        <td>
        @using (Html.BeginForm("CSR_Table_Div_Line_Order", "CyclePlanDB", FormMethod.Post, new { @id = OrderForm, @name = OrderForm }))
        {
            <input type="hidden" name="proj" value="@ViewBag.proj"  />
            <input type="hidden" name="phase" value="@ViewBag.phase"  />
            <input type="hidden" name="protocol" value="@ViewBag.protocol"  />
            <input type="hidden" name="table" value="@TDV.Value.table_name"  />
            <input type="hidden" name="DivName" value="@TDV.Key"  />
            <input type="hidden" name="DivLineName" value="@TDL.Value.name"  />
            <input type="hidden" name="direction" value=""  />
