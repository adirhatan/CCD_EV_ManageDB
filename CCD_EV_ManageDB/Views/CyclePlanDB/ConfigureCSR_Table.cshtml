        @using (Html.BeginForm("CSR_Table_Div_Order", "CyclePlanDB", FormMethod.Post, new { @id = DivOrderForm, @name = DivOrderForm }))
        {
            <input type="hidden" name="proj" value="@ViewBag.proj"  />
            <input type="hidden" name="phase" value="@ViewBag.phase"  />
            <input type="hidden" name="protocol" value="@ViewBag.protocol"  />
            <input type="hidden" name="table" value="@TDV.Value.table_name"  />
            <input type="hidden" name="DivName" value="@TDV.Key"  />
            <input type="hidden" name="direction" value=""  />
            if (((TDLcnt == 1) && (!isLastTDV)) || ((TDLcnt == 1) && (Model.table_divs.Count>1)))
            {
                <input  type="image" title="Order Div down" src="@Url.Content("~/content/Images/arrowvb.png")" onclick="SubmitOrder('@DivOrderForm','down')"/>
            }
            if (((TDLcnt == 1) && (TDVcnt > 1)) || ((TDLcnt == 1) && (Model.table_divs.Count > 1)))
            {
                <span>&nbsp;</span> <input  type="image" title="Order Div up"src="@Url.Content("~/content/Images/arrowvt.png")" onclick="SubmitOrder('@DivOrderForm','up')"/>
            }

        }
        </td>
        <td>
        @using (Html.BeginForm("CSR_Table_Div_Line_Edit", "CyclePlanDB", FormMethod.Post, new { @id = EditForm, @name = EditForm }))
        {
            <input type="hidden" name="proj" value="@ViewBag.proj"  />
            <input type="hidden" name="phase" value="@ViewBag.phase"  />
            <input type="hidden" name="protocol" value="@ViewBag.protocol"  />
            <input type="hidden" name="DivName" value="@TDV.Key"  />
            <input type="hidden" name="DivLineName" value="@TDL.Value.name"  />
            <input type="hidden" name="origDivLineName" value="@TDL.Value.name"  />
            <input type="hidden" name="table" value="@TDV.Value.table_name"  />
            <input type="hidden" name="trials" value="@TDL.Value.trials" />
            <input type="hidden" name="NumOfTests" value="@TDL.Value.numOfTests" />
            int fieldsCnt = 0;
            string specValues = "";
            if (TDL.Value.tableDivFields.Count > 0)
            {
                for (int i = 0; i < TDL.Value.tableDivFields.Count; i++)
                {
                    if (TDL.Value.tableDivFields.ElementAt(i).isSpecSubSet)
                    {
                        specValues += TDL.Value.tableDivFields.ElementAt(i).values[0] + ",";
                        continue;
                    }
                    fieldsCnt++;
                    string Edit_field = "Edit_field" + (fieldsCnt).ToString();
                    string Edit_condition = "Edit_condition" + (fieldsCnt).ToString();
                    string Edit_values = "Edit_values" + (fieldsCnt).ToString();
                    string values = "";
                    foreach (string val in TDL.Value.tableDivFields.ElementAt(i).values)
                    {
                        values += val + ",";
                    }
                    values = values.TrimEnd(',');
                    <input type="hidden" name="@Edit_field"  value="@TDL.Value.tableDivFields.ElementAt(i).name"  />
                    <input type="hidden" name="@Edit_condition"  value="@TDL.Value.tableDivFields.ElementAt(i).condition"  />
                    <input type="hidden" name="@Edit_values"  value="@values"  />
                }
                specValues = specValues.TrimEnd(',');
                <input type="hidden" name="FieldsEdit"  value="@specValues"  />
            }
            for (int i = fieldsCnt; i < 5; i++)
            {
                string Edit_field = "Edit_field" + (i + 1).ToString();
                string Edit_condition = "Edit_condition" + (i + 1).ToString();
                string Edit_values = "Edit_values" + (i + 1).ToString();
                    <input type="hidden" name="@Edit_field"  value=""  />
                    <input type="hidden" name="@Edit_condition"  value="contains"  />
                    <input type="hidden" name="@Edit_values"  value=""  />
            }
            <input type="button" value="E" title="Edit DivLine" class="button" onclick="ShowEditDialog('Edit-dialog-form','@EditForm')"/>
        }
        </td> 
        <td>
        @using (Html.BeginForm("CSR_Table_Div_Line_Del", "CyclePlanDB", FormMethod.Post, new { @id = DelForm, @name = DelForm }))
        {
            <input type="hidden" name="proj" value="@ViewBag.proj"  />
            <input type="hidden" name="phase" value="@ViewBag.phase"  />
            <input type="hidden" name="protocol" value="@ViewBag.protocol"  />
            <input type="hidden" name="DivName" value="@TDV.Key"  />
            <input type="hidden" name="DivLineName" value="@TDL.Value.name"  />
            <input type="hidden" name="table" value="@TDV.Value.table_name"  />
            <input type="button" value="D" title="Delete DivLine" class="button" onclick="FormConfirmAction('@DelForm','@Url.Action("CSR_Table_Div_Line_Del", "CyclePlanDB")','Are you sure you want to delete Div Line  @TDV.Key  @TDL.Value.name ?')"/>
        }
        </td> 

    </tr>
            }
        }
    }
    </tbody>
</table>

