    <script type="text/JavaScript">
        $(function () {
            var dialog, form;

            function addUser() {
                form.submit();
            }

            dialog = $("#Edit-DivLineSpecsDialog-form").dialog({
                autoOpen: false,
                height: 800,
                width: 1400,
                modal: true
            });

            form = $("#FormEditDivLineSpecs");

        });

        function ShowEditDivSpecsDialog(dialog, inputFormId) {

            //debugger;
            var x = document.getElementById(inputFormId);
            var y = document.getElementById("FormEditDivLineSpecs");
            var FieldsEdit = "";
            var table = "";

            for (var i = 0; i < x.length; i++) {
                if (y.elements.namedItem(x.elements[i].name) != null) {
                    y.elements.namedItem(x.elements[i].name).value = x.elements[i].value;
                }
                if (x.elements[i].name.match("FieldsEdit")) {
                    FieldsEdit = x.elements[i].value;
                }
                if (x.elements[i].name.match("table")) {
                    table = x.elements[i].value;
                }
            }

            //Taking "FieldsEdit" comma delimited str into select options of "FieldsListEdit"
            document.getElementById("FieldsListEdit").innerHTML = "";
            var output = [];
            var arrayOfVals = FieldsEdit.split(",");
            var length = arrayOfVals.length;
            for (var i = 0; i < length; i++) {
                output[i] = '<option value="' + arrayOfVals[i] + '">' + arrayOfVals[i] + '</option>';
            }
            document.getElementById("FieldsListEdit").innerHTML = output.join('');


            //Spec per table in "FieldsListTmpEdit"
            document.getElementById("FieldsListTmpEdit").innerHTML = "";
            var output = [];
            var length = ngon.dictionarySpecs[table].length;
            for (var i = 0; i < length; i++) {
                output[i] = '<option value="' + ngon.dictionarySpecs[table][i] + '">' + ngon.dictionarySpecs[table][i] + '</option>';
            }
            document.getElementById("FieldsListTmpEdit").innerHTML = output.join('');
            //

            var td = "#" + dialog;
            $(td).dialog();
            $(td).dialog("option", "width", 1400);
            $(td).dialog("option", "length", 800);
            $(td).dialog("option", "modal", true);
            $(td).dialog("open");

        };


  </script>


  <!-- Edit specDialog  end-->

 <script type="text/JavaScript">

     function changedDivNameSelect(selectDivName, newTableDiv, DivLinePosId, add_col) {
         //debugger;
         var newTableDiv = document.getElementById(newTableDiv);
         if (selectDivName.value == "new") {
             newTableDiv.style.visibility = 'visible'
         } else {
             newTableDiv.style.visibility = 'hidden'
         }

         ///////
         var selectDivLinePos = document.getElementById(DivLinePosId);
         var output = [];
         var length = ngon.dictionaryDivLines[selectDivName.value].length;
         for (var i = 0; i < length; i++) {
             output[i] = '<option value="' + ngon.dictionaryDivLines[selectDivName.value][i] + '">' + ngon.dictionaryDivLines[selectDivName.value][i] + '</option>';
             if (selectDivLinePos.value === ngon.dictionaryDivLines[selectDivName.value][i]) {
                 output[i] = '<option value="' + ngon.dictionaryDivLines[selectDivName.value][i] + '"' + ' selected="selected">' + ngon.dictionaryDivLines[selectDivName.value][i] + '</option>';
             }
         }

         selectDivLinePos.innerHTML = output.join('');
         /////////
         var add_col = document.getElementById(add_col);
         add_col.value = ngon.dictionaryTablesOfDivs[selectDivName.value];
     }

     function validateCSR_Table_Div_Line_Add(formName) {
    //debugger;
         var x = document.getElementById(formName);
    //do some validation for example:
    var name = "";
    for (var i = 0; i < x.length; i++) {
        if (x.elements[i].name.match("DivLineName.*")) {
            name = x.elements[i].value;
        }
    }
    //txt = txt.substr(0, txt.length - 1);
    if (name == "") {
        alert("Div Line Name is mandatory");
