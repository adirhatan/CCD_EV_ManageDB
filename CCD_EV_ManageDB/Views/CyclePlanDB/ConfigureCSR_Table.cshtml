}

function SubmitOrder(OrderFormId, direction) {
        debugger;
        var x = document.getElementById(OrderFormId);
        for (var i = 0; i < x.length; i++) {
            if (x.elements[i].name.match("direction")) {
                x.elements[i].value = direction;
            }
        }
        x.submit();
    }
  </script>

  
