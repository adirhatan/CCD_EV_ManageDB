@{
    ViewBag.Title = "Validate Project";
}

<h2>Validate Project</h2>
<script src="@Url.Content("~/Scripts/ccdEV.js")" type="text/javascript" ></script>    
<script src="@Url.Content("~/Scripts/ccdEV.js")" type="text/javascript" ></script>     

     @{ var ExportedFile = ViewBag.ExportedFileNAme;
        if (ExportedFile != null)
        {
             <script type="text/JavaScript">
                 $(document).ready(function () {
                     var url = '@Url.Action("ViewExportFile", "ManageDB", new { filename = ViewBag.ExportedFileNAme })';
                     $(location).attr('href', url);
                 });
             </script>
        }
     }
<p class="messageText">@TempData["message"]</p>
<p class="messageInfoText">@TempData["messageInfo"]</p> 


      @using (Html.BeginForm("ValidateProject", "CyclePlanDB", FormMethod.Post, new { @id = "allForm", @name = "allForm" }))
      {
     <p>
        Select Project: 
        <select id="all_proj" name="proj" onchange="GenSubmitFormAction('allForm','@Url.Action("ValidateProject", "CyclePlanDB")')">
            @foreach (var proj in ViewBag.projlist)
            {
                if (proj.ToString() == ViewBag.proj)
                {
                    <option value="@proj.ToString()" selected="selected"> @proj.ToString()</option>
                }
                else
                {
                    <option value="@proj.ToString()"> @proj.ToString()</option>
                }
            }
        </select> 
        Select Phase: 
        <select id="all_phase" name="phase" onchange="GenSubmitFormAction('allForm','@Url.Action("ValidateProject", "CyclePlanDB")')">
            @foreach (var phase in ViewBag.phaselist)
            {
                if (phase.ToString() == ViewBag.phase)
                {
                    <option value="@phase.ToString()" selected="selected"> @phase.ToString()</option>
                }
                else
                {
                    <option value="@phase.ToString()" > @phase.ToString()</option>
                }
            }
        </select> 
        Select Interface: 
        <select id="all_protocol" name="protocol" class="wselect" onchange="GenSubmitFormAction('allForm','@Url.Action("ValidateProject", "CyclePlanDB")')">
            @foreach (var protocol in ViewBag.protocollist)
            {
                if (protocol.ToString() == ViewBag.protocol)
                {
                    <option value="@protocol.ToString()" selected="selected"> @protocol.ToString()</option>
                }
                else
                {
                    <option value="@protocol.ToString()" > @protocol.ToString()</option>
                }
            }
        </select> 
        &nbsp; <input type="button" value="Cycle Plan Main" title="back to Cycle Plan Main" class="button" onclick="GenLocatioAction('@Url.Action("Main", "CyclePlanDB", new { @protocol = ViewBag.protocol, @phase = ViewBag.phase, @proj = ViewBag.proj })')" />
    </p>
      }


    @using (Html.BeginForm("SearchDupSpecTestNameAssigned", "CyclePlanDB", FormMethod.Post, new { @id = "addForm", @name = "addForm" }))
    {
    <input type="hidden" name="proj" value="@ViewBag.proj"  />
    <input type="hidden" name="phase" value="@ViewBag.phase"  />
    <input type="hidden" name="protocol" value="@ViewBag.protocol"  />
     <p>   
        <u>Search duplicate SpecTestName assigned</u>
        
        <input type="submit" class="button" />
    </p>
  }
  


