    <script type="text/JavaScript">
          $(function () {
              var dialog, form;

              function addUser() {
                  form.submit();
              }

              dialog = $("#Edit-dialog-form").dialog({
                  autoOpen: false,
                  height: 400,
                  width: 500,
                  modal: true
              });

              form = $("#FormEdit");

          });

          function ShowEditDialog(dialog, inputFormId) {

              //debugger;
              var x = document.getElementById(inputFormId);
              var y = document.getElementById("FormEdit");
              //y.elements.namedItem("Board").value = x.elements.namedItem("Board").value;
              var selectTableForm = document.getElementById("addForm");
              var selectTable = selectTableForm.elements.namedItem("col");
              selectTableForm.elements.namedItem("col").value = x.elements.namedItem("col").value;
              changedTableSelect(selectTable, 'editSetUpType');

              for (var i = 0; i < x.length; i++) {
                  if (y.elements.namedItem(x.elements[i].name) != null) {
                      y.elements.namedItem(x.elements[i].name).value = x.elements[i].value;
                  }
              }
              var td = "#" + dialog;
              $(td).dialog();
              $(td).dialog("option", "width", 500);
              $(td).dialog("option", "length", 400);
              $(td).dialog("option", "modal", true);
              $(td).dialog("open");

          };


  </script>


  <!-- Edit dialog end-->

 <script type="text/JavaScript">
     function validateAddCoverageRule(formName) {
    //debugger;
         var x = document.getElementById(formName);
    //do some validation for example:
    var name = "";
    for (var i = 0; i < x.length; i++) {
        if (x.elements[i].name.match("name.*")){
            name = x.elements[i].value;
        }
    }
    //txt = txt.substr(0, txt.length - 1);
    if (name == "") {
        alert("Name is mandatory");
        return;
    }
    else {
    
        x.submit();
    }
}

function changedTableSelect(selectTable, SetupTypeId) {
    return;
    // no need for setup type
    var selectSetupType = document.getElementById(SetupTypeId);
    var output = [];
    var length = ngon.dictionarySetupTypes[selectTable.value].length;
    for (var i = 0; i < length; i++) {
        output[i] = '<option value="' + ngon.dictionarySetupTypes[selectTable.value][i] + '">' + ngon.dictionarySetupTypes[selectTable.value][i] + '</option>';
        if (selectSetupType.value === ngon.dictionarySetupTypes[selectTable.value][i]) {
            output[i] = '<option value="' + ngon.dictionarySetupTypes[selectTable.value][i] + '"' + ' selected="selected">' + ngon.dictionarySetupTypes[selectTable.value][i] + '</option>';
        }
    }

    selectSetupType.innerHTML = output.join('');
}
  </script>

