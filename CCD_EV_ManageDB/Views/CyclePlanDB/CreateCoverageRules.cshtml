    <b>Exist Coverage Rules for @ViewBag.protocol @ViewBag.proj @ViewBag.phase: </b>
   <table id="SpecSupSets" class="display">
    <thead>
    <tr>
        <th >
            Table
        </th>
        <th >
            Name
        </th>
        <th >
            Corners
        </th>
        <th >
            Ports
        </th>
        <th >
            Lanes
        </th>
        <th >
            Trials
        </th>
        <th >
            Edit
        </th>
        <th >
            Delete
        </th>
    </tr> 

    </thead>
    <tbody>
    @foreach (CyclePlanCoverageRule CPCoverageRule in Model)
    {
        string EditForm = "EditForm" + @CPCoverageRule._id;
        string DelForm = "DelForm" + @CPCoverageRule._id;
        string cornersStr = "";
        foreach (string corner in CPCoverageRule.corners) { cornersStr += corner + ","; }
        cornersStr = cornersStr.TrimEnd(',');
        string portsStr = "";
        foreach (string port in CPCoverageRule.ports) { portsStr += port + ","; }
        portsStr = portsStr.TrimEnd(',');
        string lanesStr = "";
        foreach (string lane in CPCoverageRule.lanes) { lanesStr += lane + ","; }
        lanesStr = lanesStr.TrimEnd(',');
     <tr>
        <td>
        @CPCoverageRule.Table
        </td> 
        <td>
         @CPCoverageRule.Name
        </td> 
         <td>
        @cornersStr
        </td> 
        <td>
        @portsStr
        </td> 
         <td>
        @lanesStr
        </td>
        <td>
        @CPCoverageRule.trials
        </td> 
        <td>
        @using (Html.BeginForm("CreateCoverageRulesEdit", "CyclePlanDB", FormMethod.Post, new { @id = EditForm, @name = EditForm }))
        {
            <input type="hidden" name="id" value="@CPCoverageRule._id"  />
            <input type="hidden" name="name" value="@CPCoverageRule.Name"  />
            <input type="hidden" name="col" value="@CPCoverageRule.Table"  />
            <input type="hidden" name="corners" value="@cornersStr"  />
            <input type="hidden" name="ports" value="@portsStr"  />
            <input type="hidden" name="lanes" value="@lanesStr"  />
            <input type="hidden" name="trials" value="@CPCoverageRule.trials"  />
             <!--<input type="button" value="E" title="Edit SubSet" class="button" onclick="GenSubmitFormAction('@EditForm','@Url.Action("CreateCoverageRulesEdit", "CyclePlanDB")')"/>-->
             <input type="button" value="E" class="button" onclick="ShowEditDialog('Edit-dialog-form','@EditForm')"/>
        }
        </td> 
        <td>
        @using (Html.BeginForm("CreateCoverageRulesDel", "CyclePlanDB", FormMethod.Post, new { @id = DelForm, @name = DelForm }))
        {
             <input type="hidden" name="id" value="@CPCoverageRule._id"  />
            <input type="hidden" name="col" value="@CPCoverageRule.Table"  />
             <input type="button" value="D" title="Delete SubSet" class="button" onclick="FormConfirmAction('@DelForm','@Url.Action("CreateCoverageRulesDel", "CyclePlanDB")','Are you sure you want to delete Coverag Rule @CPCoverageRule.Name ?')"/>
        }
        </td> 

    </tr>
    }
    </tbody>
</table>



