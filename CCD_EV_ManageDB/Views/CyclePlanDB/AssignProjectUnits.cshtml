   <table id="SpecSupSets" class="display">
    <thead>
    <tr>
        <th >
            Table
        </th>
        <th >
            Skew
        </th>
        <th >
            Logic Unit
        </th>
        <th >
            Board Type
        </th>
        <th >
            SetUp Type
        </th>
        <th >
            SpecSubSet
        </th>
        <th >
            Coverage Rule
        </th>
        <th >
            WW
        </th>
        <th >
            Duration (WW)
        </th>
        <th >
            Stations #
        </th>
        <th >
            Edit
        </th>
        <th >
            Delete
        </th>
    </tr> 

    </thead>
    <tbody>
@{
    int lineCnt = 0;
    foreach (CyclePlanProjectUnitDisp CPProjectUnitDisp in Model.CyclePlanProjectUnitsDisp)
    {
        string EditForm = "EditForm" + @CPProjectUnitDisp._id + "_" + @CPProjectUnitDisp.plan.SpecSubSetID + "_" + @CPProjectUnitDisp.plan.CoverageRuleID;
        string DelForm = "DelForm" + @CPProjectUnitDisp._id + "_" + @CPProjectUnitDisp.plan.SpecSubSetID + "_" + @CPProjectUnitDisp.plan.CoverageRuleID;
        string lineId = "line" + @lineCnt.ToString();
        lineCnt++;
     <tr id="@lineId">
        <td>
        @CPProjectUnitDisp.Table
        </td> 
        <td>
         @CPProjectUnitDisp.Skew
        </td> 
         <td>
         @CPProjectUnitDisp.LogicUnit
        </td>         
         <td>
         @CPProjectUnitDisp.BoardType
        </td> 
         <td>
        @CPProjectUnitDisp.SetupType
        </td> 
        <td>
             @if (string.IsNullOrEmpty(CPProjectUnitDisp.plan.SpecSubSetID))
             {
                <text>
                <p style="background-color:Red">!!! SpecSubSet was deleted; Edit and insert valid SpecSubSet !!!</p>
                </text>
             }
             else
             {
                <text>       
                @Model.SpecSubSetsNames[CPProjectUnitDisp.plan.SpecSubSetID]  (@Model.SpecSubSetsNumbers[CPProjectUnitDisp.plan.SpecSubSetID])
                </text>
             }
        </td> 
         <td>
            @if (string.IsNullOrEmpty(CPProjectUnitDisp.plan.CoverageRuleID))
            {
                <text>
                 <p style="background-color:Red">!!! Rule was deleted; Edit and insert valid rule !!!</p>
                </text>
            }
            else
            {
                <text>
                @Model.CoverageRulesNames[CPProjectUnitDisp.plan.CoverageRuleID] (@Model.CoverageRulesSums[CPProjectUnitDisp.plan.CoverageRuleID])
                </text>
            }
        </td>
        <td>@{
            string wwKey = "";
            foreach (KeyValuePair<string, string> pair in ViewBag.workweeks)
            {
                if (pair.Value == CPProjectUnitDisp.plan.wws) { wwKey = pair.Key; break; }
            }
            @wwKey;
            }
        </td> 
        <td>
            @if (string.IsNullOrEmpty(CPProjectUnitDisp.plan.CoverageRuleID))
            {
                <text>
                <p style="background-color:Red">!!! Rule was deleted; Edit and insert valid rule !!!</p>
                </text>
            }
            @if (string.IsNullOrEmpty(CPProjectUnitDisp.plan.SpecSubSetID))
            {
                <text>
                <p style="background-color:Red">!!! SpecSubSet was deleted; Edit and insert valid SpecSubSet !!!</p>
                </text>
            }
            @if ((!string.IsNullOrEmpty(CPProjectUnitDisp.plan.CoverageRuleID)) && (!string.IsNullOrEmpty(CPProjectUnitDisp.plan.SpecSubSetID)))
            {
                double d = Model.CPMetaData.IndicatorsMeta[CPProjectUnitDisp.Table].resAvgTime * Convert.ToInt32(Model.SpecSubSetsNumbers[CPProjectUnitDisp.plan.SpecSubSetID]) * Convert.ToInt32(Model.CoverageRulesSums[CPProjectUnitDisp.plan.CoverageRuleID]);
                d = d / 9; // hours per day
                d = d / 5; // days per WW
                d = d / Convert.ToInt32(CPProjectUnitDisp.plan.stationsNum); //# of stations 
                string duration = d.ToString("0.#");
                @duration
                if (!LogicUnitsDurationsSum.ContainsKey(CPProjectUnitDisp.Table+'#'+CPProjectUnitDisp.LogicUnit))
                {
                    LogicUnitsDurationsSum.Add(CPProjectUnitDisp.Table+'#'+CPProjectUnitDisp.LogicUnit, 0);
                }
                LogicUnitsDurationsSum[CPProjectUnitDisp.Table + '#' + CPProjectUnitDisp.LogicUnit] += d;
                DurationAllSum += d;
            }
                  
        </td>
        <td>
         @CPProjectUnitDisp.plan.stationsNum
        </td>
        <td>
