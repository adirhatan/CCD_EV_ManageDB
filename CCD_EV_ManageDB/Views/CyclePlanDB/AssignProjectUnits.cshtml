<div id="Edit-dialog-form" title="Edit Project Unit">
  <p class="validateTips">Edit Project Unit</p>
 
  <form method="post" action='@Url.Action("AssignProjectUnitsEditExec", "CyclePlanDB")' id="FormEdit">
    <input type="hidden" name="id" value=""  />
    <input type="hidden" name="SpecSubSetIDorig" value=""  />
    <input type="hidden" name="CoverageRuleIDorig" value=""  />
    <fieldset>
      <label for="name">Table:</label>
        <input type="text" id="colEdit" name="col" value="" disabled="disabled" />
        <br /><label for="name">Logic Unit:</label>
        <input type="text" id="editLogicUnit" name="LogicUnit" value="" disabled="disabled" />
        <br /><label for="name">Skew:</label>
        <select id="editSkew" name="Skew" style="width:auto" >
            <option value="FF">FF</option>
            <option value="TYP">TYP</option>
            <option value="SS">SS</option>

        </select>  

        <br /><label for="name"> Logic Unit Number: </label>
        <select id="editLogicUnitNumber" name="LogicUnitNumber" style="width:auto" >
            <option value="1">1</option>
            <option value="2">2</option>
            <option value="3">3</option>
            <option value="4">4</option>
            <option value="5">5</option>
            <option value="6">6</option>
        </select> 
            @{
                string editdis_b_types = "";
                if (((List<string>)ViewBag.BoardTypes).Count == 0) { editdis_b_types = "disabled=\"disabled\""; }
            }
        <br /><label for="name">Board Type:</label>
                <select id="editBoardType" name="BoardType" style="width:auto" @editdis_b_types>
            @foreach (var btype in ViewBag.BoardTypes)
            {
                    <option value="@btype"> @btype</option>
            }
        </select>  

        @{
            string editdis_types = "";
            if (((List<string>)ViewBag.SetupTypes).Count == 0) { editdis_types = "disabled=\"disabled\""; }
            }
          <br /><label for="name">Setup Type: </label>
                <select id="editSetUpType" name="SetUpType" style="width:auto" @editdis_types>
            @foreach (var type in ViewBag.SetupTypes)
            {
                    <option value="@type"> @type</option>
            }
        </select>  
         <br /><label for="name"> SpecSubSet: </label>
        <select id="editSpecSubSetID" name="SpecSubSetID" style="width:auto" >
            @foreach (CyclePlanSpecSubSet SpecSubSet in Model.CyclePlanSpecSubSets)
            {
                {
                    <option value="@SpecSubSet._id"> @SpecSubSet.Name</option>
                }
            }
        </select>
        <br /><label for="name"> Coverage Rule: </label>
        <select id="editCoverageRuleID" name="CoverageRuleID" style="width:auto" >
            @foreach (CyclePlanCoverageRule CoverageRule in Model.CyclePlanCoverageRules)
            {
                {
                    <option value="@CoverageRule._id"> @CoverageRule.Name</option>
                }
            }
        </select>  
        <br /><label for="name">WW start:</label>
        <select id="edit_wws" name="wws" >
            @foreach (KeyValuePair<string, string> ww in ViewBag.workweeks)
            {
                <option value="@ww.Value"> @ww.Key</option>
            }
        </select>  
        <br /><label for="name">Stations #:</label>
              <input id="editstationsNum" name="stationsNum" type="text" style="width:30px" />

      <br />
      <input type="submit" class="button"/>
    </fieldset>
  </form>
</div>
