function changedTableSelect(selectTable, SpecSubSetId, CoverageRulesId) {
    //debugger;
    //var selectFields = elem.nextSibling.nextSibling;
    var selectSpecSubSet = document.getElementById(SpecSubSetId);
    var output = [];
    var length = ngon.dictionarySpecSubSets[selectTable.value].length;
    for (var i = 0; i < length; i++) {
        output[i] = '<option value="' + ngon.dictionarySpecSubSets[selectTable.value][i] + '">' + ngon.dictionarySpecSubSetsNames[selectTable.value][i] + '</option>';
        if (selectSpecSubSet.value === ngon.dictionarySpecSubSets[selectTable.value][i]) {
            output[i] = '<option value="' + ngon.dictionarySpecSubSets[selectTable.value][i] + '"' + ' selected="selected">' + ngon.dictionarySpecSubSetsNames[selectTable.value][i] + '</option>';
        }
    }

    selectSpecSubSet.innerHTML = output.join('');

    var selectCoverageRules = document.getElementById(CoverageRulesId);
    var output = [];
    var length = ngon.dictionaryCoverageRules[selectTable.value].length;
    for (var i = 0; i < length; i++) {
        output[i] = '<option value="' + ngon.dictionaryCoverageRules[selectTable.value][i] + '">' + ngon.dictionaryCoverageRulesNames[selectTable.value][i] + '</option>';
        if (selectCoverageRules.value === ngon.dictionaryCoverageRules[selectTable.value][i]) {
            output[i] = '<option value="' + ngon.dictionaryCoverageRules[selectTable.value][i] + '"' + ' selected="selected">' + ngon.dictionaryCoverageRulesNames[selectTable.value][i] + '</option>';
        }
    }

    selectCoverageRules.innerHTML = output.join('');

}

function changedTableSelectCopyUnit(selectTable, copy_SourceId,prefix) {
    //debugger;
    prefix = prefix + selectTable.value;
    var select_copy_SourceId = document.getElementById(copy_SourceId);
    var output = [];
    var length = Object.keys(ngon.dictionaryCopy_SourceId).length;
    //var length = ngon.dictionaryCopy_SourceId.length;
    for (var i = 0; i < length; i++) {
        //Crystal_MR_C0_Crystal1_TYP_N_H_1,TYP_N_H_1
        Object.keys(ngon.dictionaryCopy_SourceId)[i];
        if (Object.keys(ngon.dictionaryCopy_SourceId)[i].startsWith(prefix)) {
            output[i] = '<option value="' + Object.keys(ngon.dictionaryCopy_SourceId)[i] + '">' + ngon.dictionaryCopy_SourceId[Object.keys(ngon.dictionaryCopy_SourceId)[i]] + '</option>';
        }
    }

    select_copy_SourceId.innerHTML = output.join('');
}


function changedTableSelectCopySkew(selectTable, copy_Skew, prefix) {
    debugger;
    prefix = prefix + selectTable.value;
    var select_copy_Skew = document.getElementById(copy_Skew);
    var output = [];
    var length = Object.keys(ngon.dictionaryCopy_Skew).length;
    for (var i = 0; i < length; i++) {
        Object.keys(ngon.dictionaryCopy_Skew)[i];
        if (Object.keys(ngon.dictionaryCopy_Skew)[i].startsWith(prefix)) {
            output[i] = '<option value="' + ngon.dictionaryCopy_Skew[Object.keys(ngon.dictionaryCopy_Skew)[i]] + '">' + ngon.dictionaryCopy_Skew[Object.keys(ngon.dictionaryCopy_Skew)[i]] + '</option>';
        }
    }

    select_copy_Skew.innerHTML = output.join('');
}

