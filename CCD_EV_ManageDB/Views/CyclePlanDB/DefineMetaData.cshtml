 <script type="text/JavaScript">

     function validateAddTable(formName) {
    //debugger;
         var x = document.getElementById(formName);
    //do some validation for example:
    var col = "";
    var spec = "";
    var BoardTypeVals = "";
    var SetupTypeVals = "";
    for (var i = 0; i < x.length; i++) {
        if (x.elements[i].name.match("col.*")){
            col = x.elements[i].value;
        }
        if (x.elements[i].name.match("spec.*")) {
            spec = x.elements[i].value;
        }
        if (x.elements[i].name.match("BoardTypeVals.*")) {
            BoardTypeVals = x.elements[i].value;
        }
        if (x.elements[i].name.match("SetupTypeVals.*")) {
            SetupTypeVals = x.elements[i].value;
        }
    }
    //txt = txt.substr(0, txt.length - 1);
    if (col == "") {
        alert("Table is mandatory");
        return;
    }
    if (spec == "") {
        alert("Spec is mandatory");
        return;
    }
    if (BoardTypeVals == "") {
        alert("Board Type one value is mandatory");
        return;
    }
    if (SetupTypeVals == "") {
        alert("SetUp Type one value is mandatory");
        return;
    }
    else {
    
        x.submit();
    }
}

function AjaxUpdateResAvgTime(resAvgTimeUpdID, form_id, _id, action) {

    //debugger;
    var URL = action;
    var form = document.getElementById(form_id);
    var proj = form.elements.namedItem("proj").value; ;
    var phase = form.elements.namedItem("phase").value; ;
    var protocol = form.elements.namedItem("protocol").value;
    var col = form.elements.namedItem("col").value;
    var td = "#" + _id;
    var resAvgTimeObj = "#" + resAvgTimeUpdID;
    var resAvgTimeVal = $(resAvgTimeObj).val();
    var posting = $.post(URL, { proj: proj, phase: phase, protocol: protocol, col: col, resAvgTime: resAvgTimeVal });

    posting.done(function (data) {
        $(td).html(data);
    });
}

</script>
