<b>Defined Tables and Specs for @ViewBag.protocol @ViewBag.proj @ViewBag.phase: </b>
   <table id="protocolTables" class="display">
    <thead>
    <tr>
        <th >
            Delete
        </th>
        <th >
            Table
        </th>
        <th >
            Spec
        </th>
        <th >
            Board Type
        </th>
        <th >
            Setup Type
        </th>
        <th >
            Avg Res Time
        </th>
         <th >
            Update Avg Res Time
        </th>
    </tr> 

    </thead>
    <tbody>
    @{
        int upd = 0;
        foreach (var metaPair in Model.IndicatorsMeta)
        {
            upd++;
            string DefForm = "DefForm" + @metaPair.Key;
            string rAvgTime_id = "rAvgTime_id_" + upd.ToString();
            string Upd_rAvgTime_id = "Upd_" + rAvgTime_id;
     <tr>
        <td>
        @using (Html.BeginForm("IndicatorDelete", "GeneralDB", FormMethod.Post, new { @id = DefForm, @name = DefForm }))
        {
             <input type="hidden" name="proj" value="@ViewBag.proj"  />
             <input type="hidden" name="phase" value="@ViewBag.phase"  />
             <input type="hidden" name="protocol" value="@ViewBag.protocol"  />           
             <input type="button" value="D" title="Delete Table" class="button" onclick="FormConfirmAction('@DefForm','@Url.Action("DefineMetaDataDelTable", "CyclePlanDB")','Are you sure you want to delete table @metaPair.Key? (and all its associated configuration)')"/>
             <input type="hidden" name="col" value="@metaPair.Key" />
        }
        </td> 
        <td>
        @metaPair.Key
        </td> 
        <td>
        @metaPair.Value.spec
        </td> 
         <td>
        @{ string btypesStr = "";
           foreach (string bType in metaPair.Value.BoardTypes) { btypesStr += bType + ","; }
           btypesStr = btypesStr.TrimEnd(',');
            }
        @btypesStr
        </td>
        <td>
        @{ string typesStr = "";
           foreach (string sType in metaPair.Value.SetupTypes) { typesStr += sType + ","; }
           typesStr = typesStr.TrimEnd(',');
            }
        @typesStr
        </td>
        <td id="@rAvgTime_id">
        @metaPair.Value.resAvgTime
        </td>
        <td>
            <input type="text" id="@Upd_rAvgTime_id" name="@Upd_rAvgTime_id" style="width: 30px" />
            <input type="button" value="M" title="Rename Report" class="button" onclick="AjaxUpdateResAvgTime('@Upd_rAvgTime_id','@DefForm','@rAvgTime_id','@Url.Action("DefineMetaDataUpdateResAvgTime", "CyclePlanDB")')" />
        </td>

    </tr>
        }
    }
    </tbody>
</table>



