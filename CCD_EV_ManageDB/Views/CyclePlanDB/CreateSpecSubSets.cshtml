    @using (Html.BeginForm("CreateSpecSubSetsAddSSS", "CyclePlanDB", FormMethod.Post, new { @id = "addForm", @name = "addForm" }))
    {
    <input type="hidden" name="proj" value="@ViewBag.proj"  />
    <input type="hidden" name="phase" value="@ViewBag.phase"  />
    <input type="hidden" name="protocol" value="@ViewBag.protocol"  />
     <p>   
        <u>Create new SpecSubSet</u>: Select Table-Spec: 
        <select id="ind_col" name="col" style="width:400px" onchange="GenSubmitFormAction('addForm','@Url.Action("CreateSpecSubSets", "CyclePlanDB")')">
            @foreach (var col in ViewBag.IndicatorsMetalist)
            {
                if (ViewBag.selectedCol == col.Key)
                {
                    <option value="@col.Key" selected="selected"> @col.Key - @col.Value.spec </option>
                }
                else
                {
                    <option value="@col.Key"> @col.Key - @col.Value.spec</option>
                }
            }
        </select>  

            <input type="button" value="Create" class="button" id="ExportVisualization" onclick="ShowVisDialog('Create-dialog-form')"/>
    </p>
                }
    <br />
    <b>Exist Spec Sub Sets for @ViewBag.protocol @ViewBag.proj @ViewBag.phase: </b>
   <table id="SpecSupSets" class="display">
    <thead>
    <tr>
        <th >
            Table
        </th>
        <th >
            Spec
        </th>
        <th >
            Name
        </th>
        <th >
            #Tests
        </th>
        <th >
            Edit
        </th>
        <th >
            Delete
        </th>
    </tr> 

    </thead>
    <tbody>
    @foreach (CyclePlanSpecSubSet CPSpecSubSet in Model)
    {
        string EditForm = "EditForm" + @CPSpecSubSet._id;
        string DelForm = "DelForm" + @CPSpecSubSet._id;
     <tr>
        <td>
        @CPSpecSubSet.Table
        </td> 
        <td>
         @CPSpecSubSet.Spec
        </td> 
        <td>
         @CPSpecSubSet.Name
        </td> 
         <td>
         @CPSpecSubSet.SpecTestNames.Count / @CPSpecSubSet.allTests
        </td> 
        <td>
        @using (Html.BeginForm("CreateSpecSubSetsEditSubSet", "CyclePlanDB", FormMethod.Post, new { @id = EditForm, @name = EditForm }))
        {
             <input type="hidden" name="id" value="@CPSpecSubSet._id"  />
             <input type="hidden" name="proj" value="@ViewBag.proj"  />
             <input type="hidden" name="phase" value="@ViewBag.phase"  />
             <input type="hidden" name="protocol" value="@ViewBag.protocol"  />
             <input type="button" value="E" title="Edit SubSet" class="button" onclick="GenSubmitFormAction('@EditForm','@Url.Action("CreateSpecSubSetsEditSubSet", "CyclePlanDB")')"/>
        }
        </td> 
        <td>
        @using (Html.BeginForm("CreateSpecSubSetsDelSubSet", "CyclePlanDB", FormMethod.Post, new { @id = DelForm, @name = DelForm }))
        {
             <input type="hidden" name="id" value="@CPSpecSubSet._id"  />
             <input type="button" value="D" title="Delete SubSet" class="button" onclick="FormConfirmAction('@DelForm','@Url.Action("CreateSpecSubSetsDelSubSet", "CyclePlanDB")','Are you sure you want to delete SpecSubSet @CPSpecSubSet.Name ?')"/>
        }
        </td> 

    </tr>
    }
    </tbody>
</table>



<div id="Create-dialog-form" title="Create SpecSubSet">
  <p class="validateTips">Create SpecSubSet of "@ViewBag.selectedSpec"</p>
 
  <form method="post" action='@Url.Action("CreateSpecSubSetsAddSubSet", "CyclePlanDB")' id="CreateForm">
          <input type="hidden" name="proj" value="@ViewBag.proj"  />
          <input type="hidden" name="phase" value="@ViewBag.phase"  />
          <input type="hidden" name="protocol" value="@ViewBag.protocol"  />
          <input type="hidden" name="col" value="@ViewBag.selectedCol"  />
          <input type="hidden" name="spec" value="@ViewBag.selectedSpec" />

    <fieldset>
      <label for="name">SpecSubSet Name:</label>
        <input type="text" id="SubSetName" name="SubSetName" style="width: 120px" />
        <br />
        <label for="name">Filter "All" SpecTestNames (auto selection):</label>
        <input type="text" id="filterSpecs" name="filterSpecs" value=""  />
        <br />
         <table id="FieldsTable" style="border:none">
             <thead>
             <tr>
             <th style="background-color: #e6e6e6;color: #555555">All SpecTestNames</th>
             <th style="background-color: #e6e6e6;color: #555555"></th>
             <th style="background-color: #e6e6e6;color: #555555">Selected SpecTestNames for Sub Set</th>
             <th style="background-color: #e6e6e6;color: #555555"></th>
             </tr>
             </thead>
             <tbody>
                <tr>
                    <td>
 
                        <select id="FieldsListTmp" name="FieldsListTmp" multiple="multiple" size="25" style="width: 550px;">
                        @{
                            foreach (var field in ViewBag.selectedSpecTestslist)
                            {
                                <option value="@field.ToString()"> @field.ToString()</option>
                            }
                        }
                         </select> 
                    </td>
    

                    <td nowrap>
                        <div class="Button"><div class="Left">&nbsp;</div><div class="Middle"><input type="button" id="add" class="button" onclick="javascript: moveSelected('FieldsListTmp', 'FieldsList', false,'Create');" value="Add"/></div><div class="Right">&nbsp;</div></div>
                        <div class="Button">
                            <div class="Left">&nbsp;</div>
                            <!--<div class="Middle"><input type="button" id="addAll" class="button" value="Add All" onclick="javascript: moveSelected('FieldsListTmp', 'FieldsList', true,'Create');"/></div>-->
                            <div class="Right">&nbsp;</div>
                        </div>
                    </td>

                    <td>
                    <select name="FieldsList" multiple="multiple" size="25" style="width: 550px;" class="InputField" id="FieldsList"></select>
                    <input type="hidden" name="Fields" value=""/>
                    <input type="hidden" name="load" value="yes"/>
                    </td>

                    <td nowrap>
                        <div class="Button"><div class="Left">&nbsp;</div><div class="Middle"><input type="button" id="rem" class="button" onclick="javascript: moveSelected('FieldsList', null, false,'Create');" value="Remove"/></div><div class="Right">&nbsp;</div></div>
                        <div class="Button"><div class="Left">&nbsp;</div><div class="Middle"><input type="button" id="remAll" class="button" onclick="javascript: moveSelected('FieldsList', null, true,'Create');" value="Remove All"/></div><div class="Right">&nbsp;</div></div>
                    </td>
                </tr>
            </tbody>
        </table>
      <br />
      <input type="submit" class="button"/>
    </fieldset>
  </form>
</div>

@{
    CyclePlanSpecSubSet EditedSubset = new CyclePlanSpecSubSet();
    if (TempData["EditedSubset_id"]!=null)
    {
        MDBCyclePlanSpecSubSet MDBCPlanSpecSubSet = new MDBCyclePlanSpecSubSet();
        EditedSubset = MDBCPlanSpecSubSet.Read(TempData["EditedSubset_id"].ToString());
        //EditedSubset = (CyclePlanSpecSubSet)TempData["EditedSubset"];
    }
    List<string> editedSpecTestslist = new List<string>();
    if (TempData["editedSpecTestslist"]!=null)
    {
        editedSpecTestslist = (List<string>)TempData["editedSpecTestslist"];
    }
}
<div id="Edit-dialog-form" title="Edit SpecSubSet">
  <p class="validateTips">Edit SpecSubSet of "@ViewBag.selectedSpec"</p>
 
  <form method="post" action='@Url.Action("CreateSpecSubSetsEditExecSubSet", "CyclePlanDB")' id="FormEdit">
          <input type="hidden" name="id" value="@EditedSubset._id"  />
    <fieldset>
      <label for="name">SpecSubSet Name</label>
        <input type="text" id="SubSetNameEdit" name="SubSetName" value="@EditedSubset.Name"  />
        <br />

        <label for="name">Filter "All" SpecTestNames (auto selection):</label>
        <input type="text" id="editfilterSpecs" name="filterSpecs" value=""  />
        <br />
         <table id="VisFieldsTableEdit" style="border:none">
             <thead>
             <tr>
             <th style="background-color: #e6e6e6;color: #555555">All SpecTestNames</th>
             <th style="background-color: #e6e6e6;color: #555555"></th>
             <th style="background-color: #e6e6e6;color: #555555">Selected SpecTestNames for Sub Set</th>
             <th style="background-color: #e6e6e6;color: #555555"></th>
             </tr>
             </thead>
             <tbody>
                <tr>
                    <td>
 
                        <select id="FieldsListTmpEdit" name="FieldsListTmpEdit" multiple="multiple" size="25" style="width: 550px;">
                        @{
                            foreach (var field in editedSpecTestslist)
                            {
                                <option value="@field.ToString()"> @field.ToString()</option>
                            }
                        }
                         </select> 
                    </td>
    

                    <td nowrap>
                        <div class="Button"><div class="Left">&nbsp;</div><div class="Middle"><input type="button" id="addEdit" class="button" onclick="javascript: moveSelected('FieldsListTmpEdit', 'FieldsListEdit', false,'Edit');" value="Add"/></div><div class="Right">&nbsp;</div></div>
                        <div class="Button">
                            <div class="Left">&nbsp;</div>
                            <!--<div class="Middle"><input type="button" id="addAllEdit" class="button" value="Add All" onclick="javascript: moveSelected('FieldsListTmpEdit', 'FieldsListEdit', true,'Edit');"/></div>-->
                            <div class="Right">&nbsp;</div>
                        </div>
                    </td>

                    <td>
                    <select name="FieldsListEdit" multiple="multiple" size="25" style="width: 550px;" class="InputField" id="FieldsListEdit">
                        @{
                            foreach (var field in EditedSubset.SpecTestNames)
                            {
                                <option value="@field.ToString()"> @field.ToString()</option>
                            }
                        }
                    </select>
                    @{
                        string EditedSubsetSpecTestNamesStr = "";
                        int fieldCnt = 0;
                        foreach (var field in EditedSubset.SpecTestNames) 
                        {
                            fieldCnt++;
                            EditedSubsetSpecTestNamesStr += field;
                            if (fieldCnt<EditedSubset.SpecTestNames.Count) 
                            {
                                EditedSubsetSpecTestNamesStr += ",";
                            }
                        }
                    }
                    <input type="hidden" name="FieldsEdit" value="@EditedSubsetSpecTestNamesStr"/>
                    <input type="hidden" name="load" value="yes"/>
                    </td>

                    <td nowrap>
                        <div class="Button"><div class="Left">&nbsp;</div><div class="Middle"><input type="button" id="remEdit" class="button" onclick="javascript: moveSelected('FieldsListEdit', null, false,'Edit');" value="Remove"/></div><div class="Right">&nbsp;</div></div>
                        <div class="Button"><div class="Left">&nbsp;</div><div class="Middle"><input type="button" id="remAllEdit" class="button" onclick="javascript: moveSelected('FieldsListEdit', null, true,'Edit');" value="Remove All"/></div><div class="Right">&nbsp;</div></div>
                    </td>
                </tr>
            </tbody>
        </table>
      <br />
      <input type="submit" class="button"/>
    </fieldset>
  </form>
</div>
