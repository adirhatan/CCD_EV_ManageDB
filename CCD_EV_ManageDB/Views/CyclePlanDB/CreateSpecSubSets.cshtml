 <script type="text/JavaScript">     function getForm(sourceDoc, formId) { return sourceDoc.getElementById(formId); }
     function getFormElement(sourceForm, elementName) { return sourceForm[elementName]; for (var i = 0; i < sourceForm.elements.length; i++) { var theElement = sourceForm.elements[i]; if (theElement.name == elementName) { return theElement; } } }
     function moveSelected(sourceElementId, targetElementId, moveAll,source) {
         var sourceElement = document.getElementById(sourceElementId); var targetElement = null; if (targetElementId != null) { targetElement = document.getElementById(targetElementId); }
         if (sourceElement == null || sourceElement.tagName != "SELECT" || (targetElement != null && targetElement.tagName != "SELECT")) { return; }
         var unselectedOptions = new Array(); for (var i = 0; i < sourceElement.length; i++) {
             var option = sourceElement.options[i]; if (option.selected || (moveAll && !option.hide)) {
                 if (targetElement != null) {
                     var alreadyExists = false; for (var j = 0; j < targetElement.length; j++) { if (targetElement.options[j].value == option.value) { alreadyExists = true; break; } }
                     if (!alreadyExists) { targetElement.options[targetElement.length] = new Option(option.text, option.value); }
                 } else { sourceElement.options[i] = null; i--; }
             }
             option.selected = false;
         }
         if (source == "Create") { updateHiddenFormCreate() };
         if (source == "Edit") { updateHiddenFormEdit() };
     }
     function updateHiddenFormCreate() { debugger; sourceElement = document.getElementById('FieldsList'); var theForm = sourceElement.form; var useridEl = theForm.elements['Fields']; useridEl.value = ""; for (var i = 0; i < sourceElement.length; i++) { var option = sourceElement.options[i]; useridEl.value += option.value; if (i + 1 < sourceElement.length) { useridEl.value += ','; } } }
     function updateHiddenFormEdit() { debugger; sourceElement = document.getElementById('FieldsListEdit'); var theForm = sourceElement.form; var useridEl = theForm.elements['FieldsEdit']; useridEl.value = ""; for (var i = 0; i < sourceElement.length; i++) { var option = sourceElement.options[i]; useridEl.value += option.value; if (i + 1 < sourceElement.length) { useridEl.value += ','; } } }
     function clearSelect(formId, elementId) { var formElement = document.getElementById(formId).elements[elementId]; formElement.selectedIndex = -1; }
</script>

 <script type="text/JavaScript">
     $(document).ready(function () {
         //debugger;
         $('#SpecSupSets').dataTable({
             "iDisplayLength": -1,
             "columns": [
            { "orderable": true },
            { "orderable": true },
            { "orderable": true },
            { "orderable": false },
            { "orderable": false },
            { "orderable": false }
          ],
             "autoWidth": true,
             "jQueryUI": true,
             //        //"sDom": '<"H"CTrf>t<"F"lip>',
             "dom": '<"F"CTrif>t<"F"CTrif>',
             "scrollX": "100%",
             //"sScrollY": "700px",
             "scrollY": (0.8 * $(window).height()),
             "scrollCollapse": true
         });

         $('#filterSpecs').keyup(function () {
             var valthis = $(this).val().toLowerCase();

             $('select#FieldsListTmp>option').each(function () {
                 var text = $(this).text().toLowerCase();
                 if (text.indexOf(valthis) !== -1) {
                     $(this).show(); $(this).prop('selected', true);
                 }
                 else {
                     $(this).hide();
                     $(this).prop('selected', false);
                 }
             });
         });

         $('#editfilterSpecs').keyup(function () {
             var valthis = $(this).val().toLowerCase();

             $('select#FieldsListTmpEdit>option').each(function () {
                 var text = $(this).text().toLowerCase();
                 if (text.indexOf(valthis) !== -1) {
                     $(this).show(); $(this).prop('selected', true);
                 }
                 else {
                     $(this).hide();
                     $(this).prop('selected', false);
                 }
             });
         });
         
     });

</script>
