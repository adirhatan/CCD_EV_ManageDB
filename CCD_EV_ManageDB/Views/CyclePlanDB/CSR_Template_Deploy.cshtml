@using MongoDB.Bson;
@using MongoDB.Driver;
@using MongoDB.Bson.Serialization;
@using System.Collections.Generic;
@using System.Web.UI.WebControls;
@using System.Text.RegularExpressions;
@using CCD_EV_ManageDB.Models;
@using CCD_EV_ManageDB.Repositories;

@{
    ViewBag.Title = "CSR Template Deploy";
}


<h2>CSR Template Deploy</h2>
<script src="@Url.Content("~/Scripts/ccdEV.js")" type="text/javascript" ></script>     

     @{ var ExportedFile = ViewBag.ExportedFileName;
        if (ExportedFile != null)
        {
             <script type="text/JavaScript">
                 $(document).ready(function () {
                     var url = '@Url.Action("ViewExportFile", "ManageDB", new { filename = ViewBag.ExportedFileName })';
                     $(location).attr('href', url);
                 });
             </script>
        }
     }

<p class="messageText">@TempData["message"]</p>
<p class="messageInfoText">@TempData["messageInfo"]</p> 

      @using (Html.BeginForm("CSR_Template_Deploy", "CyclePlanDB", FormMethod.Post, new { @id = "allForm", @name = "allForm" }))
      {
     <p>
        Select Project: 
        <select id="all_proj" name="proj" onchange="GenSubmitFormAction('allForm','@Url.Action("CSR_Template_Deploy", "CyclePlanDB")')">
            @foreach (var proj in ViewBag.projlist)
            {
                if (proj.ToString() == ViewBag.proj)
                {
                    <option value="@proj.ToString()" selected="selected"> @proj.ToString()</option>
                }
                else
                {
                    <option value="@proj.ToString()"> @proj.ToString()</option>
                }
            }
        </select> 
        Select Phase: 
        <select id="all_phase" name="phase" onchange="GenSubmitFormAction('allForm','@Url.Action("CSR_Template_Deploy", "CyclePlanDB")')">
            @foreach (var phase in ViewBag.phaselist)
            {
                if (phase.ToString() == ViewBag.phase)
                {
                    <option value="@phase.ToString()" selected="selected"> @phase.ToString()</option>
                }
                else
                {
                    <option value="@phase.ToString()" > @phase.ToString()</option>
                }
            }
        </select> 
        Select Interface: 
        <select id="all_protocol" name="protocol" class="wselect" onchange="GenSubmitFormAction('allForm','@Url.Action("CSR_Template_Deploy", "CyclePlanDB")')">
            @foreach (var protocol in ViewBag.protocollist)
            {
                if (protocol.ToString() == ViewBag.protocol)
                {
                    <option value="@protocol.ToString()" selected="selected"> @protocol.ToString()</option>
                }
                else
                {
                    <option value="@protocol.ToString()" > @protocol.ToString()</option>
                }
            }
        </select> 
        &nbsp; <input type="button" value="Cycle Plan Main" title="back to Cycle Plan Main" class="button" onclick="GenLocatioAction('@Url.Action("Main", "CyclePlanDB", new { @protocol = ViewBag.protocol, @phase = ViewBag.phase, @proj = ViewBag.proj })')" />
    </p>
      }
    <br />
    <p>
    @foreach (string currTemplate in ViewBag.currTemplates)
    {
        string _table = "";
        foreach (string t in ViewBag.tables)
        {
            if (currTemplate.Contains(t))
            {
                _table = t;
                break;
            }
        }
        string interfaceORcurrTable = ViewBag.Interface;
        if (!String.IsNullOrEmpty(_table))
        {
            interfaceORcurrTable = _table;
        }
        using (Html.BeginForm("CSR_TemplateUploadFile", "CyclePlanDB", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            <input type="hidden" id="exl_proj" name="proj" value="@ViewBag.proj" />
            <input type="hidden" id="exl_phase" name="phase" value="@ViewBag.phase" />
            <input type="hidden" id="exl_prototcol" name="protocol" value="@ViewBag.protocol" />  
            <input type="hidden" id="exl_table" name="table" value="@_table" />  
            <span>If you want to upload new CSR Excel template of "@interfaceORcurrTable": &nbsp;</span><input type="file" name="file" class="button" />    
            <text>&nbsp;</text><input type="submit" name="Upload" value="Upload"  class="button" />   
            <br />
            <text>The following Excel templates where found:</text>
            <br />
            <!--"Validate is depricated since file is generated automatically with conf -->
            <br />
            <b style="background-color:Lime">Active - </b>@currTemplate
            <input type="button" name="Download" value="Download"  class="button" onclick="GenLocatioAction('@Url.Action("CSR_TemplateDownloadFile", "CyclePlanDB", new { @protocol = ViewBag.protocol, @phase = ViewBag.phase, @proj = ViewBag.proj, @filename = currTemplate })')" />
        }


        foreach (string file in ViewBag.TemplateFiles)
        {
            if ((Path.GetFileNameWithoutExtension(file) == Path.GetFileNameWithoutExtension(currTemplate))) { continue; }
            //wrong logic, not sure why it was (ViewBag.TemplateFiles contains files with correct prefic only)
            //if ((Path.GetFileNameWithoutExtension(file).StartsWith(Path.GetFileNameWithoutExtension(currTemplate))) || (Path.GetFileNameWithoutExtension(currTemplate).StartsWith(Path.GetFileNameWithoutExtension(file))))
            //logic is needed for Separate Tables flow, try to fix:
            if (Path.GetFileNameWithoutExtension(file).StartsWith(Path.GetFileNameWithoutExtension(ViewBag.TemplateFileNoTable + _table)))
            {
                @file 
                <text>&nbsp;</text>
                 <input type="button" name="Download" value="Download"  class="button"  onclick="GenLocatioAction('@Url.Action("CSR_TemplateDownloadFile", "CyclePlanDB", new { @protocol = ViewBag.protocol, @phase = ViewBag.phase, @proj = ViewBag.proj, @filename = file })')" />
                 <text>&nbsp</text><input type="button" name="MakeActive" value="Make Active" class="button"  onclick="GenLocatioAction('@Url.Action("CSR_TemplateMakeFileActive", "CyclePlanDB", new { @protocol = ViewBag.protocol, @phase = ViewBag.phase, @proj = ViewBag.proj, @filename = file, @table = _table })')" />
                 <text>&nbsp</text><input type="button" name="Delete" value="Delete" class="button"  onclick="GenLocatioConfirmAction('@Url.Action("CSR_TemplateDeleteFile", "CyclePlanDB", new { @protocol = ViewBag.protocol, @phase = ViewBag.phase, @proj = ViewBag.proj, @filename = file })','Are you sure you want to delete @file?')" />
                <br />
            }
        }
    }
    </p>   
 


      