  @using (Html.BeginForm("CompReportsEdit", "CompReportDB", FormMethod.Post, new { @id = "InterfaceForm", @name = "InterfaceForm" }))
  {
      bool allChecked = (ViewBag.tab == ".*");
      bool tbtTXChecked = (ViewBag.tab == "TBT_TX");
      bool tbtRXChecked = (ViewBag.tab == "TBT_RX");
      bool tbtRLChecked = (ViewBag.tab == "TBT-RL-");
      bool dpChecked = (ViewBag.tab == "DP-");
      bool dppChecked = (ViewBag.tab == "DPpp-");
      bool usb31tChecked = (ViewBag.tab == "USB31-TX-");
      bool usb31rChecked = (ViewBag.tab == "USB31-RX");
      bool usb20tChecked = (ViewBag.tab == "USB20-TX-");
      bool hdmiChecked = (ViewBag.tab == "HDMI");
 <p> Choose Interface for editing: 
    @Html.RadioButton("tab", ".*", allChecked, new { @onclick = "document.getElementById('InterfaceForm').submit()" }) All &nbsp;
    @Html.RadioButton("tab", "TBT_TX", tbtTXChecked, new { @onclick = "document.getElementById('InterfaceForm').submit()" }) TBT_TX &nbsp;
    @Html.RadioButton("tab", "TBT-RX-", tbtRXChecked, new { @onclick = "document.getElementById('InterfaceForm').submit()" }) TBT_RX &nbsp;
    @Html.RadioButton("tab", "TBT-RL-", tbtRLChecked, new { @onclick = "document.getElementById('InterfaceForm').submit()" }) TBT_RL &nbsp;
    @Html.RadioButton("tab", "DP-", dpChecked, new { @onclick = "document.getElementById('InterfaceForm').submit()" }) DP &nbsp;
    @Html.RadioButton("tab", "DPpp-", dppChecked, new { @onclick = "document.getElementById('InterfaceForm').submit()" }) DPpp &nbsp;
    @Html.RadioButton("tab", "USB31-TX-", usb31tChecked, new { @onclick = "document.getElementById('InterfaceForm').submit()" }) USB31_TX &nbsp;
    @Html.RadioButton("tab", "USB31-RX-", usb31rChecked, new { @onclick = "document.getElementById('InterfaceForm').submit()" }) USB31_RX &nbsp;
    @Html.RadioButton("tab", "USB20-TX-", usb20tChecked, new { @onclick = "document.getElementById('InterfaceForm').submit()" }) USB20_TX &nbsp;
    @Html.RadioButton("tab", "HDMI", hdmiChecked, new { @onclick = "document.getElementById('InterfaceForm').submit()" }) HDMI &nbsp;
    </p>
  }

