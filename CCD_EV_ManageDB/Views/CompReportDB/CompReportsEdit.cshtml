     function changedBoardNumber(selectBoardBumber, selectBioses, selectNvms) {
         //debugger;
         //var selectFields = elem.nextSibling.nextSibling;

         var output = [];
         var length = ngon.dictionaryBioses[selectBoardBumber.value].length;
         output[0] = '<option value=""></option>';
         for (var i = 0; i < length; i++) {
             output[i + 1] = '<option value="' + ngon.dictionaryBioses[selectBoardBumber.value][i] + '">' + ngon.dictionaryBioses[selectBoardBumber.value][i] + '</option>';
         }

         var output1 = [];
         var length1 = ngon.dictionaryNvms[selectBoardBumber.value].length;
         output1[0] = '<option value=""></option>';
         for (var i = 0; i < length1; i++) {
             output1[i + 1] = '<option value="' + ngon.dictionaryNvms[selectBoardBumber.value][i] + '">' + ngon.dictionaryNvms[selectBoardBumber.value][i] + '</option>';
         }


         selectBioses.innerHTML = output.join('');
         selectNvms.innerHTML = output1.join('');

     }
     function changedTable(selectTables, selectFields1, selectFields2, selectFields3) {
         //debugger;
         //var selectFields = elem.nextSibling.nextSibling;

         var output = [];
         var length = ngon.dictionaryFields[selectTables.value].length;
         output[0] = '<option value=""></option>';
         for (var i = 0; i < length; i++) {
             output[i+1] = '<option value="' + ngon.dictionaryFields[selectTables.value][i] + '">' + ngon.dictionaryFields[selectTables.value][i] + '</option>';
         }

         selectFields1.innerHTML = output.join('');
         selectFields2.innerHTML = output.join('');
         selectFields3.innerHTML = output.join('');

     }
</script>

<p class="messageText">@TempData["message"]</p>
<p class="messageInfoText">@TempData["messageInfo"]</p> 

  @using (Html.BeginForm("RunReportBG", "CompReportDB", FormMethod.Post, new { @id = "RunCopmReportDBForm", @name = "RunCopmReportDBForm" }))
  {
    <p>Run report. 
            <select id="boardNumber" name="boardNumber" class="wselect" onchange="changedBoardNumber(this,document.getElementById('BIOS'),document.getElementById('NVM'))">
            <option value=""></option>
            @foreach (var col in ViewBag.boardNumbers)
            {
                <option value="@col.ToString()"> @col.ToString()</option>
            }
        </select>
        <!--new: BIOSES -->
         BIOS (optional):
        <select id="BIOS" name="BIOS" >
               <option value=""></option>
       </select> 
        NVM (optional):
       <select id="NVM" name="NVM" >
               <option value=""></option>
       </select> 
    Select template:
        <select id="templ" name="templ" class="wselect">
            @foreach (var col in ViewBag.tmplates)
            {
                <option value="@col.ToString()"> @col.ToString()</option>
            }
        </select>
        <input type="submit" value="Submit" />
        <input type="button" value="Validate" title="Validate report completeness" class="button" onclick="GenSubmitFormAction('RunCopmReportDBForm','@Url.Action("ValidateCompReport", "CompReportDB")')" />
    </p>
  }
  <br />

 @using (Html.BeginForm("CreateLine", "CompReportDB", FormMethod.Post, new { @id = "NewLineForm", @name = "NewLineForm" }))
 {
 <p>Create new line. name:
    <input type="text" id="lName" name="lName" style="width: 200px" />
    Query:
    <input type="text" id="lQuery" name="lQuery" style="width: 350px" />
    Table:
    <select id="tableName" name="tableName" onchange="changedTable(this,document.getElementById('Field1'),document.getElementById('Field2'),document.getElementById('Field3'))">
        @foreach (var col in ViewBag.collist)
        {
            <option value="@col.ToString()"> @col.ToString()</option>
        }
    </select> 
    Field1:
    <select id="Field1" name="Field1" class="wselect">
        <option value=""></option>
        @{
        foreach (string field in ViewBag.defFieldsList)
        {
            <option value="@field"> @field</option>
        }
        }
    </select>
    Format1:
    <select id="disp1" name="disp1" >
        @foreach (var disp in ViewBag.disp)
        {
            <option value="@disp.ToString()"> @disp.ToString()</option>
        }
    </select>
    Field2:
    <select id="Field2" name="Field2" class="wselect">
        <option value=""></option>
        @{
        foreach (string field in ViewBag.defFieldsList)
        {
            <option value="@field"> @field</option>
        }
        }
    </select> 
    Format2:
    <select id="disp2" name="disp2" >
        @foreach (var disp in ViewBag.disp)
        {
            <option value="@disp.ToString()"> @disp.ToString()</option>
        }
    </select>
    Field3:
    <select id="Field3" name="Field3" class="wselect">
        <option value=""></option>
        @{
        foreach (string field in ViewBag.defFieldsList)
        {
            <option value="@field"> @field</option>
        }
        }
    </select> 
    Format3:
    <select id="disp3" name="disp3" >
        @foreach (var disp in ViewBag.disp)
        {
            <option value="@disp.ToString()"> @disp.ToString()</option>
        }
    </select> 
    Results:
    <select id="results" name="results" >
        @foreach (var results in ViewBag.results)
        {
            <option value="@results.ToString()"> @results.ToString()</option>
        }
    </select> 
    <input type="submit" value="Submit" />
</p>
 }
