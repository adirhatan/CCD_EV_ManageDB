<h2>CompReports</h2>

 <script src="@Url.Content("~/Scripts/ccdEV.js")" type="text/javascript" ></script>
 <script type="text/JavaScript">
     function changedBoardNumber(selectBoardBumber, selectBioses, selectNvms, selectUnitIDS) {
         //debugger;
         //var selectFields = elem.nextSibling.nextSibling;

         var output = [];
         var length = ngon.dictionaryBioses[selectBoardBumber.value].length;
         output[0] = '<option value=""></option>';
         for (var i = 0; i < length; i++) {
             output[i + 1] = '<option value="' + ngon.dictionaryBioses[selectBoardBumber.value][i] + '">' + ngon.dictionaryBioses[selectBoardBumber.value][i] + '</option>';
         }

         var output1 = [];
         var length1 = ngon.dictionaryNvms[selectBoardBumber.value].length;
         output1[0] = '<option value=""></option>';
         for (var i = 0; i < length1; i++) {
             output1[i + 1] = '<option value="' + ngon.dictionaryNvms[selectBoardBumber.value][i] + '">' + ngon.dictionaryNvms[selectBoardBumber.value][i] + '</option>';
         }

         var output2 = [];
         var length2 = ngon.dictionaryUnitIDS[selectBoardBumber.value].length;
         output2[0] = '<option value=""></option>';
         for (var i = 0; i < length2; i++) {
             output2[i + 1] = '<option value="' + ngon.dictionaryUnitIDS[selectBoardBumber.value][i] + '">' + ngon.dictionaryUnitIDS[selectBoardBumber.value][i] + '</option>';
         }


         selectBioses.innerHTML = output.join('');
         selectNvms.innerHTML = output1.join('');
         selectUnitIDS.innerHTML = output2.join('');

         //new - 1P/2P and Host/Device templates
         var templatesSelect = document.getElementById('templ');
         if ((ngon.ports[selectBoardBumber.value] == "2P") && (ngon.devTypes[selectBoardBumber.value] == "Host")) {
             templatesSelect.value = ngon.tmplH2;
         }
         if ((ngon.ports[selectBoardBumber.value] == "1P") && (ngon.devTypes[selectBoardBumber.value] == "Host")) {
             templatesSelect.value = ngon.tmplH1;
         }
         if ((ngon.ports[selectBoardBumber.value] == "2P") && (ngon.devTypes[selectBoardBumber.value] == "Device")) {
             templatesSelect.value = ngon.tmplD2;
         }
         if ((ngon.ports[selectBoardBumber.value] == "1P") && (ngon.devTypes[selectBoardBumber.value] == "Device")) {
             templatesSelect.value = ngon.tmplD1;
         }

     }

     function changedTable(selectTables, selectFields1, selectFields2, selectFields3) {
         //debugger;
         //var selectFields = elem.nextSibling.nextSibling;

         var output = [];
         var length = ngon.dictionaryFields[selectTables.value].length;
         output[0] = '<option value=""></option>';
         for (var i = 0; i < length; i++) {
             output[i+1] = '<option value="' + ngon.dictionaryFields[selectTables.value][i] + '">' + ngon.dictionaryFields[selectTables.value][i] + '</option>';
         }

         selectFields1.innerHTML = output.join('');
         selectFields2.innerHTML = output.join('');
         selectFields3.innerHTML = output.join('');

     }

</script>

